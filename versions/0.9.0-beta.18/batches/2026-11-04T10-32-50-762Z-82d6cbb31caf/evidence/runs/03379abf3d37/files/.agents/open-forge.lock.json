{
  "$schema": "https://raw.githubusercontent.com/TheLithiumForge/open-forge/main/schemas/v1/open-forge.lock.schema.json",
  "schemaVersion": 1,
  "framework": {
    "source": {
      "id": "embedded-framework"
    },
    "paths": [
      ".agents/README.md",
      ".agents/directives/_directives.md",
      ".agents/guidance/_guidance.md",
      ".agents/loader.md",
      ".agents/maps/_maps.md",
      ".agents/memory/_memory.md",
      ".agents/memory/archived/_archived.md",
      ".agents/memory/crystallized/_crystallized.md",
      ".agents/memory/emerging/_emerging.md",
      ".agents/memory/working/_working.md",
      ".agents/patterns/_patterns.md",
      ".agents/skills/_skills.md",
      ".agents/skills/open-forge-cli/SKILL.md",
      ".agents/skills/open-forge-cli/references/common.md",
      ".agents/skills/open-forge-cli/references/discovery.md",
      ".agents/skills/open-forge-cli/references/packages.md",
      ".agents/skills/open-forge-cli/references/routes.md",
      ".agents/templates/_templates.md"
    ],
    "regions": [
      {
        "path": ".agents/directives/_directives.md",
        "region": "entries"
      },
      {
        "path": ".agents/guidance/_guidance.md",
        "region": "entries"
      },
      {
        "path": ".agents/loader.md",
        "region": "entries"
      },
      {
        "path": ".agents/maps/_maps.md",
        "region": "entries"
      },
      {
        "path": ".agents/memory/_memory.md",
        "region": "entries"
      },
      {
        "path": ".agents/memory/archived/_archived.md",
        "region": "entries"
      },
      {
        "path": ".agents/memory/crystallized/_crystallized.md",
        "region": "entries"
      },
      {
        "path": ".agents/memory/emerging/_emerging.md",
        "region": "entries"
      },
      {
        "path": ".agents/memory/working/_working.md",
        "region": "entries"
      },
      {
        "path": ".agents/patterns/_patterns.md",
        "region": "entries"
      },
      {
        "path": ".agents/skills/_skills.md",
        "region": "entries"
      },
      {
        "path": ".agents/templates/_templates.md",
        "region": "entries"
      },
      {
        "path": "AGENTS.md",
        "region": "open-forge"
      },
      {
        "path": "CLAUDE.md",
        "region": "open-forge"
      }
    ]
  },
  "extensions": [
    {
      "id": "observations-and-handoffs",
      "version": "0.4.0",
      "source": "embedded catalogue",
      "dependencies": [],
      "paths": [
        ".agents/memory/emerging/observations/_observations.md",
        ".agents/memory/working/handoffs/_handoffs.md",
        ".agents/templates/observations-and-handoffs/_observations-and-handoffs.md",
        ".agents/templates/observations-and-handoffs/handoff.md",
        ".agents/templates/observations-and-handoffs/observation.md"
      ],
      "regions": []
    },
    {
      "id": "planning",
      "version": "0.4.0",
      "source": "embedded catalogue",
      "dependencies": [
        "workflows"
      ],
      "paths": [
        ".agents/directives/planning/_planning.md",
        ".agents/directives/planning/work-records.md",
        ".agents/memory/crystallized/decisions/_decisions.md",
        ".agents/memory/emerging/analysis/_analysis.md",
        ".agents/memory/emerging/ideas/_ideas.md",
        ".agents/memory/working/checkpoints/_checkpoints.md",
        ".agents/patterns/work-records.md",
        ".agents/skills/use-workflow/references/planning/_planning.md",
        ".agents/skills/use-workflow/references/planning/planning.md",
        ".agents/templates/planning/_planning.md",
        ".agents/templates/planning/analysis.md",
        ".agents/templates/planning/backlog.md",
        ".agents/templates/planning/checkpoint.md",
        ".agents/templates/planning/decision.md",
        ".agents/templates/planning/idea.md",
        ".agents/templates/planning/plan.md",
        ".agents/templates/planning/task.md"
      ],
      "regions": []
    },
    {
      "id": "workflows",
      "version": "0.4.0",
      "source": "embedded catalogue",
      "dependencies": [],
      "paths": [
        ".agents/skills/use-workflow/SKILL.md",
        ".agents/skills/use-workflow/references/_references.md",
        ".agents/templates/workflows/_workflows.md",
        ".agents/templates/workflows/workflow.md"
      ],
      "regions": []
    }
  ],
  "libraries": []
}
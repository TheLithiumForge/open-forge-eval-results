@@ -0,0 +1,19 @@
+const NAME_MIN = 2;
+const NAME_MAX = 20;
+export const NameProblem = {
+  length: 'Use 2 to 20 characters.',
+  repeat: 'Each name must be different.',
+} as const;
+
+// A typed name is kept and shown trimmed, with each inner whitespace run as one space, in NFC.
+export function acceptedName(draft: string): string {
+  return draft.trim().replace(/\s+/g, ' ').normalize('NFC');
+}
+
+// Counts Unicode code points of accepted names, then compares them without case in the group.
+export function nameProblem(names: readonly string[]): string | null {
+  const lengths = names.map((name) => [...name].length);
+  if (lengths.some((length) => length < NAME_MIN || length > NAME_MAX)) return NameProblem.length;
+  const keys = new Set(names.map((name) => name.toUpperCase().toLowerCase().normalize('NFC')));
+  return keys.size === names.length ? null : NameProblem.repeat;
+}
diff --git a/src/game/tournament/past-tournaments.test.ts b/src/game/tournament/past-tournaments.test.ts
new file mode 100644
index 0000000..6d725eb
--- /dev/null
+++ b/src/game/tournament/past-tournaments.test.ts
@@ -0,0 +1,100 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { addRecord, PAST_LIMIT, readPast, TOURNAMENTS_KEY } from './past-tournaments.ts';
+import { recordAttempt } from './rules.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './rules.ts';
+
+function finished(champion: string): Tournament {
+  const start: Tournament = {
+    players: [champion, 'Bo', 'Cora', 'Dev'],
+    matches: ['np1-6-1', 'np1-6-2', 'np1-8-1'].map((boardCode) => ({ boardCode, attempts: [] })),
+  };
+  return [18, 19, 18, 19, 32, 33].reduce(
+    (tournament, moves) => recordAttempt(tournament, { moves, elapsedMs: 1500.5 }),
+    start,
+  );
+}
+
+function memoryStore(initial: Record<string, string> = {}) {
+  const values = new Map(Object.entries(initial));
+  const writes: string[] = [];
+  const store: PreferenceStore = {
+    getItem: (key) => values.get(key) ?? null,
+    setItem: (key, value) => {
+      writes.push(key);
+      values.set(key, value);
+    },
+  };
+  return { store, values, writes };
+}
+
+const denied: PreferenceStore = {
+  getItem: () => {
+    throw new Error('SecurityError');
+  },
+  setItem: () => {
+    throw new Error('QuotaExceededError');
+  },
+};
+
+test('saved tournaments use the namespaced key and a two-key envelope, newest first', () => {
+  const { store, values } = memoryStore({ 'other-app': 'kept' });
+  assert.deepEqual(readPast(store), { records: [], saving: true });
+  const first = addRecord(store, [], finished('Ada'));
+  const second = addRecord(store, first.records, finished('Abe'));
+  assert.deepEqual(
+    second.records.map((record) => record.players[0]),
+    ['Abe', 'Ada'],
+  );
+  const saved: unknown = JSON.parse(values.get(TOURNAMENTS_KEY) ?? '');
+  assert.ok(saved && typeof saved === 'object');
+  assert.deepEqual(Object.keys(saved), ['v', 'items']);
+  assert.equal(TOURNAMENTS_KEY, 'np3:tournaments');
+  assert.deepEqual(readPast(store), second);
+  assert.equal(values.get('other-app'), 'kept');
+});
+
+test('a save keeps the newest ten records and drops older ones', () => {
+  const { store } = memoryStore();
+  let records: readonly Tournament[] = [];
+  const names = Array.from({ length: PAST_LIMIT + 2 }, (_, index) => `Player ${index}`);
+  for (const name of names) records = addRecord(store, records, finished(name)).records;
+  const kept = readPast(store).records.map((record) => record.players[0]);
+  assert.equal(PAST_LIMIT, 10);
+  assert.deepEqual(kept, names.slice(2).reverse());
+});
+
+test('an unusable stored value reads as empty without being rewritten', () => {
+  const record = finished('Ada');
+  const partial = {
+    ...record,
+    matches: record.matches.map((match, index) =>
+      index === 2 ? { ...match, attempts: [] } : match,
+    ),
+  };
+  for (const text of [
+    '{',
+    'null',
+    '[]',
+    '{"v":3}',
+    '{"v":2,"items":[]}',
+    '{"v":3,"items":[],"extra":1}',
+    JSON.stringify({ v: 3, items: [partial] }),
+    JSON.stringify({ v: 3, items: [{ ...record, version: 1 }] }),
+  ]) {
+    const { store, values, writes } = memoryStore({ [TOURNAMENTS_KEY]: text });
+    assert.deepEqual(readPast(store), { records: [], saving: true }, text);
+    assert.equal(values.get(TOURNAMENTS_KEY), text);
+    assert.deepEqual(writes, []);
+  }
+});
+
+test('blocked storage keeps finished tournaments in memory and reports that it cannot save', () => {
+  assert.deepEqual(readPast(null), { records: [], saving: false });
+  assert.deepEqual(readPast(denied), { records: [], saving: false });
+  const kept = addRecord(denied, [], finished('Ada'));
+  assert.equal(kept.saving, false);
+  assert.equal(kept.records.length, 1);
+  assert.equal(addRecord(null, kept.records, finished('Abe')).records.length, 2);
+});
diff --git a/src/game/tournament/past-tournaments.ts b/src/game/tournament/past-tournaments.ts
new file mode 100644
index 0000000..641905d
--- /dev/null
+++ b/src/game/tournament/past-tournaments.ts
@@ -0,0 +1,60 @@
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import { readTournament, tournamentRecord } from './format.ts';
+import { champion } from './rules.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './rules.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+const ENVELOPE_VERSION = 3;
+const ENVELOPE_KEYS = ['v', 'items'];
+export const PAST_LIMIT = 10;
+
+// Finished tournaments, newest first. Saving is false when the browser store is blocked, so
+// records only last for this visit.
+export interface SavedTournaments {
+  readonly records: readonly Tournament[];
+  readonly saving: boolean;
+}
+
+// A stored value that fails to parse or validate reads as no records, without an error, and
+// stays untouched until the next save replaces it.
+export function readPast(store: PreferenceStore | null): SavedTournaments {
+  if (!store) return { records: [], saving: false };
+  let text: string | null;
+  try {
+    text = store.getItem(TOURNAMENTS_KEY);
+  } catch {
+    return { records: [], saving: false };
+  }
+  return { records: text ? decodePast(text) : [], saving: true };
+}
+
+function decodePast(text: string): readonly Tournament[] {
+  const value = parseJson(text);
+  if (!isJsonObject(value) || !hasExactKeys(value, ENVELOPE_KEYS)) return [];
+  if (value.v !== ENVELOPE_VERSION || !Array.isArray(value.items)) return [];
+  const records: Tournament[] = [];
+  for (const item of value.items) {
+    const record = readTournament(item);
+    if (!record || champion(record) === null) return [];
+    records.push(record);
+  }
+  return records.slice(0, PAST_LIMIT);
+}
+
+// Saving a record keeps the newest ten and drops older ones. Only this feature's key is written.
+export function addRecord(
+  store: PreferenceStore | null,
+  records: readonly Tournament[],
+  record: Tournament,
+): SavedTournaments {
+  const next = [record, ...records].slice(0, PAST_LIMIT);
+  try {
+    if (!store) return { records: next, saving: false };
+    const items = next.map(tournamentRecord);
+    store.setItem(TOURNAMENTS_KEY, JSON.stringify({ v: ENVELOPE_VERSION, items }));
+    return { records: next, saving: true };
+  } catch {
+    return { records: next, saving: false };
+  }
+}
diff --git a/src/game/tournament/rules.test.ts b/src/game/tournament/rules.test.ts
new file mode 100644
index 0000000..a7f5c7d
--- /dev/null
+++ b/src/game/tournament/rules.test.ts
@@ -0,0 +1,155 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  attemptCount,
+  boardSizes,
+  champion,
+  currentTurn,
+  isValidTournament,
+  matchLabel,
+  matchRound,
+  matchSeeds,
+  matchWinner,
+  playerName,
+  recordAttempt,
+  RoundName,
+} from './rules.ts';
+import type { Attempt, Tournament } from './rules.ts';
+
+const EIGHT = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'Hal'];
+const FOUR = ['Ada', 'Bo', 'Cora', 'Dev'];
+const FOUR_CODES = ['np1-6-1', 'np1-6-2', 'np1-8-1'];
+const EIGHT_CODES = ['np1-4-1', 'np1-4-2', 'np1-4-3', 'np1-4-4', 'np1-6-1', 'np1-6-2', 'np1-8-1'];
+
+function fresh(players: readonly string[], codes: readonly string[]): Tournament {
+  return { players, matches: codes.map((boardCode) => ({ boardCode, attempts: [] })) };
+}
+
+function play(tournament: Tournament, attempts: readonly Attempt[]): Tournament {
+  return attempts.reduce(recordAttempt, tournament);
+}
+
+function opening(tournament: Tournament, matches: number): string[][] {
+  return Array.from({ length: matches }, (_, index) =>
+    matchSeeds(tournament, index).map((seed) =>
+      seed === null ? '' : playerName(tournament, seed),
+    ),
+  );
+}
+
+test('entry order seeds the opening matches of both bracket sizes', () => {
+  assert.deepEqual(opening(fresh(EIGHT, EIGHT_CODES), 4), [
+    ['Ada', 'Hal'],
+    ['Dev', 'Emi'],
+    ['Cora', 'Finn'],
+    ['Bo', 'Gia'],
+  ]);
+  assert.deepEqual(opening(fresh(FOUR, FOUR_CODES), 2), [
+    ['Ada', 'Dev'],
+    ['Bo', 'Cora'],
+  ]);
+  assert.deepEqual(matchSeeds(fresh(FOUR, FOUR_CODES), 2), [null, null]);
+});
+
+test('rounds run quarterfinal, semifinal and final on growing boards', () => {
+  assert.deepEqual(
+    EIGHT_CODES.map((_, index) => matchRound(8, index)),
+    [
+      'Quarterfinal',
+      'Quarterfinal',
+      'Quarterfinal',
+      'Quarterfinal',
+      'Semifinal',
+      'Semifinal',
+      'Final',
+    ],
+  );
+  assert.deepEqual(
+    FOUR_CODES.map((_, index) => matchRound(4, index)),
+    [RoundName.semifinal, RoundName.semifinal, RoundName.final],
+  );
+  assert.deepEqual(boardSizes(8), [4, 4, 4, 4, 6, 6, 8]);
+  assert.deepEqual(boardSizes(4), [6, 6, 8]);
+  assert.deepEqual(boardSizes(6), []);
+  assert.equal(matchLabel(8, 2), 'Quarterfinal 3');
+  assert.equal(matchLabel(8, 5), 'Semifinal 2');
+  assert.equal(matchLabel(4, 2), 'Final');
+});
+
+test('fewer moves win, then less active time, then the higher seed', () => {
+  const start = fresh(FOUR, FOUR_CODES);
+  const moves = play(start, [
+    { moves: 18, elapsedMs: 70_200 },
+    { moves: 19, elapsedMs: 58_100 },
+  ]);
+  assert.equal(matchWinner(moves, 0), 1);
+  const time = play(moves, [
+    { moves: 20, elapsedMs: 65_900 },
+    { moves: 20, elapsedMs: 65_200 },
+  ]);
+  assert.equal(matchWinner(time, 1), 3);
+  assert.equal(matchWinner(play(start, [{ moves: 18, elapsedMs: 1 }]), 0), null);
+  const equal = play(start, [
+    { moves: 18, elapsedMs: 1000.25 },
+    { moves: 18, elapsedMs: 1000.5 },
+  ]);
+  assert.equal(matchWinner(equal, 0), 1, 'a quarter millisecond still separates the times');
+  const lowSeedFirst = play(start, [
+    { moves: 20, elapsedMs: 9000 },
+    { moves: 18, elapsedMs: 9000 },
+    { moves: 18, elapsedMs: 5000 },
+    { moves: 20, elapsedMs: 5000 },
+  ]);
+  assert.deepEqual(matchSeeds(lowSeedFirst, 2), [4, 2]);
+  const tied = play(lowSeedFirst, [
+    { moves: 40, elapsedMs: 3000 },
+    { moves: 40, elapsedMs: 3000 },
+  ]);
+  assert.equal(matchWinner(tied, 2), 2, 'seed 2 beats seed 4 although it played second');
+  assert.equal(champion(tied), 'Bo');
+});
+
+test('turns follow the bracket and the final result names a champion', () => {
+  let tournament = fresh(FOUR, FOUR_CODES);
+  const players: string[] = [];
+  for (let turn = 0; turn < 6; turn += 1) {
+    const next = currentTurn(tournament);
+    assert.ok(next);
+    players.push(`${next.match}:${playerName(tournament, next.seed)}`);
+    assert.equal(champion(tournament), null);
+    tournament = recordAttempt(tournament, { moves: 40 - turn, elapsedMs: 1000 });
+  }
+  assert.deepEqual(players, ['0:Ada', '0:Dev', '1:Bo', '1:Cora', '2:Dev', '2:Cora']);
+  assert.equal(currentTurn(tournament), null);
+  assert.equal(attemptCount(tournament), 6);
+  assert.equal(champion(tournament), 'Cora');
+  assert.equal(recordAttempt(tournament, { moves: 32, elapsedMs: 1 }), tournament);
+});
+
+test('a tournament needs distinct deals at each round size and matches played in order', () => {
+  const start = fresh(EIGHT, EIGHT_CODES);
+  assert.ok(isValidTournament(start));
+  const finished = play(
+    start,
+    Array.from({ length: 14 }, (_, turn) => ({
+      moves: turn < 8 ? 8 : turn < 12 ? 18 : 32,
+      elapsedMs: 0,
+    })),
+  );
+  assert.ok(isValidTournament(finished));
+  assert.equal(champion(finished), 'Ada');
+  const swap = (codes: readonly string[]) => ({ ...start, matches: fresh(EIGHT, codes).matches });
+  assert.equal(isValidTournament(swap([...EIGHT_CODES.slice(0, 6), 'np1-6-3'])), false);
+  assert.equal(isValidTournament(swap(['np1-4-2', ...EIGHT_CODES.slice(1)])), false);
+  assert.equal(isValidTournament(fresh(EIGHT.slice(0, 6), EIGHT_CODES.slice(0, 5))), false);
+  assert.equal(isValidTournament(fresh(FOUR, EIGHT_CODES)), false);
+  assert.equal(isValidTournament(fresh(['Ada', ' Bo', 'Cora', 'Dev'], FOUR_CODES)), false);
+  const skipped = start.matches.map((match, index) =>
+    index === 1 ? { ...match, attempts: [{ moves: 8, elapsedMs: 0 }] } : match,
+  );
+  assert.equal(isValidTournament({ ...start, matches: skipped }), false);
+  const quick = play(start, [{ moves: 7, elapsedMs: 0 }]);
+  assert.equal(isValidTournament(quick), false, 'eight pairs take at least eight moves');
+  assert.equal(isValidTournament(play(start, [{ moves: 8, elapsedMs: -1 }])), false);
+  assert.equal(isValidTournament(play(start, [{ moves: 8.5, elapsedMs: 1 }])), false);
+});
diff --git a/src/game/tournament/rules.ts b/src/game/tournament/rules.ts
new file mode 100644
index 0000000..01ef98c
--- /dev/null
+++ b/src/game/tournament/rules.ts
@@ -0,0 +1,186 @@
+import { parseBoardCode } from '../deck.ts';
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import { isNonnegativeSafeInteger } from '../saved-format.ts';
+import { acceptedName, nameProblem } from './names.ts';
+
+export const PLAYER_COUNTS = [4, 8] as const;
+export const RoundName = {
+  quarterfinal: 'Quarterfinal',
+  semifinal: 'Semifinal',
+  final: 'Final',
+} as const;
+type Round = (typeof RoundName)[keyof typeof RoundName];
+const BOARD_SIDE: Readonly<Record<Round, number>> = {
+  [RoundName.quarterfinal]: 4,
+  [RoundName.semifinal]: 6,
+  [RoundName.final]: 8,
+};
+const ATTEMPTS_PER_MATCH = 2;
+
+// One finished game: the completed board's moves and active elapsed milliseconds.
+export interface Attempt {
+  readonly moves: number;
+  readonly elapsedMs: number;
+}
+// Both players of a match play its one board code, the first listed side first.
+export interface Match {
+  readonly boardCode: string;
+  readonly attempts: readonly Attempt[];
+}
+// Players are in entry order, so the first player entered is seed 1.
+export interface Tournament {
+  readonly players: readonly string[];
+  readonly matches: readonly Match[];
+}
+interface Turn {
+  readonly match: number;
+  readonly seed: number;
+}
+
+type Side = { readonly seed: number } | { readonly winnerOf: number };
+interface Slot {
+  readonly round: Round;
+  readonly sides: readonly [Side, Side];
+}
+const seed = (value: number): Side => ({ seed: value });
+const winnerOf = (match: number): Side => ({ winnerOf: match });
+// Opening matches meet 1 against 4 and 2 against 3, or 1-8, 4-5, 3-6 and 2-7. Later rounds pair
+// the winners of neighboring matches.
+const FOUR: readonly Slot[] = [
+  { round: RoundName.semifinal, sides: [seed(1), seed(4)] },
+  { round: RoundName.semifinal, sides: [seed(2), seed(3)] },
+  { round: RoundName.final, sides: [winnerOf(0), winnerOf(1)] },
+];
+const EIGHT: readonly Slot[] = [
+  { round: RoundName.quarterfinal, sides: [seed(1), seed(8)] },
+  { round: RoundName.quarterfinal, sides: [seed(4), seed(5)] },
+  { round: RoundName.quarterfinal, sides: [seed(3), seed(6)] },
+  { round: RoundName.quarterfinal, sides: [seed(2), seed(7)] },
+  { round: RoundName.semifinal, sides: [winnerOf(0), winnerOf(1)] },
+  { round: RoundName.semifinal, sides: [winnerOf(2), winnerOf(3)] },
+  { round: RoundName.final, sides: [winnerOf(4), winnerOf(5)] },
+];
+
+function slots(count: number): readonly Slot[] {
+  return count === 8 ? EIGHT : count === 4 ? FOUR : [];
+}
+
+function isPlayerCount(count: number): boolean {
+  return PLAYER_COUNTS.some((option) => option === count);
+}
+
+// Quarterfinals use 4x4, semifinals 6x6 and the final 8x8.
+export function boardSizes(count: number): number[] {
+  return slots(count).map((slot) => BOARD_SIDE[slot.round]);
+}
+
+export function matchRound(count: number, index: number): string {
+  return slots(count)[index]?.round ?? '';
+}
+
+export function matchLabel(count: number, index: number): string {
+  const all = slots(count);
+  const slot = all[index];
+  if (!slot) return '';
+  const round = all.filter((other) => other.round === slot.round);
+  return round.length === 1 ? slot.round : `${slot.round} ${round.indexOf(slot) + 1}`;
+}
+
+// A side's seed is null until the match that feeds it has a winner.
+export function matchSeeds(
+  tournament: Tournament,
+  index: number,
+): readonly [number | null, number | null] {
+  const slot = slots(tournament.players.length)[index];
+  if (!slot) return [null, null];
+  return [sideSeed(tournament, slot.sides[0]), sideSeed(tournament, slot.sides[1])];
+}
+
+// The earlier match that decides each side, or null for a side seeded from entry.
+export function matchFeeders(
+  count: number,
+  index: number,
+): readonly [number | null, number | null] {
+  const sides = slots(count)[index]?.sides;
+  return sides ? [feeder(sides[0]), feeder(sides[1])] : [null, null];
+}
+
+function feeder(side: Side): number | null {
+  return 'winnerOf' in side ? side.winnerOf : null;
+}
+
+function sideSeed(tournament: Tournament, side: Side): number | null {
+  return 'seed' in side ? side.seed : matchWinner(tournament, side.winnerOf);
+}
+
+// Fewer moves wins. Equal moves go to less active time, then to the higher seed, and seed 1 is
+// the highest. Time compares the game's own milliseconds, not the rounded display.
+export function matchWinner(tournament: Tournament, index: number): number | null {
+  const [first, second] = matchSeeds(tournament, index);
+  const [a, b] = tournament.matches[index]?.attempts ?? [];
+  if (first === null || second === null || !a || !b) return null;
+  if (a.moves !== b.moves) return a.moves < b.moves ? first : second;
+  if (a.elapsedMs !== b.elapsedMs) return a.elapsedMs < b.elapsedMs ? first : second;
+  return Math.min(first, second);
+}
+
+export function playerName(tournament: Tournament, seedNumber: number): string {
+  return tournament.players[seedNumber - 1] ?? '';
+}
+
+// The next unplayed game, or null once the final has both results.
+export function currentTurn(tournament: Tournament): Turn | null {
+  const match = tournament.matches.findIndex((m) => m.attempts.length < ATTEMPTS_PER_MATCH);
+  const played = tournament.matches[match]?.attempts.length ?? 0;
+  const next = matchSeeds(tournament, match)[played];
+  return match < 0 || next === null || next === undefined ? null : { match, seed: next };
+}
+
+export function recordAttempt(tournament: Tournament, attempt: Attempt): Tournament {
+  const turn = currentTurn(tournament);
+  if (!turn) return tournament;
+  const matches = tournament.matches.map((match, index) =>
+    index === turn.match ? { ...match, attempts: [...match.attempts, attempt] } : match,
+  );
+  return { ...tournament, matches };
+}
+
+export function attemptCount(tournament: Tournament): number {
+  return tournament.matches.reduce((total, match) => total + match.attempts.length, 0);
+}
+
+export function champion(tournament: Tournament): string | null {
+  const winner = matchWinner(tournament, tournament.matches.length - 1);
+  return winner === null ? null : playerName(tournament, winner);
+}
+
+// Loaded and saved tournaments need accepted names, a distinct deal of each round's size for
+// every match, plausible finished games and matches played in bracket order.
+export function isValidTournament(tournament: Tournament): boolean {
+  const { players, matches } = tournament;
+  const sizes = boardSizes(players.length);
+  if (!isPlayerCount(players.length) || matches.length !== sizes.length) return false;
+  if (players.some((name) => acceptedName(name) !== name) || nameProblem(players)) return false;
+  if (new Set(matches.map((match) => match.boardCode)).size !== matches.length) return false;
+  let open = false;
+  for (const [index, match] of matches.entries()) {
+    const size = sizes[index] ?? 0;
+    if (parseBoardCode(match.boardCode)?.size !== size) return false;
+    if (match.attempts.length > ATTEMPTS_PER_MATCH || (open && match.attempts.length)) return false;
+    if (!match.attempts.every((attempt) => isFinishedAttempt(attempt, size))) return false;
+    open ||= match.attempts.length < ATTEMPTS_PER_MATCH;
+  }
+  return true;
+}
+
+function isFinishedAttempt(attempt: Attempt, size: number): boolean {
+  const { moves, elapsedMs } = attempt;
+  return (
+    isNonnegativeSafeInteger(moves) &&
+    moves >= size ** 2 / 2 &&
+    moves <= MOVES_MAX &&
+    Number.isFinite(elapsedMs) &&
+    elapsedMs >= 0 &&
+    elapsedMs <= ELAPSED_MAX_MS
+  );
+}

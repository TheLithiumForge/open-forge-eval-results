@@ -0,0 +1,59 @@
+import { useLayoutEffect, useRef } from 'react';
+import { isWon } from '../game.ts';
+import { Board } from '../board/Board.tsx';
+import { BoardHelp } from '../board/BoardHelp.tsx';
+import { GameStatus } from '../status/GameStatus.tsx';
+import { TournamentControl } from './tournament-labels.ts';
+import { useTurn } from './use-turn.ts';
+import type { ReactNode } from 'react';
+import type { BoardFocus } from '../board/Board.tsx';
+import type { Attempt } from './rules.ts';
+
+interface TournamentTurnProps {
+  boardCode: string;
+  focusStart: boolean;
+  after: ReactNode;
+  announce(text: string): void;
+  finish(attempt: Attempt): void;
+}
+
+// Shows the board closed until Start turn. Once the game ends, its board stays for the group to
+// see beside the next action.
+export function TournamentTurn({
+  boardCode,
+  focusStart,
+  after,
+  announce,
+  finish,
+}: TournamentTurnProps) {
+  const { session, activate, start } = useTurn(boardCode, announce, finish);
+  const board = useRef<BoardFocus>(null);
+  const startButton = useRef<HTMLButtonElement>(null);
+  // Next turn and Next match disappear, so their focus moves to the new Start turn button.
+  useLayoutEffect(() => {
+    if (focusStart) startButton.current?.focus();
+  }, [focusStart]);
+  function begin(): void {
+    // Like Resume, the board takes focus before Start turn disappears.
+    board.current?.focusRemembered();
+    start();
+  }
+  const ended = isWon(session.game) && after;
+  return (
+    <>
+      <GameStatus game={session.game} best={null} celebration={session.celebration} />
+      {(session.paused || ended) && (
+        <div className="tournament-actions">
+          {session.paused && (
+            <button ref={startButton} type="button" className="control" onClick={begin}>
+              {TournamentControl.startTurn}
+            </button>
+          )}
+          {ended}
+        </div>
+      )}
+      <BoardHelp />
+      <Board game={session.game} activate={activate} ref={board} />
+    </>
+  );
+}
diff --git a/src/game/tournament/format.test.ts b/src/game/tournament/format.test.ts
new file mode 100644
index 0000000..6829c0f
--- /dev/null
+++ b/src/game/tournament/format.test.ts
@@ -0,0 +1,89 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  decodeTournament,
+  encodeTournament,
+  readTournament,
+  TOURNAMENT_FORMAT,
+  TOURNAMENT_MAX_BYTES,
+  TOURNAMENT_VERSION,
+  TournamentNotice,
+} from './format.ts';
+import { recordAttempt } from './rules.ts';
+import type { Tournament } from './rules.ts';
+
+const STARTED: Tournament = recordAttempt(
+  {
+    players: ['Ada', 'Bo', 'Cora', 'Dev'],
+    matches: ['np1-6-1', 'np1-6-2', 'np1-8-1'].map((boardCode) => ({ boardCode, attempts: [] })),
+  },
+  { moves: 21, elapsedMs: 4321.75 },
+);
+
+function withChange(change: (value: { [key: string]: unknown }) => unknown): string {
+  const value: { [key: string]: unknown } = JSON.parse(encodeTournament(STARTED));
+  return JSON.stringify(change(value) ?? value);
+}
+
+test('an export names its format and version with alphabetical keys at every level', () => {
+  const text = encodeTournament(STARTED);
+  assert.equal(
+    text,
+    JSON.stringify(
+      {
+        format: TOURNAMENT_FORMAT,
+        matches: [
+          { attempts: [{ elapsedMs: 4321.75, moves: 21 }], boardCode: 'np1-6-1' },
+          { attempts: [], boardCode: 'np1-6-2' },
+          { attempts: [], boardCode: 'np1-8-1' },
+        ],
+        players: ['Ada', 'Bo', 'Cora', 'Dev'],
+        version: TOURNAMENT_VERSION,
+      },
+      null,
+      2,
+    ),
+  );
+  assert.equal(TOURNAMENT_FORMAT, 'neon-pairs/tournament');
+  assert.deepEqual(decodeTournament(text), { tournament: STARTED });
+});
+
+test('the first field outside the format is named, even inside a match or attempt', () => {
+  const root = withChange((value) => ({ ...value, extra: true }));
+  assert.deepEqual(decodeTournament(root), { notice: 'Unknown field: extra.' });
+  const nested = withChange((value) => {
+    const matches = value.matches;
+    assert.ok(Array.isArray(matches));
+    matches[0].attempts[0].note = 'fast';
+    matches[1].label = 'second';
+    return { ...value, zeta: 1 };
+  });
+  assert.deepEqual(decodeTournament(nested), { notice: 'Unknown field: note.' });
+});
+
+test('malformed, unsupported or inconsistent tournaments are invalid', () => {
+  const invalid = { notice: TournamentNotice.invalid };
+  assert.deepEqual(decodeTournament('{'), invalid);
+  assert.deepEqual(decodeTournament('[]'), invalid);
+  assert.deepEqual(decodeTournament(withChange((value) => ({ ...value, version: 2 }))), invalid);
+  assert.deepEqual(
+    decodeTournament(withChange((value) => ({ ...value, format: 'neon-pairs/snapshot' }))),
+    invalid,
+  );
+  const missing = withChange((value) => {
+    delete value.players;
+  });
+  assert.deepEqual(decodeTournament(missing), invalid);
+  const repeated = withChange((value) => ({ ...value, players: ['Ada', 'Bo', 'ada', 'Dev'] }));
+  assert.deepEqual(decodeTournament(repeated), invalid);
+  const spaced = withChange((value) => ({ ...value, players: ['Ada', 'Bo  Li', 'Cora', 'Dev'] }));
+  assert.deepEqual(decodeTournament(spaced), invalid);
+  const text = withChange(() => undefined);
+  assert.deepEqual(decodeTournament(text.replace('"moves":21', '"moves":"21"')), invalid);
+  assert.deepEqual(decodeTournament(text.replace('np1-6-2', 'np1-6-1')), invalid);
+  const padded = encodeTournament(STARTED);
+  const limit = padded + ' '.repeat(TOURNAMENT_MAX_BYTES - padded.length);
+  assert.ok('tournament' in decodeTournament(limit));
+  assert.deepEqual(decodeTournament(`${limit} `), invalid);
+  assert.equal(readTournament({ players: STARTED.players }), null);
+});
diff --git a/src/game/tournament/format.ts b/src/game/tournament/format.ts
new file mode 100644
index 0000000..f7b0690
--- /dev/null
+++ b/src/game/tournament/format.ts
@@ -0,0 +1,99 @@
+import { hasExactKeys, isJsonObject, isWithinBytes, parseJson } from '../saved-format.ts';
+import { isValidTournament } from './rules.ts';
+import type { Attempt, Match, Tournament } from './rules.ts';
+
+export const TOURNAMENT_FORMAT = 'neon-pairs/tournament';
+export const TOURNAMENT_VERSION = 1;
+export const TOURNAMENT_MAX_BYTES = 65_536;
+const ROOT_KEYS = ['format', 'matches', 'players', 'version'];
+const RECORD_KEYS = ['matches', 'players'];
+const MATCH_KEYS = ['attempts', 'boardCode'];
+const ATTEMPT_KEYS = ['elapsedMs', 'moves'];
+// The fields each list of objects holds, so a field check can look inside them.
+const LIST_KEYS: Readonly<Record<string, readonly string[]>> = {
+  matches: MATCH_KEYS,
+  attempts: ATTEMPT_KEYS,
+};
+export const TournamentNotice = {
+  invalid: 'Invalid tournament.',
+  loadedCompleted: 'Loaded completed tournament.',
+} as const;
+
+type TournamentRead = { readonly tournament: Tournament } | { readonly notice: string };
+
+// Keys stay in alphabetical order at every level. Elapsed time keeps the game's own precision,
+// so a loaded tie compares the same values the players produced.
+export function tournamentRecord(tournament: Tournament) {
+  return {
+    matches: tournament.matches.map((match) => ({
+      attempts: match.attempts.map((attempt) => ({
+        elapsedMs: attempt.elapsedMs,
+        moves: attempt.moves,
+      })),
+      boardCode: match.boardCode,
+    })),
+    players: tournament.players,
+  };
+}
+
+export function encodeTournament(tournament: Tournament): string {
+  return JSON.stringify(
+    { format: TOURNAMENT_FORMAT, ...tournamentRecord(tournament), version: TOURNAMENT_VERSION },
+    null,
+    2,
+  );
+}
+
+export function decodeTournament(text: string): TournamentRead {
+  const invalid = { notice: TournamentNotice.invalid };
+  const value = isWithinBytes(text, TOURNAMENT_MAX_BYTES) ? parseJson(text) : undefined;
+  if (!isJsonObject(value)) return invalid;
+  if (value.format !== TOURNAMENT_FORMAT || value.version !== TOURNAMENT_VERSION) return invalid;
+  const unknown = unknownField(value, ROOT_KEYS);
+  if (unknown !== null) return { notice: `Unknown field: ${unknown}.` };
+  if (!hasExactKeys(value, ROOT_KEYS)) return invalid;
+  const tournament = readTournament({ matches: value.matches, players: value.players });
+  return tournament ? { tournament } : invalid;
+}
+
+// Finds the first field outside the format in document order, inside matches and attempts too.
+function unknownField(value: Record<string, unknown>, keys: readonly string[]): string | null {
+  for (const [key, child] of Object.entries(value)) {
+    if (!keys.includes(key)) return key;
+    const inner = LIST_KEYS[key];
+    if (!inner || !Array.isArray(child)) continue;
+    for (const item of child) {
+      const found = isJsonObject(item) ? unknownField(item, inner) : null;
+      if (found !== null) return found;
+    }
+  }
+  return null;
+}
+
+// Reads the players and matches of an export or a saved record.
+export function readTournament(value: unknown): Tournament | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, RECORD_KEYS)) return null;
+  const { players, matches } = value;
+  if (!Array.isArray(players) || !Array.isArray(matches)) return null;
+  const names = players.filter((name): name is string => typeof name === 'string');
+  const read: Match[] = [];
+  for (const match of matches) {
+    const next = readMatch(match);
+    if (!next) return null;
+    read.push(next);
+  }
+  const tournament = { players: names, matches: read };
+  return names.length === players.length && isValidTournament(tournament) ? tournament : null;
+}
+
+function readMatch(value: unknown): Match | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, MATCH_KEYS)) return null;
+  if (typeof value.boardCode !== 'string' || !Array.isArray(value.attempts)) return null;
+  const attempts: Attempt[] = [];
+  for (const attempt of value.attempts) {
+    if (!isJsonObject(attempt) || !hasExactKeys(attempt, ATTEMPT_KEYS)) return null;
+    if (typeof attempt.moves !== 'number' || typeof attempt.elapsedMs !== 'number') return null;
+    attempts.push({ moves: attempt.moves, elapsedMs: attempt.elapsedMs });
+  }
+  return { boardCode: value.boardCode, attempts };
+}

+}
diff --git a/src/game/tournament/format.test.ts b/src/game/tournament/format.test.ts
new file mode 100644
index 0000000..af517e5
--- /dev/null
+++ b/src/game/tournament/format.test.ts
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { boardCode } from '../deck.ts';
+import {
+  decodeTournament,
+  encodeTournament,
+  TOURNAMENT_FORMAT,
+  TOURNAMENT_VERSION,
+  TournamentLoad,
+} from './format.ts';
+import { createTournament, recordResult } from './rules.ts';
+import { countingDraw, EIGHT, finishedTournament, FOUR } from './tournament.fixture.ts';
+import type { Tournament } from './rules.ts';
+
+function edited(
+  change: (value: Record<string, unknown>) => void,
+  tournament: Tournament = finishedTournament(),
+): string {
+  const value: unknown = JSON.parse(encodeTournament(tournament));
+  if (typeof value !== 'object' || value === null || Array.isArray(value))
+    throw new Error('Object');
+  const root = Object.fromEntries(Object.entries(value));
+  change(root);
+  return JSON.stringify(root);
+}
+
+function keysInOrder(value: unknown): boolean {
+  if (Array.isArray(value)) return value.every(keysInOrder);
+  if (typeof value !== 'object' || value === null) return true;
+  const keys = Object.keys(value);
+  return (
+    keys.join() === [...keys].sort().join() &&
+    Object.values(value).every((item) => keysInOrder(item))
+  );
+}
+
+test('an export names its format and version with alphabetical keys at every level', () => {
+  const text = encodeTournament(finishedTournament(EIGHT));
+  const value: unknown = JSON.parse(text);
+  assert.ok(typeof value === 'object' && value !== null);
+  assert.deepEqual(Object.keys(value), ['format', 'players', 'rounds', 'version']);
+  assert.ok('format' in value && value.format === TOURNAMENT_FORMAT);
+  assert.equal(TOURNAMENT_FORMAT, 'neon-pairs/tournament');
+  assert.ok('version' in value && value.version === TOURNAMENT_VERSION);
+  assert.ok(keysInOrder(value));
+});
+
+test('finished and unfinished tournaments load back exactly, fractional time included', () => {
+  const draw = countingDraw();
+  const started = recordResult(
+    createTournament(FOUR, draw),
+    { moves: 21, elapsedMs: 4321.75 },
+    draw,
+  );
+  for (const tournament of [started, createTournament(EIGHT, draw), finishedTournament(EIGHT)])
+    assert.deepEqual(decodeTournament(encodeTournament(tournament)), tournament);
+});
+
+test('the first field the format does not define is named, in document order', () => {
+  assert.equal(
+    decodeTournament(edited((root) => Object.assign(root, { notes: 1, extra: 2 }))),
+    'Unknown field: notes.',
+  );
+  const nested = edited((root) => {
+    const text = JSON.stringify(root.rounds).replace('"boardCode"', '"seed":1,"boardCode"');
+    root.rounds = JSON.parse(text);
+    root.later = true;
+  });
+  assert.equal(decodeTournament(nested), 'Unknown field: seed.');
+  const attempt = edited((root) => {
+    root.rounds = JSON.parse(JSON.stringify(root.rounds).replace('"moves"', '"moves":40,"score"'));
+  });
+  assert.equal(decodeTournament(attempt), 'Unknown field: score.');
+});
+
+test('a tournament that breaks its own rules is refused', () => {
+  const refused = [
+    '{',
+    'null',
+    edited((root) => (root.version = 2)),
+    edited((root) => (root.format = 'neon-pairs/snapshot')),
+    edited((root) => delete root.rounds),
+    edited((root) => (root.players = ['Ada', 'Bo', 'Cora'])),
+    edited((root) => (root.players = ['Ada', 'Bo', 'Cora', 'ada'])),
+    edited((root) => (root.players = [' Ada', 'Bo', 'Cora', 'Dev'])),
+    edited((root) => (root.rounds = [])),
+    edited((root) => Array.isArray(root.rounds) && root.rounds.pop()),
+  ];
+  for (const text of refused) assert.equal(decodeTournament(text), TournamentLoad.invalid, text);
+});
+
+test('each match must hold the bracket players, a fresh deal of the right size and ordered turns', () => {
+  const change = (from: string, to: string) =>
+    decodeTournament(
+      edited((root) => (root.rounds = JSON.parse(JSON.stringify(root.rounds).replace(from, to)))),
+    );
+  const codes = finishedTournament()
+    .rounds.flat()
+    .map((match) => match.boardCode);
+  assert.equal(change(codes[1] ?? '', codes[0] ?? ''), TournamentLoad.invalid);
+  assert.equal(change(codes[0] ?? '', boardCode(4, 99)), TournamentLoad.invalid);
+  assert.equal(change('"Ada","Dev"', '"Dev","Ada"'), TournamentLoad.invalid);
+  assert.equal(change('"moves":40', '"moves":17'), TournamentLoad.invalid);
+  assert.equal(change('"moves":40', '"moves":40.5'), TournamentLoad.invalid);
+  assert.equal(change('"elapsedMs":1000.5', '"elapsedMs":-1'), TournamentLoad.invalid);
+  const open = createTournament(FOUR, countingDraw());
+  const turns = (pattern: RegExp, replacement: string) =>
+    decodeTournament(
+      edited((root) => {
+        root.rounds = JSON.parse(JSON.stringify(root.rounds).replace(pattern, replacement));
+      }, open),
+    );
+  const attempt = '{"elapsedMs":1,"moves":18}';
+  assert.equal(turns(/("Cora"\],"results":\[)null/, `$1${attempt}`), TournamentLoad.invalid);
+  assert.equal(turns(/("Dev"\],"results":\[null,)null/, `$1${attempt}`), TournamentLoad.invalid);
+  assert.notEqual(turns(/("Dev"\],"results":\[)null/, `$1${attempt}`), TournamentLoad.invalid);
+});
diff --git a/src/game/tournament/format.ts b/src/game/tournament/format.ts
new file mode 100644
index 0000000..800062b
--- /dev/null
+++ b/src/game/tournament/format.ts
@@ -0,0 +1,162 @@
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import { parseBoardCode } from '../deck.ts';
+import {
+  hasExactKeys,
+  isJsonObject,
+  isNonnegativeSafeInteger,
+  isWithinBytes,
+  parseJson,
+} from '../saved-format.ts';
+import {
+  acceptedName,
+  nameProblem,
+  nextPairs,
+  PLAYER_COUNTS,
+  roundBoardSize,
+  roundNames,
+} from './rules.ts';
+import type { Attempt, Match, Tournament } from './rules.ts';
+
+export const TOURNAMENT_FORMAT = 'neon-pairs/tournament';
+export const TOURNAMENT_VERSION = 1;
+const TOURNAMENT_MAX_BYTES = 65_536;
+// Every level lists its fields in alphabetical order, as the export writes them.
+const ROOT_KEYS = ['format', 'players', 'rounds', 'version'] as const;
+export const DATA_KEYS = ['players', 'rounds'] as const;
+const MATCH_KEYS = ['boardCode', 'players', 'results'] as const;
+const ATTEMPT_KEYS = ['elapsedMs', 'moves'] as const;
+
+export const TournamentLoad = {
+  invalid: 'Invalid tournament.',
+  loaded: 'Loaded tournament.',
+} as const;
+
+// The players and rounds of a tournament in JSON form, with names in place of entry positions.
+// Active time keeps its fractions, so a reloaded match compares exactly as it was played.
+export function tournamentData(tournament: Tournament) {
+  return {
+    players: tournament.players,
+    rounds: tournament.rounds.map((matches) =>
+      matches.map((match) => ({
+        boardCode: match.boardCode,
+        players: match.players.map((player) => tournament.players[player] ?? ''),
+        results: match.results.map((attempt) =>
+          attempt ? { elapsedMs: attempt.elapsedMs, moves: attempt.moves } : null,
+        ),
+      })),
+    ),
+  };
+}
+
+export function encodeTournament(tournament: Tournament): string {
+  const { players, rounds } = tournamentData(tournament);
+  const value = { format: TOURNAMENT_FORMAT, players, rounds, version: TOURNAMENT_VERSION };
+  return JSON.stringify(value, null, 2);
+}
+
+function readPlayers(value: unknown): readonly string[] | null {
+  if (!Array.isArray(value) || !PLAYER_COUNTS.some((count) => count === value.length)) return null;
+  const names: string[] = [];
+  for (const name of value) {
+    if (typeof name !== 'string' || acceptedName(name) !== name) return null;
+    names.push(name);
+  }
+  return nameProblem(names) === null ? names : null;
+}
+
+// An attempt, null for a turn not played yet, or false when the value can't be either.
+function readAttempt(value: unknown, size: number): Attempt | null | false {
+  if (value === null) return null;
+  if (!isJsonObject(value) || !hasExactKeys(value, ATTEMPT_KEYS)) return false;
+  const { elapsedMs, moves } = value;
+  if (!isNonnegativeSafeInteger(moves) || moves < size ** 2 / 2 || moves > MOVES_MAX) return false;
+  if (typeof elapsedMs !== 'number' || !(elapsedMs >= 0 && elapsedMs <= ELAPSED_MAX_MS))
+    return false;
+  return { elapsedMs, moves };
+}
+
+function readMatch(
+  value: unknown,
+  players: Match['players'],
+  names: readonly string[],
+  size: number,
+) {
+  if (!isJsonObject(value) || !hasExactKeys(value, MATCH_KEYS)) return null;
+  const { boardCode, results } = value;
+  if (typeof boardCode !== 'string' || parseBoardCode(boardCode)?.size !== size) return null;
+  const expected = players.map((player) => names[player]);
+  if (!Array.isArray(value.players) || value.players.length !== 2) return null;
+  if (value.players.some((name, index) => name !== expected[index])) return null;
+  if (!Array.isArray(results) || results.length !== 2) return null;
+  const first = readAttempt(results[0], size);
+  const second = readAttempt(results[1], size);
+  if (first === false || second === false || (!first && second)) return null;
+  const match: Match = { boardCode, players, results: [first, second] };
+  return match;
+}
+
+// Rebuilds the tournament round by round, so each match must hold the players the bracket gives it.
+// Turns are played in order: nothing follows an unplayed turn.
+export function readTournament(value: Record<string, unknown>): Tournament | null {
+  const players = readPlayers(value.players);
+  if (!players || !Array.isArray(value.rounds)) return null;
+  const names = roundNames(players.length);
+  let tournament: Tournament = { players, rounds: [] };
+  let open = false;
+  for (const [index, round] of value.rounds.entries()) {
+    const pairs = nextPairs(tournament);
+    const name = names[index];
+    if (!pairs || !name || !Array.isArray(round) || round.length !== pairs.length) return null;
+    const matches: Match[] = [];
+    for (const [position, pair] of pairs.entries()) {
+      const match = readMatch(round[position], pair, players, roundBoardSize(name));
+      if (!match || (open && match.results[0])) return null;
+      open ||= !match.results[1];
+      matches.push(match);
+    }
+    tournament = { players, rounds: [...tournament.rounds, matches] };
+  }
+  const codes = tournament.rounds.flat().map((match) => match.boardCode);
+  if (new Set(codes).size !== codes.length) return null;
+  // A tournament starts with its opening round, and a finished round leads straight into the next.
+  return !tournament.rounds.length || nextPairs(tournament) ? null : tournament;
+}
+
+function extraKey(value: Record<string, unknown>, keys: readonly string[]): string | undefined {
+  return Object.keys(value).find((key) => !keys.includes(key));
+}
+
+// The first field, in document order, that the format doesn't define.
+function unknownField(root: Record<string, unknown>): string | undefined {
+  for (const key of Object.keys(root)) {
+    if (!ROOT_KEYS.some((known) => known === key)) return key;
+    if (key !== 'rounds' || !Array.isArray(root.rounds)) continue;
+    for (const match of root.rounds.flat()) {
+      if (!isJsonObject(match)) continue;
+      for (const field of Object.keys(match)) {
+        if (!MATCH_KEYS.some((known) => known === field)) return field;
+        if (field !== 'results' || !Array.isArray(match.results)) continue;
+        for (const attempt of match.results) {
+          const extra = isJsonObject(attempt) ? extraKey(attempt, ATTEMPT_KEYS) : undefined;
+          if (extra !== undefined) return extra;
+        }
+      }
+    }
+  }
+  return undefined;
+}
+
+// A valid tournament, or the notice that explains why the text was refused.
+export function decodeTournament(text: string): Tournament | string {
+  const value = isWithinBytes(text, TOURNAMENT_MAX_BYTES) ? parseJson(text) : undefined;
+  if (
+    !isJsonObject(value) ||
+    value.format !== TOURNAMENT_FORMAT ||
+    value.version !== TOURNAMENT_VERSION
+  )
+    return TournamentLoad.invalid;
+  const unknown = unknownField(value);
+  if (unknown !== undefined) return `Unknown field: ${unknown}.`;
+  if (!hasExactKeys(value, ROOT_KEYS)) return TournamentLoad.invalid;
+  return readTournament(value) ?? TournamentLoad.invalid;
+}
diff --git a/src/game/tournament/records.test.ts b/src/game/tournament/records.test.ts
new file mode 100644
index 0000000..681c160
--- /dev/null
+++ b/src/game/tournament/records.test.ts
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { readTournaments, saveTournament, TOURNAMENTS_KEY } from './records.ts';
+import { createTournament } from './rules.ts';
+import { countingDraw, EIGHT, finishedTournament, FOUR } from './tournament.fixture.ts';
+import { tournamentData } from './format.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+
+function memoryStore(values: Record<string, string> = {}) {
+  const writes: string[] = [];
+  const store: PreferenceStore = {
+    getItem: (key) => values[key] ?? null,
+    setItem: (key, value) => {
+      writes.push(key);
+      values[key] = value;
+    },
+  };
+  return { store, values, writes };
+}
+
+const refusing: PreferenceStore = {
+  getItem: () => {
+    throw new Error('SecurityError');
+  },
+  setItem: () => {
+    throw new Error('SecurityError');
+  },
+};
+
+test('a finished tournament is saved in the v3 envelope beside unrelated keys', () => {
+  const { store, values } = memoryStore({ other: 'kept' });
+  const empty = readTournaments(store);
+  assert.deepEqual(empty, { items: [], saving: true });
+  const tournament = finishedTournament();
+  const saved = saveTournament(store, empty, tournament);
+  assert.deepEqual(saved, { items: [tournament], saving: true });
+  assert.equal(TOURNAMENTS_KEY, 'np3:tournaments');
+  const stored: unknown = JSON.parse(values[TOURNAMENTS_KEY] ?? '');
+  assert.deepEqual(stored, { v: 3, items: [tournamentData(tournament)] });
+  assert.deepEqual(readTournaments(store), saved);
+  assert.equal(values.other, 'kept');
+});
+
+test('the list keeps its newest ten records, newest first', () => {
+  const { store } = memoryStore();
+  const players = ['Ann', 'Ben', 'Cid', 'Dot', 'Eve', 'Fay', 'Gus', 'Hal', 'Ivy', 'Jo', 'Kit'];
+  let saved = readTournaments(store);
+  for (const name of players)
+    saved = saveTournament(store, saved, finishedTournament([name, 'Bo', 'Cora', 'Dev']));
+  const firsts = readTournaments(store).items.map((tournament) => tournament.players[0]);
+  assert.deepEqual(firsts, [...players].reverse().slice(0, 10));
+});
+
+test('stored text that fails to parse or validate reads as empty and stays until the next save', () => {
+  const unfinished = { v: 3, items: [tournamentData(createTournament(FOUR, countingDraw()))] };
+  const finished = tournamentData(finishedTournament(EIGHT));
+  for (const text of [
+    '{',
+    'null',
+    JSON.stringify({ v: 2, items: [] }),
+    JSON.stringify({ v: 3, items: [], extra: 1 }),
+    JSON.stringify(unfinished),
+    JSON.stringify({ v: 3, items: [finished, { ...finished, players: [] }] }),
+  ]) {
+    const { store, values, writes } = memoryStore({ [TOURNAMENTS_KEY]: text });
+    const saved = readTournaments(store);
+    assert.deepEqual(saved, { items: [], saving: true });
+    assert.deepEqual(writes, []);
+    assert.equal(values[TOURNAMENTS_KEY], text);
+    saveTournament(store, saved, finishedTournament());
+    assert.equal(readTournaments(store).items.length, 1);
+  }
+});
+
+test('blocked storage keeps records in memory and writes nothing over an unread list', () => {
+  const refused = readTournaments(refusing);
+  assert.deepEqual(refused, { items: [], saving: false });
+  const tournament = finishedTournament();
+  assert.deepEqual(saveTournament(refusing, refused, tournament), {
+    items: [tournament],
+    saving: false,
+  });
+  assert.deepEqual(saveTournament(null, readTournaments(null), tournament).saving, false);
+  const { store, writes } = memoryStore();
+  assert.deepEqual(saveTournament(store, refused, tournament).saving, false);
+  assert.deepEqual(writes, []);
+  const failing = { ...memoryStore().store, setItem: refusing.setItem };
+  assert.deepEqual(saveTournament(failing, readTournaments(failing), tournament), {
+    items: [tournament],
+    saving: false,
+  });
+});
diff --git a/src/game/tournament/records.ts b/src/game/tournament/records.ts
new file mode 100644
index 0000000..007166b
--- /dev/null
+++ b/src/game/tournament/records.ts
@@ -0,0 +1,64 @@
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import { DATA_KEYS, readTournament, tournamentData } from './format.ts';
+import { champion } from './rules.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './rules.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+const RECORDS_VERSION = 3;
+const RECORDS_KEPT = 10;
+const RECORDS_KEYS = ['v', 'items'] as const;
+
+// Finished tournaments, newest first. saving is false when the browser store refused us, so the
+// list lasts only for this page.
+export interface SavedTournaments {
+  readonly items: readonly Tournament[];
+  readonly saving: boolean;
+}
+
+// A value that fails to parse or validate reads as no records and stays until the next save.
+function decodeRecords(text: string | null): readonly Tournament[] {
+  if (!text) return [];
+  const value = parseJson(text);
+  if (
+    !isJsonObject(value) ||
+    !hasExactKeys(value, RECORDS_KEYS) ||
+    value.v !== RECORDS_VERSION ||
+    !Array.isArray(value.items)
+  )
+    return [];
+  const items: Tournament[] = [];
+  for (const item of value.items) {
+    const tournament = isJsonObject(item) && hasExactKeys(item, DATA_KEYS) && readTournament(item);
+    if (!tournament || champion(tournament) === null) return [];
+    items.push(tournament);
+  }
+  return items;
+}
+
+export function readTournaments(store: PreferenceStore | null): SavedTournaments {
+  if (!store) return { items: [], saving: false };
+  try {
+    return { items: decodeRecords(store.getItem(TOURNAMENTS_KEY)), saving: true };
+  } catch {
+    return { items: [], saving: false };
+  }
+}
+
+// Adds a finished tournament and keeps the newest ten. After a refused read the stored list is
+// unknown, so nothing is written over it.
+export function saveTournament(
+  store: PreferenceStore | null,
+  saved: SavedTournaments,
+  tournament: Tournament,
+): SavedTournaments {
+  const items = [tournament, ...saved.items].slice(0, RECORDS_KEPT);
+  if (!store || !saved.saving) return { items, saving: false };
+  try {
+    const value = { v: RECORDS_VERSION, items: items.map(tournamentData) };
+    store.setItem(TOURNAMENTS_KEY, JSON.stringify(value));
+    return { items, saving: true };
+  } catch {
+    return { items, saving: false };
+  }
+}

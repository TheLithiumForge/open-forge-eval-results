diff --git a/tests/tournament-fixture.ts b/tests/tournament-fixture.ts
new file mode 100644
index 0000000..0178108
--- /dev/null
+++ b/tests/tournament-fixture.ts
@@ -0,0 +1,67 @@
+import { expect } from './browser-test.ts';
+import { specDeal } from './deal-oracle.ts';
+import { isJsonObject } from '../src/game/saved-format.ts';
+import { parseBoardCode } from '../src/game/deck.ts';
+import { TournamentControl } from '../src/game/tournament/tournament-labels.ts';
+import type { Page } from '@playwright/test';
+
+export function button(page: Page, name: string) {
+  return page.getByRole('button', { name, exact: true });
+}
+
+export async function startTournament(page: Page, names: readonly string[]): Promise<void> {
+  await button(page, TournamentControl.open).click();
+  await page
+    .getByLabel(TournamentControl.players, { exact: true })
+    .selectOption(String(names.length));
+  for (const [index, name] of names.entries())
+    await page.getByLabel(`${TournamentControl.player} ${index + 1}`, { exact: true }).fill(name);
+  await button(page, TournamentControl.start).click();
+}
+
+async function exportedTournament(page: Page): Promise<Record<string, unknown>> {
+  await button(page, TournamentControl.exportTournament).click();
+  const text = await page.getByLabel(TournamentControl.json, { exact: true }).inputValue();
+  const value: unknown = JSON.parse(text);
+  if (!isJsonObject(value)) throw new Error('Expected an exported tournament object.');
+  return value;
+}
+
+// Board codes of every match, round by round, as the export lists them.
+export async function matchCodes(page: Page): Promise<string[][]> {
+  const { rounds } = await exportedTournament(page);
+  if (!Array.isArray(rounds)) throw new Error('Expected tournament rounds.');
+  return rounds.map((round: unknown) =>
+    Array.isArray(round)
+      ? round.map((match: unknown) => (isJsonObject(match) ? String(match.boardCode) : ''))
+      : [],
+  );
+}
+
+// The position pairs of a deal, read from its code with the independent oracle.
+function pairsOf(code: string): number[][] {
+  const parsed = parseBoardCode(code);
+  if (!parsed) throw new Error(`Invalid code ${code}`);
+  const positions = new Map<number, number[]>();
+  for (const [index, face] of specDeal(parsed.size, parsed.seed).entries())
+    positions.set(face, [...(positions.get(face) ?? []), index]);
+  return [...positions.values()];
+}
+
+// Starts the turn on the given deal, misses as often as asked, then finds every pair.
+export async function playTurn(page: Page, code: string, misses = 0): Promise<void> {
+  await button(page, TournamentControl.startTurn).click();
+  const cards = page.locator('.tournament .card');
+  const pairs = pairsOf(code);
+  await expect(cards).toHaveCount(pairs.length * 2);
+  await expect(cards.first()).toBeFocused();
+  const [first = [], second = []] = pairs;
+  for (let miss = 0; miss < misses; miss++) {
+    await cards.nth(first[0] ?? 0).click();
+    await cards.nth(second[0] ?? 0).click();
+    await page.clock.runFor(800);
+  }
+  for (const pair of pairs) for (const index of pair) await cards.nth(index).click();
+  // The final turn of the final replaces the board with the champion, so read the result instead.
+  await expect(page.getByRole('status')).toHaveText(/^Pair found\. All pairs found in /);
+}
diff --git a/tests/tournament-layout.e2e.test.ts b/tests/tournament-layout.e2e.test.ts
new file mode 100644
index 0000000..b96c854
--- /dev/null
+++ b/tests/tournament-layout.e2e.test.ts
@@ -0,0 +1,95 @@
+import { expect, test } from './browser-test.ts';
+import { DealControl } from '../src/game/controls/control-labels.ts';
+import { TournamentControl } from '../src/game/tournament/tournament-labels.ts';
+import { loadTimedBoard } from './game-fixture.ts';
+import { button, matchCodes, playTurn, startTournament } from './tournament-fixture.ts';
+import type { Page } from '@playwright/test';
+
+const PHONE = { width: 390, height: 844 };
+const SCALE_PX = [0, 4, 6, 8, 12, 16, 24, 32];
+const EIGHT = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'Hal'];
+
+// Every visible control on the Tournament screen, or the solo controls, under 44 by 44 CSS pixels.
+function smallTargets(page: Page): Promise<string[]> {
+  return page.evaluate(() =>
+    [
+      ...document.querySelectorAll(
+        '.tournament :is(button, select, input, textarea), .controls button',
+      ),
+    ]
+      .filter((element) => {
+        const box = element.getBoundingClientRect();
+        return box.width > 0 && (box.width < 44 || box.height < 44);
+      })
+      .map((element) => element.outerHTML.slice(0, 60)),
+  );
+}
+
+// Margins, padding and gaps of the tournament screen that are off the spacing scale.
+function offScale(page: Page): Promise<string[]> {
+  return page.evaluate((scale) => {
+    const found = new Set<string>();
+    for (const element of document.querySelectorAll('.tournament, .tournament *')) {
+      if (element.closest('option')) continue;
+      const style = element.computedStyleMap();
+      for (const side of ['top', 'right', 'bottom', 'left'])
+        for (const property of [`margin-${side}`, `padding-${side}`, 'row-gap', 'column-gap']) {
+          const value = style.get(property)?.toString() ?? '';
+          if (value === 'auto' || value === 'normal' || scale.includes(parseFloat(value))) continue;
+          found.add(`${element.tagName.toLowerCase()}.${element.className} ${property} ${value}`);
+        }
+    }
+    return [...found];
+  }, SCALE_PX);
+}
+
+async function expectFits(page: Page): Promise<void> {
+  expect(await smallTargets(page)).toEqual([]);
+  expect(await offScale(page)).toEqual([]);
+  const width = await page.evaluate(() => document.documentElement.scrollWidth);
+  expect(width).toBeLessThanOrEqual(page.viewportSize()?.width ?? 0);
+}
+
+for (const viewport of [PHONE, { width: 1280, height: 800 }])
+  test(`tournament controls keep their target size and spacing at ${viewport.width}px`, async ({
+    page,
+  }) => {
+    await page.setViewportSize(viewport);
+    await loadTimedBoard(page);
+    await expect(button(page, DealControl.newGame)).toBeVisible();
+    await expectFits(page);
+    await button(page, TournamentControl.open).click();
+    await page.getByLabel(TournamentControl.players, { exact: true }).selectOption('8');
+    await expectFits(page);
+    for (const [index, name] of EIGHT.entries())
+      await page.getByLabel(`${TournamentControl.player} ${index + 1}`).fill(name);
+    await button(page, TournamentControl.start).click();
+    await expectFits(page);
+    const [[first = ''] = []] = await matchCodes(page);
+    await playTurn(page, first);
+    await expectFits(page);
+    await button(page, TournamentControl.leave).click();
+    await expect(page.getByRole('dialog')).toBeVisible();
+    for (const name of [TournamentControl.keepPlaying, TournamentControl.confirmLeave]) {
+      const box = await button(page, name).boundingBox();
+      expect(box?.width).toBeGreaterThanOrEqual(44);
+      expect(box?.height).toBeGreaterThanOrEqual(44);
+    }
+    expect(await offScale(page)).toEqual([]);
+  });
+
+test('tournament screens add no motion under reduced motion', async ({ page }) => {
+  await page.emulateMedia({ reducedMotion: 'reduce' });
+  await loadTimedBoard(page);
+  await startTournament(page, EIGHT.slice(0, 4));
+  const [[first = ''] = []] = await matchCodes(page);
+  await playTurn(page, first);
+  const moving = await page.evaluate(
+    () =>
+      [...document.querySelectorAll('.tournament, .tournament *')].filter((element) => {
+        const style = getComputedStyle(element);
+        return style.animationName !== 'none' || parseFloat(style.transitionDuration) > 0;
+      }).length,
+  );
+  expect(moving).toBe(0);
+});

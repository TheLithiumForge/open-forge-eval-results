+export const TournamentControl = {
+  heading: 'Tournament',
+  players: 'Players',
+  names: 'Names',
+  player: 'Player',
+  start: 'Start tournament',
+  back: 'Back to game',
+  startTurn: 'Start turn',
+  nextTurn: 'Next turn',
+  nextMatch: 'Next match',
+  leave: 'Leave tournament',
+  bracket: 'Bracket',
+  moves: 'Moves',
+  time: 'Time',
+  past: 'Past tournaments',
+  transfer: 'Save or load',
+  json: 'Tournament JSON',
+  exportTournament: 'Export tournament',
+  loadTournament: 'Load tournament',
+} as const;
+
+export const TournamentNotice = {
+  missingName: 'Enter a name for every player.',
+  duplicateName: 'Give each player a different name.',
+  loaded: 'Loaded tournament.',
+  invalid: 'Invalid tournament.',
+  noPast: 'No finished tournaments yet.',
+  undecided: 'to be decided',
+  unplayed: '–',
+} as const;
+
+const ROUND_NAMES = ['Final', 'Semifinals', 'Quarterfinals'] as const;
+
+export function playerLabel(seat: number): string {
+  return `${TournamentControl.player} ${seat + 1}`;
+}
+
+export function nowPlaying(name: string): string {
+  return `Now playing: ${name}`;
+}
+
+export function championLine(name: string): string {
+  return `Champion: ${name}`;
+}
+
+export function winnerLine(name: string | null): string {
+  return `Winner: ${name ?? TournamentNotice.undecided}`;
+}
+
+// Rounds count back from the final, so 4 players start at the semifinals and 8 one round earlier.
+export function roundName(roundsLeft: number): string {
+  return ROUND_NAMES[roundsLeft - 1] ?? `Round of ${2 ** roundsLeft}`;
+}
+
+export function matchLabel(match: number): string {
+  return `Match ${match + 1}`;
+}
+
+export function matchDetail(round: string, match: number, first: string, second: string): string {
+  return `${round}, match ${match + 1}: ${first} vs ${second}. Both players get the same deal.`;
+}
+
+export function feederLabel(match: number): string {
+  return `Winner of match ${match + 1}`;
+}
+
+export function turnOverNotice(name: string, next: string): string {
+  return `${name}'s turn is over. ${next} plays the same deal next.`;
+}
+
+export function matchOverNotice(name: string, match: number): string {
+  return `${name} wins match ${match + 1}.`;
+}
+
+export function dealNotice(size: number): string {
+  return `Each match deals one ${size}x${size} board to both players. Fewer moves wins the match, and equal moves go to the faster time.`;
+}
diff --git a/src/game/tournament/tournament-storage.test.ts b/src/game/tournament/tournament-storage.test.ts
new file mode 100644
index 0000000..34b11ba
--- /dev/null
+++ b/src/game/tournament/tournament-storage.test.ts
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { createTournament, recordTurn } from './bracket.ts';
+import {
+  PAST_TOURNAMENTS_KEY,
+  PAST_TOURNAMENTS_MAX,
+  PAST_TOURNAMENTS_VERSION,
+  readPastTournaments,
+  rememberTournament,
+  writePastTournaments,
+} from './tournament-storage.ts';
+import { PREFERENCES_KEY } from '../session/storage.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './bracket.ts';
+
+function memoryStore(initial = ''): PreferenceStore {
+  const entries = new Map([[PAST_TOURNAMENTS_KEY, initial]]);
+  return {
+    getItem: (key) => entries.get(key) ?? null,
+    setItem: (key, value) => {
+      entries.set(key, value);
+    },
+  };
+}
+
+function finished(champion: string): Tournament {
+  const started = createTournament(
+    [champion, 'Ben', 'Cy', 'Di'],
+    ['np1-4-1', 'np1-4-2', 'np1-4-3'],
+  );
+  return [8, 9, 9, 10, 8, 9]
+    .map((moves) => ({ moves, elapsedMs: 1000 }))
+    .reduce(recordTurn, started);
+}
+
+test('finished tournaments survive a storage round trip in the order they finished', () => {
+  const store = memoryStore();
+  const past = rememberTournament(rememberTournament([], finished('Ann')), finished('Ali'));
+  writePastTournaments(store, past);
+  assert.deepEqual(readPastTournaments(store), past);
+  assert.deepEqual(
+    readPastTournaments(store).map((tournament) => tournament.players[0]),
+    ['Ann', 'Ali'],
+  );
+});
+
+test('the list keeps only the most recent finished tournaments', () => {
+  let past: readonly Tournament[] = [];
+  for (let index = 0; index <= PAST_TOURNAMENTS_MAX; index += 1)
+    past = rememberTournament(past, finished(`P${index}`));
+  assert.equal(past.length, PAST_TOURNAMENTS_MAX);
+  assert.equal(past[0]?.players[0], 'P1');
+  assert.equal(past.at(-1)?.players[0], `P${PAST_TOURNAMENTS_MAX}`);
+});
+
+test('damaged or unfinished entries drop out and unreadable data gives an empty list', () => {
+  const kept = finished('Ann');
+  const store = memoryStore();
+  writePastTournaments(store, [kept]);
+  const value = JSON.parse(store.getItem(PAST_TOURNAMENTS_KEY) ?? '');
+  const unfinished = {
+    ...value.tournaments[0],
+    matches: createTournament(['A', 'B', 'C', 'D'], ['np1-4-1', 'np1-4-2', 'np1-4-3']).matches,
+  };
+  value.tournaments.push({ broken: true }, unfinished, { ...value.tournaments[0], stage: 'ready' });
+  store.setItem(PAST_TOURNAMENTS_KEY, JSON.stringify(value));
+  assert.deepEqual(readPastTournaments(store), [kept]);
+  for (const text of ['{', 'null', '{}', JSON.stringify({ schemaVersion: 2, tournaments: [] })])
+    assert.deepEqual(readPastTournaments(memoryStore(text)), []);
+  assert.deepEqual(
+    readPastTournaments(
+      memoryStore(JSON.stringify({ schemaVersion: PAST_TOURNAMENTS_VERSION, tournaments: {} })),
+    ),
+    [],
+  );
+});
+
+test('blocked storage keeps play going and never changes unrelated keys', () => {
+  const denied: PreferenceStore = {
+    getItem: () => {
+      throw new Error();
+    },
+    setItem: () => {
+      throw new Error();
+    },
+  };
+  assert.deepEqual(readPastTournaments(denied), []);
+  assert.deepEqual(readPastTournaments(null), []);
+  assert.doesNotThrow(() => writePastTournaments(denied, [finished('Ann')]));
+  const store = memoryStore();
+  store.setItem(PREFERENCES_KEY, 'kept');
+  writePastTournaments(store, [finished('Ann')]);
+  assert.equal(store.getItem(PREFERENCES_KEY), 'kept');
+});
diff --git a/src/game/tournament/tournament-storage.ts b/src/game/tournament/tournament-storage.ts
new file mode 100644
index 0000000..543d36e
--- /dev/null
+++ b/src/game/tournament/tournament-storage.ts
@@ -0,0 +1,58 @@
+import { isJsonObject, parseJson } from '../saved-format.ts';
+import { champion } from './bracket.ts';
+import { readSavedTournament, tournamentValue, TournamentStage } from './tournament-format.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './bracket.ts';
+
+export const PAST_TOURNAMENTS_KEY = 'neon-pairs.tournaments.v1';
+export const PAST_TOURNAMENTS_VERSION = 1;
+// The list keeps the most recent finished tournaments, so saved data stays small.
+export const PAST_TOURNAMENTS_MAX = 50;
+
+// Unreadable saved data gives an empty list, and one damaged entry drops only itself.
+export function readPastTournaments(store: PreferenceStore | null): readonly Tournament[] {
+  try {
+    const value = parseJson(store?.getItem(PAST_TOURNAMENTS_KEY) ?? '');
+    if (
+      !isJsonObject(value) ||
+      value.schemaVersion !== PAST_TOURNAMENTS_VERSION ||
+      !Array.isArray(value.tournaments)
+    )
+      return [];
+    return value.tournaments
+      .flatMap((entry: unknown) => {
+        const saved = readSavedTournament(entry);
+        if (!saved || saved.stage !== TournamentStage.ended || champion(saved) === null) return [];
+        return [{ players: saved.players, matches: saved.matches }];
+      })
+      .slice(-PAST_TOURNAMENTS_MAX);
+  } catch {
+    return [];
+  }
+}
+
+export function rememberTournament(
+  past: readonly Tournament[],
+  tournament: Tournament,
+): readonly Tournament[] {
+  return [...past, tournament].slice(-PAST_TOURNAMENTS_MAX);
+}
+
+export function writePastTournaments(
+  store: PreferenceStore | null,
+  past: readonly Tournament[],
+): void {
+  try {
+    store?.setItem(
+      PAST_TOURNAMENTS_KEY,
+      JSON.stringify({
+        schemaVersion: PAST_TOURNAMENTS_VERSION,
+        tournaments: past.map((tournament) =>
+          tournamentValue({ ...tournament, stage: TournamentStage.ended, game: null }),
+        ),
+      }),
+    );
+  } catch {
+    // A blocked browser store keeps the list for this page only.
+  }
+}

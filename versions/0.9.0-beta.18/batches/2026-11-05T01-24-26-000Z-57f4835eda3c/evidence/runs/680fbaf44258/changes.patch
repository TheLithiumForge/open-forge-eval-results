+import { useEffect, useImperativeHandle, useRef } from 'react';
+import { Board } from '../board/Board.tsx';
+import { GameStatus } from '../status/GameStatus.tsx';
+import { useTurnSession } from './use-turn-session.ts';
+import type { RefObject } from 'react';
+import type { BoardFocus } from '../board/Board.tsx';
+import type { GameState } from '../game.ts';
+
+export interface TurnProgress {
+  progress(): GameState;
+}
+
+interface TurnGameProps {
+  initial: GameState;
+  finish(game: GameState): void;
+  ref: RefObject<TurnProgress | null>;
+}
+
+// Mounts when a player selects Start turn, so focus moves straight to the board.
+export function TurnGame({ initial, finish, ref }: TurnGameProps) {
+  const { session, activate, progress } = useTurnSession(initial, finish);
+  const board = useRef<BoardFocus>(null);
+  useImperativeHandle(ref, () => ({ progress }));
+  useEffect(() => {
+    board.current?.focusRemembered();
+  }, []);
+  return (
+    <>
+      <GameStatus game={session.game} best={null} celebration={session.celebration} />
+      <p id="board-help" className="help">
+        Use a pointer or Tab to enter the board. Arrow keys move between cards. Enter or Space
+        reveals a card.
+      </p>
+      <div className="game-result">
+        <p role="status" aria-live="polite" aria-atomic="true">
+          <span key={session.announcement}>{session.feedback}</span>
+        </p>
+      </div>
+      <Board game={session.game} activate={activate} ref={board} />
+    </>
+  );
+}
diff --git a/src/game/tournament/bracket.test.ts b/src/game/tournament/bracket.test.ts
new file mode 100644
index 0000000..a1fb786
--- /dev/null
+++ b/src/game/tournament/bracket.test.ts
@@ -0,0 +1,102 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  bracketRounds,
+  champion,
+  createTournament,
+  isPlayerCount,
+  lastTurn,
+  matchPlayers,
+  matchWinner,
+  nextTurn,
+  recordTurn,
+  RosterProblem,
+  rosterProblem,
+  turnPlayer,
+} from './bracket.ts';
+import type { Tournament, TurnResult } from './bracket.ts';
+
+const FOUR = ['Ann', 'Ben', 'Cy', 'Di'];
+const EIGHT = [...FOUR, 'Ed', 'Flo', 'Gus', 'Hal'];
+
+function played(tournament: Tournament, results: readonly TurnResult[]): Tournament {
+  return results.reduce(recordTurn, tournament);
+}
+
+function codes(count: number): string[] {
+  return Array.from({ length: count - 1 }, (_, index) => `np1-4-${index + 1}`);
+}
+
+test('only four or eight players make a knockout and each match has its own deal', () => {
+  assert.deepEqual([3, 4, 5, 8, 16].map(isPlayerCount), [false, true, false, true, false]);
+  assert.throws(() => createTournament(['Ann', 'Ben'], ['np1-4-1']));
+  assert.throws(() => createTournament(FOUR, codes(8)));
+  const tournament = createTournament(FOUR, codes(4));
+  assert.deepEqual(
+    tournament.matches.map((match) => match.boardCode),
+    ['np1-4-1', 'np1-4-2', 'np1-4-3'],
+  );
+  assert.ok(tournament.matches.every((match) => match.results.every((slot) => slot === null)));
+});
+
+test('round one pairs neighbours and later matches wait for the winners of earlier ones', () => {
+  assert.deepEqual(bracketRounds(4), [[0, 1], [2]]);
+  assert.deepEqual(bracketRounds(8), [[0, 1, 2, 3], [4, 5], [6]]);
+  const tournament = createTournament(EIGHT, codes(8));
+  assert.deepEqual(
+    [0, 1, 2, 3].map((match) => matchPlayers(tournament, match)),
+    [
+      [0, 1],
+      [2, 3],
+      [4, 5],
+      [6, 7],
+    ],
+  );
+  assert.deepEqual(matchPlayers(tournament, 4), [null, null]);
+  const quarterfinals = played(tournament, [
+    { moves: 9, elapsedMs: 1 },
+    { moves: 8, elapsedMs: 1 },
+    { moves: 8, elapsedMs: 1 },
+    { moves: 9, elapsedMs: 1 },
+  ]);
+  assert.deepEqual(matchPlayers(quarterfinals, 4), [1, 2]);
+  assert.deepEqual(matchPlayers(quarterfinals, 6), [null, null]);
+});
+
+test('fewer moves wins, equal moves go to the faster time and an exact tie to the first player', () => {
+  const tournament = createTournament(FOUR, codes(4));
+  const winner = (first: TurnResult, second: TurnResult) =>
+    matchWinner(played(tournament, [first, second]), 0);
+  assert.equal(winner({ moves: 8, elapsedMs: 9000 }, { moves: 9, elapsedMs: 1000 }), 0);
+  assert.equal(winner({ moves: 10, elapsedMs: 1000 }, { moves: 9, elapsedMs: 9000 }), 1);
+  assert.equal(winner({ moves: 9, elapsedMs: 3001 }, { moves: 9, elapsedMs: 3000 }), 1);
+  assert.equal(winner({ moves: 9, elapsedMs: 3000 }, { moves: 9, elapsedMs: 3000 }), 0);
+  assert.equal(matchWinner(played(tournament, [{ moves: 8, elapsedMs: 1 }]), 0), null);
+});
+
+test('turns run in match order with the first seat first and the final decides the champion', () => {
+  let tournament = createTournament(FOUR, codes(4));
+  assert.equal(lastTurn(tournament), null);
+  const order: (number | null)[] = [];
+  for (const moves of [8, 9, 12, 10, 11, 9]) {
+    const turn = nextTurn(tournament);
+    assert.ok(turn);
+    order.push(turnPlayer(tournament, turn));
+    assert.equal(champion(tournament), null);
+    tournament = recordTurn(tournament, { moves, elapsedMs: 1000 });
+    assert.deepEqual(lastTurn(tournament), turn);
+  }
+  assert.deepEqual(order, [0, 1, 2, 3, 0, 3]);
+  assert.equal(nextTurn(tournament), null);
+  assert.equal(champion(tournament), 3);
+  assert.equal(recordTurn(tournament, { moves: 8, elapsedMs: 1 }), tournament);
+});
+
+test('rosters need a name for each player and names that differ beyond letter case', () => {
+  assert.equal(rosterProblem(FOUR), null);
+  assert.deepEqual(rosterProblem(['Ann', '', 'Cy', '']), { kind: RosterProblem.missing, index: 1 });
+  assert.deepEqual(rosterProblem(['Ann', 'Ben', 'ann', 'Di']), {
+    kind: RosterProblem.duplicate,
+    index: 2,
+  });
+});
diff --git a/src/game/tournament/bracket.ts b/src/game/tournament/bracket.ts
new file mode 100644
index 0000000..d1c4d2a
--- /dev/null
+++ b/src/game/tournament/bracket.ts
@@ -0,0 +1,127 @@
+export const PLAYER_COUNTS = [4, 8] as const;
+export const NAME_MAX_CHARACTERS = 32;
+
+export interface TurnResult {
+  readonly moves: number;
+  readonly elapsedMs: number;
+}
+type Seat = 0 | 1;
+type Slot = TurnResult | null;
+export interface Match {
+  readonly boardCode: string;
+  readonly results: readonly [Slot, Slot];
+}
+export interface Tournament {
+  readonly players: readonly string[];
+  readonly matches: readonly Match[];
+}
+interface Turn {
+  readonly match: number;
+  readonly seat: Seat;
+}
+
+export const RosterProblem = { missing: 'missing', duplicate: 'duplicate' } as const;
+type RosterProblemKind = (typeof RosterProblem)[keyof typeof RosterProblem];
+
+export function isPlayerCount(value: number): boolean {
+  return PLAYER_COUNTS.some((count) => count === value);
+}
+
+// Names arrive trimmed. Names that differ only by letter case would read the same in the bracket.
+export function rosterProblem(
+  names: readonly string[],
+): { readonly kind: RosterProblemKind; readonly index: number } | null {
+  const seen = new Set<string>();
+  for (const [index, name] of names.entries()) {
+    if (!name) return { kind: RosterProblem.missing, index };
+    const key = name.toLowerCase();
+    if (seen.has(key)) return { kind: RosterProblem.duplicate, index };
+    seen.add(key);
+  }
+  return null;
+}
+
+export function createTournament(
+  players: readonly string[],
+  boardCodes: readonly string[],
+): Tournament {
+  if (!isPlayerCount(players.length) || boardCodes.length !== players.length - 1)
+    throw new Error('Invalid tournament.');
+  return {
+    players: [...players],
+    matches: boardCodes.map((boardCode) => ({ boardCode, results: [null, null] })),
+  };
+}
+
+// Matches are numbered round by round. Round one pairs neighbours in entry order, and each later
+// match takes the winners of two earlier matches.
+export function feederMatches(playerCount: number, match: number): readonly [number, number] {
+  const first = 2 * (match - playerCount / 2);
+  return [first, first + 1];
+}
+
+export function matchPlayers(
+  tournament: Tournament,
+  match: number,
+): readonly [number | null, number | null] {
+  const count = tournament.players.length;
+  if (match < count / 2) return [2 * match, 2 * match + 1];
+  const [first, second] = feederMatches(count, match);
+  return [matchWinner(tournament, first), matchWinner(tournament, second)];
+}
+
+// Fewer moves wins. Equal moves go to the faster time, and an exact tie goes to the first player.
+export function matchWinner(tournament: Tournament, match: number): number | null {
+  const [first, second] = tournament.matches[match]?.results ?? [null, null];
+  if (!first || !second) return null;
+  const firstWins =
+    first.moves === second.moves ? first.elapsedMs <= second.elapsedMs : first.moves < second.moves;
+  return matchPlayers(tournament, match)[firstWins ? 0 : 1];
+}
+
+export function nextTurn(tournament: Tournament): Turn | null {
+  for (const [match, { results }] of tournament.matches.entries()) {
+    if (!results[0]) return { match, seat: 0 };
+    if (!results[1]) return { match, seat: 1 };
+  }
+  return null;
+}
+
+// The turn that finished last, which an ended turn still shows until Next turn or Next match.
+export function lastTurn(tournament: Tournament): Turn | null {
+  const next = nextTurn(tournament);
+  if (next?.seat === 1) return { match: next.match, seat: 0 };
+  const match = (next?.match ?? tournament.matches.length) - 1;
+  return match < 0 ? null : { match, seat: 1 };
+}
+
+export function turnPlayer(tournament: Tournament, turn: Turn): number | null {
+  return matchPlayers(tournament, turn.match)[turn.seat];
+}
+
+export function recordTurn(tournament: Tournament, result: TurnResult): Tournament {
+  const turn = nextTurn(tournament);
+  if (!turn) return tournament;
+  return {
+    ...tournament,
+    matches: tournament.matches.map((match, index) => {
+      if (index !== turn.match) return match;
+      const [first, second] = match.results;
+      return { ...match, results: turn.seat === 0 ? [result, second] : [first, result] };
+    }),
+  };
+}
+
+export function champion(tournament: Tournament): number | null {
+  return matchWinner(tournament, tournament.matches.length - 1);
+}
+
+export function bracketRounds(playerCount: number): readonly (readonly number[])[] {
+  const rounds: number[][] = [];
+  let start = 0;
+  for (let size = playerCount / 2; size >= 1; size /= 2) {
+    rounds.push(Array.from({ length: size }, (_, offset) => start + offset));
+    start += size;
+  }
+  return rounds;
+}
diff --git a/src/game/tournament/tournament-flow.test.ts b/src/game/tournament/tournament-flow.test.ts
new file mode 100644
index 0000000..f7e2e65
--- /dev/null
+++ b/src/game/tournament/tournament-flow.test.ts
@@ -0,0 +1,108 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { activateCard, advanceGame, createGame, isWon } from '../game.ts';
+import { EXAMPLE_CODE, EXAMPLE_PAIRS } from '../game.fixture.ts';
+import { champion, nextTurn } from './bracket.ts';
+import { decodeTournament, encodeTournament, TournamentStage } from './tournament-format.ts';
+import {
+  advance,
+  beginTurn,
+  draftNames,
+  editDraft,
+  finishTurn,
+  loadFlow,
+  savedFlow,
+  setupFlow,
+  startTournament,
+} from './tournament-flow.ts';
+import type { GameState } from '../game.ts';
+import type { TournamentFlow } from './tournament-flow.ts';
+
+const CODES = [EXAMPLE_CODE, EXAMPLE_CODE, EXAMPLE_CODE];
+
+function named(names: readonly string[]): TournamentFlow {
+  return names.reduce((flow, name, index) => editDraft(flow, index, name), setupFlow());
+}
+
+// Finds every pair after the given number of misses, with each move taking a second.
+function won(game: GameState, misses: number): GameState {
+  let state = game;
+  for (let miss = 0; miss < misses; miss += 1)
+    state = advanceGame(activateCard(activateCard(state, 0), 1), 1000);
+  for (const index of EXAMPLE_PAIRS.flat()) state = activateCard(advanceGame(state, 500), index);
+  assert.equal(isWon(state), true);
+  return state;
+}
+
+function playTurn(flow: TournamentFlow, misses: number): TournamentFlow {
+  const playing = beginTurn(flow);
+  assert.equal(playing.phase, TournamentStage.playing);
+  assert.ok(playing.progress);
+  return finishTurn(playing, won(playing.progress, misses));
+}
+
+test('drafts keep every slot, trim names and export as a setup stage', () => {
+  const flow = { ...named([' Ann ', 'Ben', 'Cy', 'Di', 'Ed']), count: 4 };
+  assert.deepEqual(draftNames(flow), ['Ann', 'Ben', 'Cy', 'Di']);
+  assert.equal(flow.draft[4], 'Ed');
+  const saved = savedFlow(flow, null);
+  assert.deepEqual(saved, {
+    players: [' Ann ', 'Ben', 'Cy', 'Di'],
+    matches: [],
+    stage: TournamentStage.setup,
+    game: null,
+  });
+  const restored = loadFlow({ ...setupFlow(), count: 8 }, saved);
+  assert.equal(restored.count, 4);
+  assert.deepEqual(restored.draft.slice(0, 4), saved.players);
+});
+
+test('a four-player tournament runs ready, playing and ended turns to a champion', () => {
+  let flow = startTournament(named(['Ann', 'Ben', 'Cy', 'Di']), CODES);
+  assert.equal(flow.phase, TournamentStage.ready);
+  assert.equal(advance(flow), flow);
+  assert.equal(finishTurn(flow, createGame(EXAMPLE_CODE)), flow);
+  for (const misses of [0, 1, 3, 2, 1]) {
+    flow = playTurn(flow, misses);
+    assert.equal(flow.phase, TournamentStage.ended);
+    assert.equal(flow.board, true);
+    assert.equal(beginTurn(flow), flow);
+    flow = advance(flow);
+    assert.equal(flow.progress, null);
+    assert.equal(flow.board, false);
+  }
+  flow = playTurn(flow, 0);
+  assert.ok(flow.tournament);
+  assert.equal(nextTurn(flow.tournament), null);
+  assert.equal(advance(flow), flow);
+  assert.equal(champion(flow.tournament), 3);
+  assert.deepEqual(flow.tournament.matches[0]?.results, [
+    { moves: 8, elapsedMs: 7500 },
+    { moves: 9, elapsedMs: 9000 },
+  ]);
+  assert.equal(flow.turn, 6);
+});
+
+test('export and load keep each stage and a loaded turn resumes at Start turn', () => {
+  const ready = startTournament(named(['Ann', 'Ben', 'Cy', 'Di']), CODES);
+  const playing = beginTurn(ready);
+  const live = activateCard(createGame(EXAMPLE_CODE), 3);
+  const exported = decodeTournament(encodeTournament(savedFlow(playing, live)));
+  assert.ok(exported);
+  assert.equal(exported.stage, TournamentStage.playing);
+  assert.deepEqual(exported.game, live);
+  const loaded = loadFlow(setupFlow(), exported);
+  assert.equal(loaded.phase, TournamentStage.ready);
+  assert.deepEqual(savedFlow(loaded, null), exported);
+  const resumed = beginTurn(loaded);
+  assert.deepEqual(resumed.progress, live);
+  assert.equal(savedFlow(ready, null).stage, TournamentStage.ready);
+  const ended = playTurn(ready, 0);
+  const endedText = encodeTournament(savedFlow(ended, null));
+  const reloaded = decodeTournament(endedText);
+  assert.ok(reloaded);
+  const restored = loadFlow(playing, reloaded);
+  assert.equal(restored.phase, TournamentStage.ended);
+  assert.equal(restored.board, false);
+  assert.equal(advance(restored).phase, TournamentStage.ready);
+});
diff --git a/src/game/tournament/tournament-flow.ts b/src/game/tournament/tournament-flow.ts
new file mode 100644
index 0000000..a7db6a1
--- /dev/null
+++ b/src/game/tournament/tournament-flow.ts
@@ -0,0 +1,121 @@
+import { createGame } from '../game.ts';
+import { createTournament, nextTurn, PLAYER_COUNTS, recordTurn } from './bracket.ts';
+import { TournamentStage } from './tournament-format.ts';
+import type { GameState } from '../game.ts';
+import type { Tournament } from './bracket.ts';
+import type { SavedTournament, TournamentStageKind } from './tournament-format.ts';
+
+const DRAFT_SLOTS = Math.max(...PLAYER_COUNTS);
+
+export interface TournamentFlow {
+  readonly count: number;
+  // Every name slot keeps its draft, so switching from 8 players to 4 and back loses no typing.
+  readonly draft: readonly string[];
+  readonly tournament: Tournament | null;
+  readonly phase: TournamentStageKind;
+  // The game Start turn opens, kept while that turn is on screen. A loaded turn in progress
+  // resumes from it.
+  readonly progress: GameState | null;
+  // A turn finished in this page keeps its board on screen until Next turn or Next match.
+  readonly board: boolean;
+  // Counts started turns, so each turn mounts a fresh game and clock.
+  readonly turn: number;
+}
+
+export function setupFlow(): TournamentFlow {
+  return {
+    count: PLAYER_COUNTS[0],
+    draft: Array.from({ length: DRAFT_SLOTS }, () => ''),
+    tournament: null,
+    phase: TournamentStage.setup,
+    progress: null,
+    board: false,
+    turn: 0,
+  };
+}
+
+export function editDraft(flow: TournamentFlow, index: number, name: string): TournamentFlow {
+  return { ...flow, draft: flow.draft.map((draft, slot) => (slot === index ? name : draft)) };
+}
+
+export function draftNames(flow: TournamentFlow): readonly string[] {
+  return flow.draft.slice(0, flow.count).map((name) => name.trim());
+}
+
+export function startTournament(
+  flow: TournamentFlow,
+  boardCodes: readonly string[],
+): TournamentFlow {
+  return {
+    ...flow,
+    tournament: createTournament(draftNames(flow), boardCodes),
+    phase: TournamentStage.ready,
+    progress: null,
+    board: false,
+  };
+}
+
+export function beginTurn(flow: TournamentFlow): TournamentFlow {
+  const turn = flow.tournament && nextTurn(flow.tournament);
+  const code = turn && flow.tournament?.matches[turn.match]?.boardCode;
+  if (!code || flow.phase !== TournamentStage.ready) return flow;
+  return {
+    ...flow,
+    phase: TournamentStage.playing,
+    progress: flow.progress ?? createGame(code),
+    turn: flow.turn + 1,
+  };
+}
+
+// Results keep whole milliseconds, as snapshots do.
+export function finishTurn(flow: TournamentFlow, game: GameState): TournamentFlow {
+  if (!flow.tournament || flow.phase !== TournamentStage.playing) return flow;
+  const result = { moves: game.moves, elapsedMs: Math.floor(game.elapsedMs) };
+  return {
+    ...flow,
+    tournament: recordTurn(flow.tournament, result),
+    phase: TournamentStage.ended,
+    board: true,
+  };
+}
+
+export function advance(flow: TournamentFlow): TournamentFlow {
+  if (flow.phase !== TournamentStage.ended || !flow.tournament || !nextTurn(flow.tournament))
+    return flow;
+  return { ...flow, phase: TournamentStage.ready, progress: null, board: false };
+}
+
+// A loaded turn in progress waits for Start turn, so its player is ready before the clock runs.
+export function loadFlow(flow: TournamentFlow, saved: SavedTournament): TournamentFlow {
+  const loaded = { ...flow, progress: saved.game, board: false };
+  if (saved.stage === TournamentStage.setup)
+    return {
+      ...loaded,
+      count: saved.players.length,
+      draft: flow.draft.map((name, slot) => saved.players[slot] ?? name),
+      tournament: null,
+      phase: TournamentStage.setup,
+    };
+  return {
+    ...loaded,
+    tournament: { players: saved.players, matches: saved.matches },
+    phase: saved.stage === TournamentStage.playing ? TournamentStage.ready : saved.stage,
+  };
+}
+
+// Live progress comes from the mounted turn, whose clock can be ahead of this state.
+export function savedFlow(flow: TournamentFlow, live: GameState | null): SavedTournament {
+  if (!flow.tournament)
+    return {
+      players: flow.draft.slice(0, flow.count),
+      matches: [],
+      stage: TournamentStage.setup,
+      game: null,
+    };
+  if (flow.phase === TournamentStage.ended)
+    return { ...flow.tournament, stage: TournamentStage.ended, game: null };
+  const game = flow.phase === TournamentStage.playing ? (live ?? flow.progress) : flow.progress;
+  return game
+    ? { ...flow.tournament, stage: TournamentStage.playing, game }
+    : { ...flow.tournament, stage: TournamentStage.ready, game: null };
+}

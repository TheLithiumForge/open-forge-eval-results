+  { length: 8 },
+  (_, seat) => `Player with a long name number ${seat + 1}`,
+);
+const RESULT = { moves: 8, elapsedMs: 3000 };
+
+async function expectFits(page: Page, stage: string): Promise<void> {
+  expect(await offScale(page), `${stage} spacing`).toEqual([]);

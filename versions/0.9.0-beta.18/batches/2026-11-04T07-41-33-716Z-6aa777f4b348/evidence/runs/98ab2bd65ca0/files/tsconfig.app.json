{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/main.tsx", "src/game/**/*.ts", "src/game/**/*.tsx"],
  "exclude": ["src/game/**/*.test.ts", "src/cli"]
}

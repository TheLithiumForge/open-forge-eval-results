{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "allowImportingTsExtensions": true,
    "noEmit": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts", "tests", "src/**/*.test.ts"]
}

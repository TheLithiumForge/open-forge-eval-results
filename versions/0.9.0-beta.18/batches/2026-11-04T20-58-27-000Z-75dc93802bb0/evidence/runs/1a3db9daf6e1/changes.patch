diff --git a/src/game/board/keyboard-movement.test.ts b/src/game/board/keyboard-movement.test.ts
new file mode 100644
index 0000000..0cba283
--- /dev/null
+++ b/src/game/board/keyboard-movement.test.ts
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { arrowTarget } from './keyboard-movement.ts';
+
+test('arrow keys move one card within the row or column', () => {
+  assert.equal(arrowTarget('ArrowRight', 5, 4), 6);
+  assert.equal(arrowTarget('ArrowLeft', 5, 4), 4);
+  assert.equal(arrowTarget('ArrowDown', 5, 4), 9);
+  assert.equal(arrowTarget('ArrowUp', 5, 4), 1);
+});
+
+test('arrow movement stops at every board edge', () => {
+  assert.equal(arrowTarget('ArrowLeft', 4, 4), 4);
+  assert.equal(arrowTarget('ArrowRight', 7, 4), 7);
+  assert.equal(arrowTarget('ArrowUp', 2, 4), 2);
+  assert.equal(arrowTarget('ArrowDown', 255, 16), 255);
+});
+
+test('other keys are left to the browser', () => {
+  for (const key of ['Enter', ' ', 'Tab', 'Home', 'a', 'constructor'])
+    assert.equal(arrowTarget(key, 5, 4), null);
+});
diff --git a/src/game/board/keyboard-movement.ts b/src/game/board/keyboard-movement.ts
new file mode 100644
index 0000000..e7c1e06
--- /dev/null
+++ b/src/game/board/keyboard-movement.ts
@@ -0,0 +1,22 @@
+// Each arrow key moves board focus by one row or column. Edges keep focus on the same card.
+const ARROW_STEPS = {
+  ArrowLeft: { rows: 0, columns: -1 },
+  ArrowRight: { rows: 0, columns: 1 },
+  ArrowUp: { rows: -1, columns: 0 },
+  ArrowDown: { rows: 1, columns: 0 },
+} as const;
+
+function isArrowKey(key: string): key is keyof typeof ARROW_STEPS {
+  return Object.hasOwn(ARROW_STEPS, key);
+}
+
+// Returns the focus destination for an unmodified arrow key, or null for keys the board leaves to
+// the browser.
+export function arrowTarget(key: string, index: number, size: number): number | null {
+  if (!isArrowKey(key)) return null;
+  const step = ARROW_STEPS[key];
+  const row = Math.floor(index / size) + step.rows;
+  const column = (index % size) + step.columns;
+  if (row < 0 || row >= size || column < 0 || column >= size) return index;
+  return row * size + column;
+}

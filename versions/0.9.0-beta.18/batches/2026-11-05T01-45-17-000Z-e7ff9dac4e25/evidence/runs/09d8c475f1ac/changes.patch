+import { expect, test, TestTimeouts } from './browser-test.ts';
+import { DealControl } from '../src/game/controls/control-labels.ts';
+import { TournamentControl } from '../src/game/tournament/tournament-labels.ts';
+import {
+  button,
+  EIGHT,
+  FOUR,
+  matchCodes,
+  openTournament,
+  playMatch,

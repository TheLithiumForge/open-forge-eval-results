@@ -0,0 +1,35 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { nameProblem, normalizeName, NameNotice } from './names.ts';
+
+test('a name is trimmed, collapsed and composed', () => {
+  assert.equal(normalizeName('  Mira  '), 'Mira');
+  assert.equal(normalizeName('Ada   Lovelace'), 'Ada Lovelace');
+  assert.equal(normalizeName('Café'), 'Café');
+  assert.equal(normalizeName("O'Neil"), "O'Neil");
+  assert.equal(normalizeName(normalizeName(' Ada \t Lovelace ')), 'Ada Lovelace');
+});
+
+test('names of two to twenty code points pass at both ends', () => {
+  assert.equal(nameProblem(['Al', 'A\u{1F600}', 'x'.repeat(20), '\u{1F600}'.repeat(20)]), null);
+});
+
+test('names outside two to twenty code points are blocked', () => {
+  for (const bad of ['', '   ', 'A', 'x'.repeat(21), '\u{1F600}'.repeat(21)])
+    assert.equal(nameProblem(['Ada', bad]), NameNotice.length);
+});
+
+test('length is counted after normalization', () => {
+  assert.equal(nameProblem([`  ${'x'.repeat(20)}  `, 'Bo']), null);
+  assert.equal(nameProblem(['  A  ', 'Bo']), NameNotice.length);
+});
+
+test('a repeat is found without regard to case across the whole group', () => {
+  assert.equal(nameProblem(['Mira', 'Bo', 'Cora', 'mira']), NameNotice.duplicate);
+  assert.equal(nameProblem(['Ada Lovelace', 'Bo', 'ADA   LOVELACE']), NameNotice.duplicate);
+  assert.equal(nameProblem(['Mira', 'Mirá']), null);
+});
+
+test('a length failure wins when a repeat is also present', () => {
+  assert.equal(nameProblem(['Mira', 'mira', 'A']), NameNotice.length);
+});
diff --git a/src/game/tournament/names.ts b/src/game/tournament/names.ts
new file mode 100644
index 0000000..dd0881e
--- /dev/null
+++ b/src/game/tournament/names.ts
@@ -0,0 +1,26 @@
+const NAME_MIN = 2;
+const NAME_MAX = 20;
+export const NameNotice = {
+  length: 'Use 2 to 20 characters.',
+  duplicate: 'Each name must be different.',
+} as const;
+
+// The accepted representation: trimmed, one space per inner whitespace run, composed (NFC).
+export function normalizeName(draft: string): string {
+  return draft.trim().replace(/\s+/g, ' ').normalize('NFC');
+}
+
+function codePoints(name: string): number {
+  return Array.from(name).length;
+}
+
+// Checks the accepted names of one group. A length failure wins over a repeat.
+export function nameProblem(names: readonly string[]): string | null {
+  const accepted = names.map(normalizeName);
+  for (const name of accepted) {
+    const length = codePoints(name);
+    if (length < NAME_MIN || length > NAME_MAX) return NameNotice.length;
+  }
+  const keys = new Set(accepted.map((name) => name.toLowerCase()));
+  return keys.size === accepted.length ? null : NameNotice.duplicate;
+}
diff --git a/src/game/tournament/rules.test.ts b/src/game/tournament/rules.test.ts
new file mode 100644
index 0000000..33e39fc
--- /dev/null
+++ b/src/game/tournament/rules.test.ts
@@ -0,0 +1,152 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { boardCode } from '../deck.ts';
+import {
+  champion,
+  createTournament,
+  dealSizes,
+  hasValidDeals,
+  matchPlayers,
+  matchWinner,
+  nextTurn,
+  recordResult,
+  roundNames,
+  turnPlayer,
+} from './rules.ts';
+import type { Result, Tournament } from './rules.ts';
+
+const EIGHT = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'Hal'];
+const FOUR = ['Ada', 'Bo', 'Cora', 'Dev'];
+
+function codesFor(count: number): string[] {
+  return dealSizes(count).map((size, index) => boardCode(size, index + 1));
+}
+
+function names(tournament: Tournament, index: number): (string | null)[] {
+  return matchPlayers(tournament, index).map((seed) =>
+    seed === null ? null : (tournament.players[seed] ?? null),
+  );
+}
+
+// Plays every remaining turn. Each player's result comes from the supplied function.
+function play(tournament: Tournament, result: (seed: number, match: number) => Result): Tournament {
+  let current = tournament;
+  for (let turn = nextTurn(current); turn; turn = nextTurn(current)) {
+    const seed = turnPlayer(current, turn);
+    assert.notEqual(seed, null);
+    current = recordResult(current, turn, result(seed ?? 0, turn.match));
+  }
+  return current;
+}
+
+test('eight entrants open as one against eight, four against five, three against six, two against seven', () => {
+  const tournament = createTournament(EIGHT, codesFor(8));
+  assert.deepEqual(
+    [0, 1, 2, 3].map((index) => names(tournament, index)),
+    [
+      ['Ada', 'Hal'],
+      ['Dev', 'Emi'],
+      ['Cora', 'Finn'],
+      ['Bo', 'Gia'],
+    ],
+  );
+  assert.deepEqual(names(tournament, 4), [null, null]);
+});
+
+test('four entrants open as one against four, then two against three', () => {
+  const tournament = createTournament(FOUR, codesFor(4));
+  assert.deepEqual(
+    [0, 1].map((index) => names(tournament, index)),
+    [
+      ['Ada', 'Dev'],
+      ['Bo', 'Cora'],
+    ],
+  );
+});
+
+test('rounds are named by stage and boards grow from 4x4 to 6x6 to 8x8', () => {
+  assert.deepEqual(roundNames(8), ['Quarterfinal', 'Semifinal', 'Final']);
+  assert.deepEqual(roundNames(4), ['Semifinal', 'Final']);
+  assert.deepEqual(dealSizes(8), [4, 4, 4, 4, 6, 6, 8]);
+  assert.deepEqual(dealSizes(4), [6, 6, 8]);
+});
+
+test('every match needs its own full board code at the size of its stage', () => {
+  const codes = codesFor(4);
+  assert.equal(hasValidDeals(4, codes), true);
+  assert.equal(hasValidDeals(4, [codes[0] ?? '', codes[0] ?? '', codes[2] ?? '']), false);
+  assert.equal(hasValidDeals(4, ['np1-4-1', 'np1-6-2', 'np1-8-3']), false);
+  assert.equal(hasValidDeals(4, codes.slice(0, 2)), false);
+  assert.throws(() => createTournament(FOUR, codes.slice(0, 2)));
+  assert.throws(() => createTournament(EIGHT.slice(0, 5), codes));
+});
+
+test('fewer moves win even when the other player was faster', () => {
+  const tournament = createTournament(FOUR, codesFor(4));
+  const done = play(tournament, (seed, match) =>
+    match === 0
+      ? seed === 0
+        ? { moves: 12, elapsedMs: 70_200 }
+        : { moves: 13, elapsedMs: 58_100 }
+      : { moves: 20 + seed, elapsedMs: 1000 },
+  );
+  assert.equal(matchWinner(done, 0), 0);
+});
+
+test('equal moves go to the lower active time', () => {
+  const tournament = createTournament(FOUR, codesFor(4));
+  const done = play(tournament, (seed, match) =>
+    match === 0
+      ? { moves: 15, elapsedMs: seed === 0 ? 65_900 : 65_200 }
+      : { moves: 20 + seed, elapsedMs: 1000 },
+  );
+  assert.equal(matchWinner(done, 0), 3);
+});
+
+test('equal moves and active time go to the higher seed', () => {
+  const tournament = createTournament(FOUR, codesFor(4));
+  const done = play(tournament, () => ({ moves: 18, elapsedMs: 40_000 }));
+  assert.deepEqual([matchWinner(done, 0), matchWinner(done, 1)], [0, 1]);
+  assert.equal(champion(done), 0);
+});
+
+test('time is compared in milliseconds rather than as shown on screen', () => {
+  const tournament = createTournament(FOUR, codesFor(4));
+  const done = play(tournament, (seed, match) =>
+    match === 0
+      ? { moves: 15, elapsedMs: seed === 0 ? 65_999 : 65_001 }
+      : { moves: 20 + seed, elapsedMs: 1000 },
+  );
+  assert.equal(matchWinner(done, 0), 3);
+});
+
+test('winners advance in bracket order to the final and a champion is named at the end', () => {
+  let tournament = createTournament(EIGHT, codesFor(8));
+  const seen: string[] = [];
+  for (let turn = nextTurn(tournament); turn; turn = nextTurn(tournament)) {
+    const seed = turnPlayer(tournament, turn) ?? 0;
+    seen.push(`${turn.match}:${turn.slot}:${tournament.players[seed]}`);
+    // Lower seeds finish in fewer moves, so the top seeds win every match.
+    tournament = recordResult(tournament, turn, { moves: 10 + seed, elapsedMs: 1000 * seed });
+    assert.equal(champion(tournament) === null, nextTurn(tournament) !== null);
+  }
+  assert.deepEqual(names(tournament, 4), ['Ada', 'Dev']);
+  assert.deepEqual(names(tournament, 5), ['Cora', 'Bo']);
+  assert.deepEqual(names(tournament, 6), ['Ada', 'Bo']);
+  assert.equal(seen.length, 14);
+  assert.equal(seen[0], '0:0:Ada');
+  assert.equal(seen[1], '0:1:Hal');
+  assert.equal(champion(tournament), 0);
+});
+
+test('a result is recorded without changing the earlier tournament', () => {
+  const tournament = createTournament(FOUR, codesFor(4));
+  const turn = nextTurn(tournament);
+  assert.deepEqual(turn, { match: 0, slot: 0 });
+  const next = recordResult(tournament, { match: 0, slot: 0 }, { moves: 9, elapsedMs: 5 });
+  assert.deepEqual(tournament.matches[0]?.results, [null, null]);
+  assert.deepEqual(next.matches[0]?.results, [{ moves: 9, elapsedMs: 5 }, null]);
+  assert.deepEqual(nextTurn(next), { match: 0, slot: 1 });
+  assert.equal(matchWinner(next, 0), null);
+  assert.equal(champion(next), null);
+});
diff --git a/src/game/tournament/rules.ts b/src/game/tournament/rules.ts
new file mode 100644
index 0000000..29b152a
--- /dev/null
+++ b/src/game/tournament/rules.ts
@@ -0,0 +1,147 @@
+import { parseBoardCode } from '../deck.ts';
+
+export const PLAYER_COUNTS = [4, 8] as const;
+export const Round = {
+  quarterfinal: 'Quarterfinal',
+  semifinal: 'Semifinal',
+  final: 'Final',
+} as const;
+type RoundName = (typeof Round)[keyof typeof Round];
+
+// Boards grow with the stage: the Final is always 8x8.
+const STAGE_SIZE: Readonly<Record<RoundName, number>> = {
+  Quarterfinal: 4,
+  Semifinal: 6,
+  Final: 8,
+};
+// Entry order is the seed order, so seed 1 is index 0. These are the opening matches in bracket order.
+const OPENING: Readonly<Record<number, readonly (readonly [number, number])[]>> = {
+  4: [
+    [0, 3],
+    [1, 2],
+  ],
+  8: [
+    [0, 7],
+    [3, 4],
+    [2, 5],
+    [1, 6],
+  ],
+};
+
+export interface Result {
+  readonly moves: number;
+  readonly elapsedMs: number;
+}
+export interface Match {
+  readonly code: string;
+  // Results in play order: the first listed player, then the second.
+  readonly results: readonly [Result | null, Result | null];
+}
+export interface Tournament {
+  readonly players: readonly string[];
+  readonly matches: readonly Match[];
+}
+export interface Turn {
+  readonly match: number;
+  readonly slot: 0 | 1;
+}
+interface MatchInfo {
+  readonly round: RoundName;
+  readonly number: number;
+  readonly size: number;
+  readonly start: number;
+  readonly width: number;
+}
+
+export function isPlayerCount(value: number): boolean {
+  return PLAYER_COUNTS.some((count) => count === value);
+}
+
+export function roundNames(count: number): readonly RoundName[] {
+  return count === 8
+    ? [Round.quarterfinal, Round.semifinal, Round.final]
+    : [Round.semifinal, Round.final];
+}
+
+// Matches are numbered through the whole bracket, one round after another.
+export function matchInfo(count: number, index: number): MatchInfo | null {
+  let start = 0;
+  let width = count / 2;
+  for (const round of roundNames(count)) {
+    if (index >= start && index < start + width)
+      return { round, number: index - start + 1, size: STAGE_SIZE[round], start, width };
+    start += width;
+    width /= 2;
+  }
+  return null;
+}
+
+export function dealSizes(count: number): readonly number[] {
+  return Array.from({ length: count - 1 }, (_, index) => matchInfo(count, index)?.size ?? 0);
+}
+
+// Every match has its own full board code, and its size follows its stage.
+export function hasValidDeals(count: number, codes: readonly string[]): boolean {
+  const sizes = dealSizes(count);
+  return (
+    codes.length === sizes.length &&
+    new Set(codes).size === codes.length &&
+    codes.every((code, index) => parseBoardCode(code)?.size === sizes[index])
+  );
+}
+
+export function createTournament(players: readonly string[], codes: readonly string[]): Tournament {
+  if (!isPlayerCount(players.length) || !hasValidDeals(players.length, codes))
+    throw new Error('Invalid tournament.');
+  return { players, matches: codes.map((code) => ({ code, results: [null, null] })) };
+}
+
+// The two seeds of a match, or null for a place that an earlier match has not decided yet.
+export function matchPlayers(
+  tournament: Tournament,
+  index: number,
+): readonly [number | null, number | null] {
+  const count = tournament.players.length;
+  const opening = OPENING[count]?.[index];
+  if (opening) return opening;
+  const info = matchInfo(count, index);
+  if (!info) return [null, null];
+  const feeder = info.start - info.width * 2 + (info.number - 1) * 2;
+  return [matchWinner(tournament, feeder), matchWinner(tournament, feeder + 1)];
+}
+
+// Fewer moves win, then less active time, then the higher seed (the lower index).
+export function matchWinner(tournament: Tournament, index: number): number | null {
+  const [first, second] = matchPlayers(tournament, index);
+  const [one, two] = tournament.matches[index]?.results ?? [null, null];
+  if (first === null || second === null || one === null || two === null) return null;
+  const difference = one.moves - two.moves || one.elapsedMs - two.elapsedMs;
+  if (difference === 0) return Math.min(first, second);
+  return difference < 0 ? first : second;
+}
+
+export function nextTurn(tournament: Tournament): Turn | null {
+  for (const [match, { results }] of tournament.matches.entries()) {
+    if (results[0] === null) return { match, slot: 0 };
+    if (results[1] === null) return { match, slot: 1 };
+  }
+  return null;
+}
+
+export function turnPlayer(tournament: Tournament, turn: Turn): number | null {
+  return matchPlayers(tournament, turn.match)[turn.slot];
+}
+
+export function recordResult(tournament: Tournament, turn: Turn, result: Result): Tournament {
+  const matches = tournament.matches.map((match, index) => {
+    if (index !== turn.match) return match;
+    const [first, second] = match.results;
+    const results: Match['results'] = turn.slot === 0 ? [result, second] : [first, result];
+    return { ...match, results };
+  });
+  return { ...tournament, matches };
+}
+
+export function champion(tournament: Tournament): number | null {
+  return nextTurn(tournament) ? null : matchWinner(tournament, tournament.matches.length - 1);
+}

new file mode 100644
index 0000000..96ac93f
--- /dev/null
+++ b/src/game/tournament/names.ts
@@ -0,0 +1,38 @@
+const NAME_MIN_LENGTH = 2;
+const NAME_MAX_LENGTH = 20;
+
+const NameNotice = {
+  length: 'Use 2 to 20 characters.',
+  repeat: 'Each name must be different.',
+} as const;
+
+type NameCheck =
+  | { readonly ok: true; readonly names: readonly string[] }
+  | { readonly ok: false; readonly notice: string };
+
+// An accepted name is trimmed, has each inner whitespace run collapsed to one space and is in NFC.
+export function normalizeName(draft: string): string {
+  return draft.normalize('NFC').replace(/\s+/gu, ' ').trim();
+}
+
+// Length counts Unicode code points of the accepted representation, not UTF-16 units.
+export function isValidNameLength(name: string): boolean {
+  const length = Array.from(name).length;
+  return length >= NAME_MIN_LENGTH && length <= NAME_MAX_LENGTH;
+}
+
+// Names in one group compare without regard to case. Display keeps the spelling that was typed.
+function nameKey(name: string): string {
+  return name.toLowerCase();
+}
+
+export function hasRepeatedName(names: readonly string[]): boolean {
+  return new Set(names.map(nameKey)).size !== names.length;
+}
+
+export function checkNames(drafts: readonly string[]): NameCheck {
+  const names = drafts.map(normalizeName);
+  if (!names.every(isValidNameLength)) return { ok: false, notice: NameNotice.length };
+  if (hasRepeatedName(names)) return { ok: false, notice: NameNotice.repeat };
+  return { ok: true, names };
+}
diff --git a/src/game/tournament/rules.test.ts b/src/game/tournament/rules.test.ts
new file mode 100644
index 0000000..5f5b03d
--- /dev/null
+++ b/src/game/tournament/rules.test.ts
@@ -0,0 +1,130 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  boardSizeOf,
+  championOf,
+  createTournament,
+  isFinished,
+  nameOf,
+  nextTurn,
+  pickWinner,
+  recordResult,
+  roundOf,
+  runnerUpOf,
+  seedsOf,
+  winnerOf,
+} from './rules.ts';
+import type { Result, Tournament } from './rules.ts';
+
+const FOUR = ['Ada', 'Bo', 'Cora', 'Dev'];
+const EIGHT = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'Hal'];
+const CODES = ['np1-4-11', 'np1-4-12', 'np1-4-13', 'np1-4-14', 'np1-6-15', 'np1-6-16', 'np1-8-17'];
+
+function opponents(tournament: Tournament, match: number): string[] {
+  return (seedsOf(tournament, match) ?? []).map((seed) => nameOf(tournament, seed));
+}
+
+// Plays every turn so that the first player of each match wins with fewer moves.
+function playOut(tournament: Tournament, turns = Infinity): Tournament {
+  let current = tournament;
+  for (let played = 0; played < turns; played += 1) {
+    const turn = nextTurn(current);
+    if (!turn) break;
+    const moves = 20 + turn.seat;
+    current = recordResult(current, { moves, elapsedMs: 5000 });
+  }
+  return current;
+}
+
+test('four entrants open as seed 1 against 4 and 2 against 3', () => {
+  const tournament = createTournament(FOUR, CODES.slice(0, 3));
+  assert.deepEqual(opponents(tournament, 0), ['Ada', 'Dev']);
+  assert.deepEqual(opponents(tournament, 1), ['Bo', 'Cora']);
+  assert.equal(seedsOf(tournament, 2), null);
+});
+
+test('eight entrants open 1 against 8, 4 against 5, 3 against 6 then 2 against 7', () => {
+  const tournament = createTournament(EIGHT, CODES);
+  assert.deepEqual(opponents(tournament, 0), ['Ada', 'Hal']);
+  assert.deepEqual(opponents(tournament, 1), ['Dev', 'Emi']);
+  assert.deepEqual(opponents(tournament, 2), ['Cora', 'Finn']);
+  assert.deepEqual(opponents(tournament, 3), ['Bo', 'Gia']);
+});
+
+test('rounds are named by stage and a bracket of four has no quarterfinal', () => {
+  const four = [0, 1, 2].map((match) => roundOf(4, match));
+  assert.deepEqual(four, ['Semifinal', 'Semifinal', 'Final']);
+  const eight = [0, 1, 2, 3, 4, 5, 6].map((match) => roundOf(8, match));
+  assert.deepEqual(eight, [
+    'Quarterfinal',
+    'Quarterfinal',
+    'Quarterfinal',
+    'Quarterfinal',
+    'Semifinal',
+    'Semifinal',
+    'Final',
+  ]);
+});
+
+test('stages use the 4x4, 6x6 and 8x8 boards', () => {
+  assert.deepEqual(
+    [0, 1, 2].map((match) => boardSizeOf(4, match)),
+    [6, 6, 8],
+  );
+  assert.deepEqual(
+    [0, 3, 4, 5, 6].map((match) => boardSizeOf(8, match)),
+    [4, 4, 6, 6, 8],
+  );
+});
+
+test('fewer moves win even when the other player was faster', () => {
+  const quick: Result = { moves: 13, elapsedMs: 58_100 };
+  const efficient: Result = { moves: 12, elapsedMs: 70_200 };
+  assert.equal(pickWinner({ seed: 1, result: quick }, { seed: 4, result: efficient }), 4);
+});
+
+test('equal moves go to the lower active time using exact milliseconds', () => {
+  const slower: Result = { moves: 15, elapsedMs: 65_900 };
+  const faster: Result = { moves: 15, elapsedMs: 65_200 };
+  assert.equal(pickWinner({ seed: 2, result: slower }, { seed: 3, result: faster }), 3);
+  assert.equal(pickWinner({ seed: 3, result: faster }, { seed: 2, result: slower }), 3);
+});
+
+test('equal moves and time go to the higher seed whichever plays first', () => {
+  const same: Result = { moves: 15, elapsedMs: 65_200 };
+  assert.equal(pickWinner({ seed: 1, result: same }, { seed: 4, result: same }), 1);
+  assert.equal(pickWinner({ seed: 4, result: same }, { seed: 1, result: same }), 1);
+});
+
+test('turns run in match order and a match needs both results', () => {
+  let tournament = createTournament(FOUR, CODES.slice(0, 3));
+  assert.deepEqual(nextTurn(tournament), { match: 0, seat: 0 });
+  tournament = recordResult(tournament, { moves: 10, elapsedMs: 1000 });
+  assert.deepEqual(nextTurn(tournament), { match: 0, seat: 1 });
+  assert.equal(winnerOf(tournament, 0), null);
+  tournament = recordResult(tournament, { moves: 11, elapsedMs: 900 });
+  assert.equal(winnerOf(tournament, 0), 1);
+  assert.deepEqual(nextTurn(tournament), { match: 1, seat: 0 });
+});
+
+test('winners meet in later rounds, better seed first, until a champion remains', () => {
+  const start = createTournament(EIGHT, CODES);
+  const quarterfinals = playOut(start, 8);
+  assert.deepEqual(opponents(quarterfinals, 4), ['Ada', 'Dev']);
+  assert.deepEqual(opponents(quarterfinals, 5), ['Bo', 'Cora']);
+  const semifinals = playOut(start, 12);
+  assert.deepEqual(opponents(semifinals, 6), ['Ada', 'Bo']);
+  assert.equal(isFinished(semifinals), false);
+  const finished = playOut(start);
+  assert.equal(nextTurn(finished), null);
+  assert.equal(isFinished(finished), true);
+  assert.equal(nameOf(finished, championOf(finished)), 'Ada');
+  assert.equal(nameOf(finished, runnerUpOf(finished)), 'Bo');
+});
+
+test('a tournament without matches has no turn and no champion', () => {
+  const draft = createTournament(FOUR, []);
+  assert.equal(nextTurn(draft), null);
+  assert.equal(championOf(draft), null);
+  assert.equal(isFinished(draft), false);
+});
diff --git a/src/game/tournament/rules.ts b/src/game/tournament/rules.ts
new file mode 100644
index 0000000..b7d194d
--- /dev/null
+++ b/src/game/tournament/rules.ts
@@ -0,0 +1,163 @@
+export const PLAYER_COUNTS = [4, 8] as const;
+export type PlayerCount = (typeof PLAYER_COUNTS)[number];
+
+const Round = {
+  quarterfinal: 'Quarterfinal',
+  semifinal: 'Semifinal',
+  final: 'Final',
+} as const;
+type RoundName = (typeof Round)[keyof typeof Round];
+
+// Each stage uses a supported board side length.
+const ROUND_SIZES: Readonly<Record<RoundName, number>> = {
+  [Round.quarterfinal]: 4,
+  [Round.semifinal]: 6,
+  [Round.final]: 8,
+};
+
+// Seeds follow entry order, so the first player entered is seed 1. Opening matches are listed in
+// bracket order, and each later match takes the winners of the two matches in its entry.
+const OPENING: Readonly<Record<PlayerCount, readonly (readonly [number, number])[]>> = {
+  4: [
+    [1, 4],
+    [2, 3],
+  ],
+  8: [
+    [1, 8],
+    [4, 5],
+    [3, 6],
+    [2, 7],
+  ],
+};
+const FEEDERS: Readonly<Record<PlayerCount, readonly (readonly [number, number])[]>> = {
+  4: [[0, 1]],
+  8: [
+    [0, 1],
+    [2, 3],
+    [4, 5],
+  ],
+};
+
+export interface Result {
+  readonly moves: number;
+  readonly elapsedMs: number;
+}
+export interface Match {
+  readonly boardCode: string;
+  readonly results: readonly Result[];
+}
+// A tournament without matches has not started. Its players are an unchecked draft.
+export interface Tournament {
+  readonly players: readonly string[];
+  readonly matches: readonly Match[];
+}
+export interface Turn {
+  readonly match: number;
+  readonly seat: number;
+}
+
+export function isPlayerCount(value: number): value is PlayerCount {
+  return PLAYER_COUNTS.some((count) => count === value);
+}
+
+function openingOf(count: number): readonly (readonly [number, number])[] {
+  return isPlayerCount(count) ? OPENING[count] : [];
+}
+
+function feedersOf(count: number): readonly (readonly [number, number])[] {
+  return isPlayerCount(count) ? FEEDERS[count] : [];
+}
+
+export function matchCount(count: number): number {
+  return count - 1;
+}
+
+export function roundOf(count: number, match: number): RoundName {
+  const opening = openingOf(count).length;
+  if (match === matchCount(count) - 1) return Round.final;
+  return match < opening && count === 8 ? Round.quarterfinal : Round.semifinal;
+}
+
+export function boardSizeOf(count: number, match: number): number {
+  return ROUND_SIZES[roundOf(count, match)];
+}
+
+export function createTournament(players: readonly string[], codes: readonly string[]): Tournament {
+  return { players, matches: codes.map((boardCode) => ({ boardCode, results: [] })) };
+}
+
+export function hasStarted(tournament: Tournament): boolean {
+  return tournament.matches.length > 0;
+}
+
+// Fewer moves win, then less active time, then the better seed (the lower number).
+export function pickWinner(
+  first: { readonly seed: number; readonly result: Result },
+  second: { readonly seed: number; readonly result: Result },
+): number {
+  if (first.result.moves !== second.result.moves)
+    return first.result.moves < second.result.moves ? first.seed : second.seed;
+  if (first.result.elapsedMs !== second.result.elapsedMs)
+    return first.result.elapsedMs < second.result.elapsedMs ? first.seed : second.seed;
+  return Math.min(first.seed, second.seed);
+}
+
+export function winnerOf(tournament: Tournament, match: number): number | null {
+  const seeds = seedsOf(tournament, match);
+  const results = tournament.matches[match]?.results ?? [];
+  const [first, second] = seeds ?? [];
+  const [one, two] = results;
+  if (first === undefined || second === undefined || !one || !two) return null;
+  return pickWinner({ seed: first, result: one }, { seed: second, result: two });
+}
+
+// The two seeds of a match, better seed first, or null while an earlier match is undecided.
+export function seedsOf(tournament: Tournament, match: number): readonly [number, number] | null {
+  const count = tournament.players.length;
+  const opening = openingOf(count);
+  const pair = opening[match];
+  if (pair) return pair;
+  const feeders = feedersOf(count)[match - opening.length];
+  if (!feeders) return null;
+  const left = winnerOf(tournament, feeders[0]);
+  const right = winnerOf(tournament, feeders[1]);
+  if (left === null || right === null) return null;
+  return left < right ? [left, right] : [right, left];
+}
+
+export function nextTurn(tournament: Tournament): Turn | null {
+  const match = tournament.matches.findIndex((entry) => entry.results.length < 2);
+  const entry = tournament.matches[match];
+  return entry ? { match, seat: entry.results.length } : null;
+}
+
+export function recordResult(tournament: Tournament, result: Result): Tournament {
+  const turn = nextTurn(tournament);
+  if (!turn) return tournament;
+  return {
+    ...tournament,
+    matches: tournament.matches.map((entry, index) =>
+      index === turn.match ? { ...entry, results: [...entry.results, result] } : entry,
+    ),
+  };
+}
+
+export function championOf(tournament: Tournament): number | null {
+  return hasStarted(tournament) ? winnerOf(tournament, tournament.matches.length - 1) : null;
+}
+
+export function isFinished(tournament: Tournament): boolean {
+  return championOf(tournament) !== null;
+}
+
+// The name of a seed, which counts from 1.
+export function nameOf(tournament: Tournament, seed: number | null): string {
+  return seed === null ? '' : (tournament.players[seed - 1] ?? '');
+}
+
+export function runnerUpOf(tournament: Tournament): number | null {
+  const final = tournament.matches.length - 1;
+  const seeds = seedsOf(tournament, final);
+  const champion = championOf(tournament);
+  return seeds && champion !== null ? (seeds.find((seed) => seed !== champion) ?? null) : null;
+}
diff --git a/src/game/tournament/storage.test.ts b/src/game/tournament/storage.test.ts
new file mode 100644
index 0000000..a03c9fc
--- /dev/null
+++ b/src/game/tournament/storage.test.ts
@@ -0,0 +1,111 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { PREFERENCES_KEY } from '../session/storage.ts';
+import { encodeTournament } from './format.ts';
+import { createTournament, recordResult } from './rules.ts';
+import { keepNewest, readTournaments, TOURNAMENTS_KEY, writeTournaments } from './storage.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './rules.ts';
+
+const CODES = ['np1-6-3', 'np1-6-4', 'np1-8-5'];
+
+function memoryStore(initial: Record<string, string> = {}): PreferenceStore & {
+  values: Record<string, string>;
+} {
+  const values = { ...initial };
+  return {
+    values,
+    getItem: (key) => values[key] ?? null,
+    setItem: (key, value) => {
+      values[key] = value;
+    },
+  };
+}
+
+const deniedStore: PreferenceStore = {
+  getItem: () => {
+    throw new Error('denied');
+  },
+  setItem: () => {
+    throw new Error('denied');
+  },
+};
+
+// Names differ by champion so that records can be told apart.
+function finished(champion: string): Tournament {
+  let tournament = createTournament([champion, 'Bo', 'Cora', 'Dev'], CODES);
+  for (let turn = 0; turn < 6; turn += 1)
+    tournament = recordResult(tournament, { moves: 40 + (turn % 2), elapsedMs: 1000 });
+  return tournament;
+}
+
+test('saved tournaments are a version 3 envelope with exactly v and items', () => {
+  const store = memoryStore();
+  assert.equal(writeTournaments(store, [finished('Ada')]).available, true);
+  const saved: unknown = JSON.parse(store.values['np3:tournaments'] ?? '');
+  assert.ok(typeof saved === 'object' && saved !== null);
+  assert.deepEqual(Object.keys(saved).sort(), ['items', 'v']);
+  assert.equal('v' in saved && saved.v, 3);
+  assert.equal(TOURNAMENTS_KEY, 'np3:tournaments');
+  assert.deepEqual(readTournaments(store), { items: [finished('Ada')], available: true });
+});
+
+test('a saved list keeps the newest ten records', () => {
+  let items: readonly Tournament[] = [];
+  for (let record = 0; record < 12; record += 1)
+    items = keepNewest(items, finished(`Ada${record}`));
+  assert.equal(items.length, 10);
+  assert.equal(items[0]?.players[0], 'Ada2');
+  assert.equal(items.at(-1)?.players[0], 'Ada11');
+  const store = memoryStore();
+  writeTournaments(store, items);
+  assert.equal(readTournaments(store).items.length, 10);
+});
+
+test('a missing or unusable stored value reads as an empty list and stays untouched', () => {
+  assert.deepEqual(readTournaments(memoryStore()), { items: [], available: true });
+  const unusable = [
+    '{',
+    'null',
+    '[]',
+    '{"v":3}',
+    '{"v":2,"items":[]}',
+    '{"v":3,"items":{}}',
+    '{"v":3,"items":[],"extra":1}',
+    '{"v":3,"items":[{"format":"neon-pairs/tournament","matches":[],"players":["Ada","Bo","Cora","Dev"],"version":1}]}',
+  ];
+  for (const text of unusable) {
+    const store = memoryStore({ [TOURNAMENTS_KEY]: text });
+    assert.deepEqual(readTournaments(store), { items: [], available: true });
+    assert.equal(store.values[TOURNAMENTS_KEY], text);
+  }
+});
+
+test('one bad record rejects the whole saved list', () => {
+  const record: unknown = JSON.parse(encodeTournament(finished('Ada')));
+  const text = JSON.stringify({ v: 3, items: [record] });
+  assert.equal(readTournaments(memoryStore({ [TOURNAMENTS_KEY]: text })).items.length, 1);
+  const broken = text.replace('"version":1', '"version":9');
+  assert.notEqual(broken, text);
+  assert.deepEqual(readTournaments(memoryStore({ [TOURNAMENTS_KEY]: broken })).items, []);
+  const unfinished = JSON.stringify({
+    v: 3,
+    items: [JSON.parse(encodeTournament(createTournament(['Ada', 'Bo', 'Cora', 'Dev'], CODES)))],
+  });
+  assert.deepEqual(readTournaments(memoryStore({ [TOURNAMENTS_KEY]: unfinished })).items, []);
+});
+
+test('blocked storage reads as empty, reports itself and never throws', () => {
+  assert.deepEqual(readTournaments(null), { items: [], available: false });
+  assert.deepEqual(readTournaments(deniedStore), { items: [], available: false });
+  assert.equal(writeTournaments(null, [finished('Ada')]).available, false);
+  assert.equal(writeTournaments(deniedStore, [finished('Ada')]).available, false);
+});
+
+test('saving tournaments leaves unrelated keys and the preferences alone', () => {
+  const preferences = '{"schemaVersion":1,"size":10,"bestMoves":{"4":12}}';
+  const store = memoryStore({ [PREFERENCES_KEY]: preferences, other: 'kept' });
+  writeTournaments(store, [finished('Ada')]);
+  assert.equal(store.values[PREFERENCES_KEY], preferences);
+  assert.equal(store.values.other, 'kept');
+});
diff --git a/src/game/tournament/storage.ts b/src/game/tournament/storage.ts
new file mode 100644
index 0000000..b594f0e
--- /dev/null
+++ b/src/game/tournament/storage.ts
@@ -0,0 +1,67 @@
+import { isJsonObject, hasExactKeys, parseJson } from '../saved-format.ts';
+import { encodeTournament, parseTournament } from './format.ts';
+import { isFinished } from './rules.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './rules.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+const TOURNAMENTS_ENVELOPE_VERSION = 3;
+const TOURNAMENTS_RETAINED = 10;
+export const TournamentStorageNotice = "Progress won't be saved on this device.";
+
+// `available` is false when the browser store could not be reached or read.
+export interface SavedTournaments {
+  readonly items: readonly Tournament[];
+  readonly available: boolean;
+}
+
+const ENVELOPE_KEYS = ['v', 'items'] as const;
+
+// A stored value that cannot be read is treated as empty and stays untouched until the next save.
+export function readTournaments(store: PreferenceStore | null): SavedTournaments {
+  const empty: SavedTournaments = { items: [], available: store !== null };
+  try {
+    const text = store?.getItem(TOURNAMENTS_KEY);
+    if (!text) return empty;
+    const value = parseJson(text);
+    if (
+      !isJsonObject(value) ||
+      !hasExactKeys(value, ENVELOPE_KEYS) ||
+      value.v !== TOURNAMENTS_ENVELOPE_VERSION ||
+      !Array.isArray(value.items)
+    )
+      return empty;
+    const items: Tournament[] = [];
+    for (const record of value.items) {
+      const item = parseTournament(record);
+      if (!item || !isFinished(item)) return empty;
+      items.push(item);
+    }
+    return { items, available: true };
+  } catch {
+    return { items: [], available: false };
+  }
+}
+
+// A saved list keeps its newest records, and the newest record is last.
+export function keepNewest(items: readonly Tournament[], added: Tournament): readonly Tournament[] {
+  return [...items, added].slice(-TOURNAMENTS_RETAINED);
+}
+
+// Reports whether the browser kept the list, so the screen can say when progress is not saved.
+export function writeTournaments(
+  store: PreferenceStore | null,
+  items: readonly Tournament[],
+): SavedTournaments {
+  try {
+    if (!store) return { items, available: false };
+    const records: unknown[] = items.map((item) => JSON.parse(encodeTournament(item)));
+    store.setItem(
+      TOURNAMENTS_KEY,
+      JSON.stringify({ v: TOURNAMENTS_ENVELOPE_VERSION, items: records }),
+    );
+    return { items, available: true };
+  } catch {
+    return { items, available: false };
+  }
+}

+  await button(page, TournamentControl.leave).click();
+  const dialog = page.getByRole('dialog');
+  await expect(dialog.getByRole('button')).toHaveText(['Keep playing', 'Leave']);
+  await expect(button(page, 'Keep playing')).toBeFocused();

+++ b/src/game/tournament/flow.test.ts
@@ -0,0 +1,96 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { activateCard, createGame, isWon } from '../game.ts';
+import { EXAMPLE_CODE, EXAMPLE_PAIRS } from '../game.fixture.ts';
+import { activateSession, replaceGame } from '../session/session.ts';
+import { finishTurn, initialState, loadedState, screenOf, shownTurn, TurnPhase } from './flow.ts';
+import { createTournament } from './rules.ts';
+import type { GameState } from '../game.ts';
+import type { State } from './flow.ts';
+
+const PLAYERS = ['Ada', 'Bo', 'Cora', 'Dev'];
+const CODES = [EXAMPLE_CODE, 'np1-4-2', 'np1-4-3'];
+
+function wonGame(elapsedMs: number): GameState {
+  let game = createGame(EXAMPLE_CODE);
+  for (const pair of EXAMPLE_PAIRS) for (const index of pair) game = activateCard(game, index);
+  assert.ok(isWon(game));
+  return { ...game, elapsedMs };
+}
+
+function playing(seat: number, match = 0): State {
+  const start = initialState(EXAMPLE_CODE);
+  return {
+    ...start,
+    tournament: createTournament(PLAYERS, CODES),
+    phase: TurnPhase.playing,
+    active: { match, seat },
+  };
+}
+
+test('a tournament starts on the setup screen with four empty names', () => {
+  const state = initialState(EXAMPLE_CODE);
+  assert.equal(screenOf(state), 'setup');
+  assert.equal(state.count, 4);
+  assert.deepEqual(state.drafts, Array(8).fill(''));
+  assert.equal(shownTurn(state), null);
+});
+
+test('tournament games keep their own preferences away from the saved size and bests', () => {
+  const state = initialState(EXAMPLE_CODE);
+  assert.deepEqual(state.session.preferences, { size: 4, bestMoves: {} });
+  const game = createGame('np1-10-5');
+  const replaced = replaceGame(state.session, game, false);
+  assert.equal(replaced.preferences.size, 10);
+  assert.deepEqual(state.session.preferences, { size: 4, bestMoves: {} });
+});
+
+test('the first game of a match is recorded in whole milliseconds without a verdict', () => {
+  const state = playing(0);
+  const won = { ...state.session, game: wonGame(1500.7), feedback: 'Pair found.' };
+  const next = finishTurn(state, won);
+  assert.deepEqual(next?.tournament?.matches[0]?.results, [{ moves: 8, elapsedMs: 1500 }]);
+  assert.equal(next?.phase, TurnPhase.done);
+  assert.equal(next?.session.feedback, 'Pair found.');
+  assert.deepEqual(shownTurn({ ...state, ...next }), { match: 0, seat: 0 });
+});
+
+test('the second game names the match winner in the one announcement', () => {
+  const first = finishTurn(playing(0), { ...playing(0).session, game: wonGame(100) });
+  assert.ok(first);
+  const second = { ...first, phase: TurnPhase.playing, active: { match: 0, seat: 1 } };
+  const session = { ...second.session, game: wonGame(200), feedback: 'Pair found.' };
+  const next = finishTurn(second, session);
+  assert.equal(next?.session.feedback, 'Pair found. Ada wins the match.');
+});
+
+test('a game that is not won records nothing', () => {
+  const state = playing(0);
+  const session = activateSession(state.session, 0);
+  assert.equal(finishTurn(state, session), null);
+});
+
+test('the last game of the final ends the tournament and names its champion', () => {
+  let tournament = createTournament(PLAYERS, CODES);
+  for (let turn = 0; turn < 5; turn += 1) {
+    const state = { ...playing(turn % 2, Math.floor(turn / 2)), tournament };
+    const next = finishTurn(state, { ...state.session, game: wonGame(100 + turn) });
+    assert.ok(next?.tournament);
+    tournament = next.tournament;
+  }
+  const state = { ...playing(1, 2), tournament };
+  const next = finishTurn(state, { ...state.session, game: wonGame(900), feedback: 'Done.' });
+  assert.equal(screenOf({ ...state, ...next }), 'finished');
+  assert.equal(next?.session.feedback, 'Done. Ada wins the tournament.');
+});
+
+test('a loaded draft fills the setup and a loaded tournament continues from its results', () => {
+  const base = initialState(EXAMPLE_CODE);
+  const draft = loadedState(base, { players: ['Eve', 'Fay', 'Gus', 'Hui'], matches: [] });
+  assert.equal(screenOf(draft ?? base), 'setup');
+  assert.deepEqual(draft?.drafts.slice(0, 5), ['Eve', 'Fay', 'Gus', 'Hui', '']);
+  const started = loadedState(base, createTournament(PLAYERS, CODES));
+  assert.equal(screenOf(started ?? base), 'play');
+  assert.deepEqual(started && shownTurn(started), { match: 0, seat: 0 });
+  assert.equal(loadedState(base, { players: ['Eve'], matches: [] }), null);
+});
diff --git a/src/game/tournament/flow.ts b/src/game/tournament/flow.ts
new file mode 100644
index 0000000..fc8a06c
--- /dev/null
+++ b/src/game/tournament/flow.ts
@@ -0,0 +1,101 @@
+import { createGame, isWon } from '../game.ts';
+import { initialSession, replaceGame } from '../session/session.ts';
+import { readPreferences } from '../session/storage.ts';
+import {
+  hasStarted,
+  isFinished,
+  isPlayerCount,
+  nameOf,
+  nextTurn,
+  recordResult,
+  seedsOf,
+  winnerOf,
+} from './rules.ts';
+import type { GameState } from '../game.ts';
+import type { Session } from '../session/session.ts';
+import type { PlayerCount, Result, Tournament, Turn } from './rules.ts';
+
+export const TurnPhase = { idle: 'idle', playing: 'playing', done: 'done' } as const;
+type TurnPhaseName = (typeof TurnPhase)[keyof typeof TurnPhase];
+export const Screen = { setup: 'setup', play: 'play', finished: 'finished' } as const;
+type ScreenName = (typeof Screen)[keyof typeof Screen];
+
+const MAX_DRAFTS = 8;
+
+export interface State {
+  // Tournament games run in their own session, whose preferences are never read from or written
+  // to storage, so a tournament cannot change the saved size or a best score.
+  readonly session: Session;
+  readonly tournament: Tournament | null;
+  readonly count: PlayerCount;
+  readonly drafts: readonly string[];
+  readonly phase: TurnPhaseName;
+  readonly active: Turn | null;
+}
+
+export function initialState(code: string): State {
+  return {
+    session: initialSession(code, readPreferences(null)),
+    tournament: null,
+    count: 4,
+    drafts: Array.from({ length: MAX_DRAFTS }, () => ''),
+    phase: TurnPhase.idle,
+    active: null,
+  };
+}
+
+export function announce(session: Session, feedback: string): Session {
+  return { ...session, feedback, announcement: session.announcement + 1 };
+}
+
+// A fresh unstarted game on the same deal invalidates the pending timer updates of the last one.
+export function resetSession(session: Session): Session {
+  return replaceGame(session, createGame(session.game.boardCode), false);
+}
+
+export function screenOf(state: State): ScreenName {
+  if (!state.tournament) return Screen.setup;
+  return isFinished(state.tournament) ? Screen.finished : Screen.play;
+}
+
+// The turn the screen is about: the next one while waiting, or the one being played or just done.
+export function shownTurn(state: State): Turn | null {
+  if (!state.tournament || isFinished(state.tournament)) return null;
+  return state.phase === TurnPhase.idle ? nextTurn(state.tournament) : state.active;
+}
+
+export function playerOf(tournament: Tournament, turn: Turn): string {
+  const seed = seedsOf(tournament, turn.match)?.[turn.seat];
+  return seed === undefined ? '' : (tournament.players[seed - 1] ?? '');
+}
+
+function resultOf(game: GameState): Result | null {
+  return isWon(game) ? { moves: game.moves, elapsedMs: Math.floor(game.elapsedMs) } : null;
+}
+
+// Records the game that just ended, with the verdict when it ended a match.
+export function finishTurn(state: State, session: Session): State | null {
+  const { tournament, active } = state;
+  const result = resultOf(session.game);
+  if (!tournament || !active || !result) return null;
+  const recorded = recordResult(tournament, result);
+  const lastMatch = active.match === recorded.matches.length - 1;
+  const winner = nameOf(recorded, winnerOf(recorded, active.match));
+  const verdict =
+    active.seat === 1 ? ` ${winner} wins the ${lastMatch ? 'tournament' : 'match'}.` : '';
+  return {
+    ...state,
+    tournament: recorded,
+    phase: TurnPhase.done,
+    session: { ...session, feedback: `${session.feedback}${verdict}` },
+  };
+}
+
+// A loaded tournament that has matches continues from its recorded results. One without matches is
+// a draft that fills the setup. It is never added to the saved list.
+export function loadedState(base: State, tournament: Tournament): State | null {
+  const count = tournament.players.length;
+  if (!isPlayerCount(count)) return null;
+  if (hasStarted(tournament)) return { ...base, tournament, count };
+  return { ...base, count, drafts: [...tournament.players, ...base.drafts.slice(count)] };
+}
diff --git a/src/game/tournament/format.test.ts b/src/game/tournament/format.test.ts
new file mode 100644
index 0000000..b87f1e1
--- /dev/null
+++ b/src/game/tournament/format.test.ts
@@ -0,0 +1,157 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { decodeTournament, encodeTournament, TOURNAMENT_MAX_BYTES } from './format.ts';
+import { createTournament, recordResult } from './rules.ts';
+import type { Tournament } from './rules.ts';
+
+const PLAYERS = ['Ada', 'Bo', 'Cora', 'Dev'];
+const CODES = ['np1-6-3', 'np1-6-4', 'np1-8-5'];
+
+function document(overrides: Record<string, unknown> = {}): Record<string, unknown> {
+  return {
+    format: 'neon-pairs/tournament',
+    matches: [
+      { boardCode: 'np1-6-3', results: [{ elapsedMs: 40_000, moves: 20 }] },
+      { boardCode: 'np1-6-4', results: [] },
+      { boardCode: 'np1-8-5', results: [] },
+    ],
+    players: PLAYERS,
+    version: 1,
+    ...overrides,
+  };
+}
+
+function decode(value: unknown) {
+  return decodeTournament(JSON.stringify(value));
+}
+
+function rejected(value: unknown): string | null {
+  const decoded = decode(value);
+  return decoded.ok ? null : decoded.notice;
+}
+
+function keysAreSorted(value: unknown): boolean {
+  if (Array.isArray(value)) return value.every(keysAreSorted);
+  if (typeof value !== 'object' || value === null) return true;
+  const keys = Object.keys(value);
+  return keys.join() === [...keys].sort().join() && Object.values(value).every(keysAreSorted);
+}
+
+test('an exported tournament names its format and version and keeps keys in alphabetical order', () => {
+  let tournament = createTournament(PLAYERS, CODES);
+  tournament = recordResult(tournament, { moves: 20, elapsedMs: 40_000 });
+  const text = encodeTournament(tournament);
+  const value: unknown = JSON.parse(text);
+  assert.ok(keysAreSorted(value));
+  assert.deepEqual(value, document());
+  assert.match(text, /^\{\n {2}"format": "neon-pairs\/tournament",\n {2}"matches": \[/);
+});
+
+test('a draft, a tournament in progress and a finished tournament all round trip', () => {
+  const draft: Tournament = { players: ['Ada', '', 'C', 'Dev'], matches: [] };
+  let played = createTournament(PLAYERS, CODES);
+  const forms = [draft, played];
+  for (const [moves, elapsedMs] of [
+    [20, 9],
+    [21, 8],
+    [20, 9],
+    [22, 8],
+    [33, 9],
+    [34, 7],
+  ] as const) {
+    played = recordResult(played, { moves, elapsedMs });
+    forms.push(played);
+  }
+  for (const tournament of forms) {
+    const decoded = decodeTournament(encodeTournament(tournament));
+    assert.deepEqual(decoded, { ok: true, tournament });
+  }
+});
+
+test('a field the format does not define is named and wins over other problems', () => {
+  assert.equal(rejected(document({ extra: 1 })), 'Unknown field: extra.');
+  assert.equal(rejected(document({ extra: 1, version: 2 })), 'Unknown field: extra.');
+  const nested = document({
+    matches: [
+      { boardCode: 'np1-6-3', results: [{ elapsedMs: 1, moves: 20, note: 'x' }], hint: 'y' },
+    ],
+  });
+  assert.equal(rejected(nested), 'Unknown field: hint.');
+  const inResult = document({
+    matches: [{ boardCode: 'np1-6-3', results: [{ elapsedMs: 40_000, moves: 20, note: 'x' }] }],
+  });
+  assert.equal(rejected(inResult), 'Unknown field: note.');
+  assert.equal(rejected({ ...document(), zeta: 1, alpha: 2 }), 'Unknown field: zeta.');
+});
+
+test('input that is not a complete version 1 tournament is invalid', () => {
+  assert.equal(decodeTournament('{').ok, false);
+  assert.equal(decodeTournament('[]').ok, false);
+  assert.equal(decodeTournament('null').ok, false);
+  const cases: unknown[] = [
+    document({ format: 'neon-pairs/snapshot' }),
+    document({ version: '1' }),
+    document({ version: 2 }),
+    document({ players: ['Ada', 'Bo', 'Cora'] }),
+    document({ players: ['Ada', 'Bo', 'Cora', 'dev', 'ADA', 'x', 'y', 'z'] }),
+    document({ players: ['Ada', 'Bo', 'Cora', 'ada'] }),
+    document({ players: ['Ada', 'Bo', 'Cora', ' Dev'] }),
+    document({ players: ['Ada', 'Bo', 'Cora', 'D'] }),
+    document({ players: ['Ada', 'Bo', 'Cora', 4] }),
+  ];
+  for (const value of cases) assert.equal(rejected(value), 'Invalid tournament.');
+  const { matches, ...withoutMatches } = document();
+  assert.ok(Array.isArray(matches));
+  assert.equal(rejected(withoutMatches), 'Invalid tournament.');
+});
+
+test('matches need the right board size, distinct codes and results in play order', () => {
+  const match = (boardCode: string, count: number) => ({
+    boardCode,
+    results: Array.from({ length: count }, () => ({ elapsedMs: 1000, moves: 40 })),
+  });
+  const cases: unknown[] = [
+    document({ matches: [match('np1-4-3', 0), match('np1-6-4', 0), match('np1-8-5', 0)] }),
+    document({ matches: [match('np1-6-3', 0), match('np1-6-3', 0), match('np1-8-5', 0)] }),
+    document({ matches: [match('np1-6-3', 0), match('np1-6-4', 0)] }),
+    document({ matches: [match('np1-6-3', 3), match('np1-6-4', 0), match('np1-8-5', 0)] }),
+    document({ matches: [match('np1-6-3', 1), match('np1-6-4', 1), match('np1-8-5', 0)] }),
+    document({ matches: [match('np1-6-3', 0), match('np1-6-4', 0), match('np1-8-5', 1)] }),
+    document({ matches: [match('np1-6-3', 0), match('np1-6-4', 0), match('np1-8-05', 0)] }),
+  ];
+  for (const value of cases) assert.equal(rejected(value), 'Invalid tournament.');
+  assert.equal(
+    decode(document({ matches: [match('np1-6-3', 2), match('np1-6-4', 1), match('np1-8-5', 0)] }))
+      .ok,
+    true,
+  );
+});
+
+test('results stay within what a completed game can record', () => {
+  const withResult = (result: unknown) =>
+    document({
+      matches: [
+        { boardCode: 'np1-6-3', results: [result] },
+        { boardCode: 'np1-6-4', results: [] },
+        { boardCode: 'np1-8-5', results: [] },
+      ],
+    });
+  assert.equal(decode(withResult({ elapsedMs: 0, moves: 18 })).ok, true);
+  assert.equal(decode(withResult({ elapsedMs: 359_999_999, moves: 999_999 })).ok, true);
+  for (const result of [
+    { elapsedMs: 0, moves: 17 },
+    { elapsedMs: 0, moves: 1_000_000 },
+    { elapsedMs: 360_000_000, moves: 20 },
+    { elapsedMs: -1, moves: 20 },
+    { elapsedMs: 1.5, moves: 20 },
+    { elapsedMs: '5', moves: 20 },
+    { elapsedMs: 5 },
+    {},
+  ])
+    assert.equal(rejected(withResult(result)), 'Invalid tournament.');
+});
+
+test('text past the byte limit is invalid', () => {
+  const padded = `${JSON.stringify(document())}${' '.repeat(TOURNAMENT_MAX_BYTES)}`;
+  assert.equal(decodeTournament(padded).ok, false);
+});
diff --git a/src/game/tournament/format.ts b/src/game/tournament/format.ts
new file mode 100644
index 0000000..4dec69d
--- /dev/null
+++ b/src/game/tournament/format.ts
@@ -0,0 +1,127 @@
+import { parseBoardCode } from '../deck.ts';
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import {
+  hasExactKeys,
+  isJsonObject,
+  isNonnegativeSafeInteger,
+  isWithinBytes,
+  parseJson,
+} from '../saved-format.ts';
+import { checkNames, normalizeName } from './names.ts';
+import { boardSizeOf, hasStarted, isPlayerCount, matchCount, nextTurn } from './rules.ts';
+import type { Match, Result, Tournament } from './rules.ts';
+
+const TOURNAMENT_FORMAT = 'neon-pairs/tournament';
+const TOURNAMENT_VERSION = 1;
+export const TOURNAMENT_MAX_BYTES = 65_536;
+const TournamentNotice = { invalid: 'Invalid tournament.' } as const;
+
+const ROOT_KEYS = ['format', 'matches', 'players', 'version'] as const;
+const MATCH_KEYS = ['boardCode', 'results'] as const;
+const RESULT_KEYS = ['elapsedMs', 'moves'] as const;
+
+type TournamentDecoding =
+  | { readonly ok: true; readonly tournament: Tournament }
+  | { readonly ok: false; readonly notice: string };
+
+// Keys are written in alphabetical order at every level. Derived values are not written, so the
+// winners, rounds and champion always come from the recorded results.
+export function encodeTournament(tournament: Tournament): string {
+  return JSON.stringify(
+    {
+      format: TOURNAMENT_FORMAT,
+      matches: tournament.matches.map((match) => ({
+        boardCode: match.boardCode,
+        results: match.results.map(({ elapsedMs, moves }) => ({ elapsedMs, moves })),
+      })),
+      players: tournament.players,
+      version: TOURNAMENT_VERSION,
+    },
+    null,
+    2,
+  );
+}
+
+function unknownKey(value: unknown, keys: readonly string[]): string | null {
+  return isJsonObject(value)
+    ? (Object.keys(value).find((key) => !keys.includes(key)) ?? null)
+    : null;
+}
+
+// Document order: the root keys, then each match, then each of its results.
+function firstUnknownField(value: unknown): string | null {
+  const root = unknownKey(value, ROOT_KEYS);
+  if (root !== null || !isJsonObject(value) || !Array.isArray(value.matches)) return root;
+  for (const match of value.matches) {
+    const key = unknownKey(match, MATCH_KEYS);
+    if (key !== null) return key;
+    if (!isJsonObject(match) || !Array.isArray(match.results)) continue;
+    for (const result of match.results) {
+      const field = unknownKey(result, RESULT_KEYS);
+      if (field !== null) return field;
+    }
+  }
+  return null;
+}
+
+function readResult(value: unknown, size: number): Result | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, RESULT_KEYS)) return null;
+  const { moves, elapsedMs } = value;
+  if (!isNonnegativeSafeInteger(moves) || !isNonnegativeSafeInteger(elapsedMs)) return null;
+  // A completed board takes at least one move for each pair.
+  if (moves > MOVES_MAX || moves < size ** 2 / 2 || elapsedMs > ELAPSED_MAX_MS) return null;
+  return { moves, elapsedMs };
+}
+
+function readMatch(value: unknown, count: number, index: number): Match | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, MATCH_KEYS)) return null;
+  const { boardCode, results } = value;
+  const size = boardSizeOf(count, index);
+  if (typeof boardCode !== 'string' || parseBoardCode(boardCode)?.size !== size) return null;
+  if (!Array.isArray(results) || results.length > 2) return null;
+  const read = results.map((result) => readResult(result, size));
+  const checked = read.filter((result) => result !== null);
+  return checked.length === read.length ? { boardCode, results: checked } : null;
+}
+
+function readNames(value: unknown, started: boolean): readonly string[] | null {
+  if (!Array.isArray(value) || !isPlayerCount(value.length)) return null;
+  const names = value.filter((name) => typeof name === 'string');
+  if (names.length !== value.length || !names.every((name) => name === normalizeName(name)))
+    return null;
+  return !started || checkNames(names).ok ? names : null;
+}
+
+// Matches are played in order, so a match has results only after every earlier match is complete.
+function isPlayedInOrder(tournament: Tournament): boolean {
+  const turn = nextTurn(tournament);
+  const open = turn ? turn.match : tournament.matches.length;
+  return tournament.matches.every((match, index) => index <= open || match.results.length === 0);
+}
+
+export function parseTournament(value: unknown): Tournament | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, ROOT_KEYS)) return null;
+  if (value.format !== TOURNAMENT_FORMAT || value.version !== TOURNAMENT_VERSION) return null;
+  if (!Array.isArray(value.matches)) return null;
+  const started = value.matches.length > 0;
+  const players = readNames(value.players, started);
+  if (!players) return null;
+  if (!started) return { players, matches: [] };
+  if (value.matches.length !== matchCount(players.length)) return null;
+  const read = value.matches.map((match, index) => readMatch(match, players.length, index));
+  const matches = read.filter((match) => match !== null);
+  if (matches.length !== read.length) return null;
+  if (new Set(matches.map((match) => match.boardCode)).size !== matches.length) return null;
+  const tournament = { players, matches };
+  return hasStarted(tournament) && isPlayedInOrder(tournament) ? tournament : null;
+}
+
+export function decodeTournament(text: string): TournamentDecoding {
+  const invalid = { ok: false, notice: TournamentNotice.invalid } as const;
+  const value = isWithinBytes(text, TOURNAMENT_MAX_BYTES) ? parseJson(text) : undefined;
+  if (!isJsonObject(value)) return invalid;
+  const field = firstUnknownField(value);
+  if (field !== null) return { ok: false, notice: `Unknown field: ${field}.` };
+  const tournament = parseTournament(value);
+  return tournament ? { ok: true, tournament } : invalid;
+}
diff --git a/src/game/tournament/names.test.ts b/src/game/tournament/names.test.ts
new file mode 100644
index 0000000..c339533
--- /dev/null
+++ b/src/game/tournament/names.test.ts
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { checkNames, hasRepeatedName, isValidNameLength, normalizeName } from './names.ts';
+
+test('a name is trimmed, collapsed to single spaces and composed', () => {
+  assert.equal(normalizeName('  Mira  '), 'Mira');
+  assert.equal(normalizeName('Ada   Lovelace'), 'Ada Lovelace');
+  assert.equal(normalizeName('Jean Luc'), 'Jean Luc');
+  assert.equal(normalizeName("O'Neil"), "O'Neil");
+  assert.equal(normalizeName('Café'), 'Café');
+});
+
+test('normalizing an accepted name again changes nothing', () => {
+  for (const draft of ['  Ada \t Lovelace ', 'Café  au  lait', ' Mira '])
+    assert.equal(normalizeName(normalizeName(draft)), normalizeName(draft));
+});
+
+test('a name has two to twenty code points', () => {
+  assert.equal(isValidNameLength(''), false);
+  assert.equal(isValidNameLength('A'), false);
+  assert.equal(isValidNameLength('Al'), true);
+  assert.equal(isValidNameLength('A\u{1f600}'), true);
+  assert.equal(isValidNameLength('a'.repeat(20)), true);
+  assert.equal(isValidNameLength('a'.repeat(21)), false);
+  assert.equal(isValidNameLength('\u{1f600}'.repeat(20)), true);
+  assert.equal(isValidNameLength('\u{1f600}'.repeat(21)), false);
+});
+
+test('the length is counted after the name is processed', () => {
+  assert.deepEqual(checkNames(['  Al  ', 'Bo', 'Cy', 'Di']), {
+    ok: true,
+    names: ['Al', 'Bo', 'Cy', 'Di'],
+  });
+  assert.deepEqual(checkNames([' A ', 'Bo', 'Cy', 'Di']), {
+    ok: false,
+    notice: 'Use 2 to 20 characters.',
+  });
+});
+
+test('names compare without regard to case and keep the spelling that was typed', () => {
+  assert.equal(hasRepeatedName(['Mira', 'mira']), true);
+  assert.equal(hasRepeatedName(['Mira', 'MIRA']), true);
+  assert.equal(hasRepeatedName(['Mira', 'Mirabel']), false);
+  assert.deepEqual(checkNames(['Mira', 'Bo', 'Cy', 'mira']), {
+    ok: false,
+    notice: 'Each name must be different.',
+  });
+  assert.deepEqual(checkNames(['Ada  Lovelace', 'Bo', 'Cy', 'ada lovelace']), {
+    ok: false,
+    notice: 'Each name must be different.',
+  });
+  assert.deepEqual(checkNames(['Mira', 'Bo', 'Cy', 'Di']), {
+    ok: true,
+    names: ['Mira', 'Bo', 'Cy', 'Di'],
+  });
+});

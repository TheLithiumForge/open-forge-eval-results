--- /dev/null
+++ b/src/game/tournament/Tournament.tsx
@@ -0,0 +1,96 @@
+import { useEffect, useRef, useState } from 'react';
+import { ExchangePanel } from './ExchangePanel.tsx';
+import { Screen } from './flow.ts';
+import { LeaveDialog } from './LeaveDialog.tsx';
+import { PastTournaments } from './PastTournaments.tsx';
+import { SetupForm } from './SetupForm.tsx';
+import { TournamentControl } from './tournament-labels.ts';
+import { TurnPanel } from './TurnPanel.tsx';
+import { useTournament } from './use-tournament.ts';
+import type { ReactNode } from 'react';
+import type { RecordTournament } from './use-saved-tournaments.ts';
+import type { SavedTournaments } from './storage.ts';
+import '../controls/control.css';
+import './tournament.css';
+
+export interface LiveResult {
+  feedback: string;
+  announcement: number;
+  now: string;
+}
+
+interface TournamentProps {
+  saved: SavedTournaments;
+  record: RecordTournament;
+  // Draws the game's one live region, which this screen shows below its heading.
+  result(live: LiveResult): ReactNode;
+  back(): void;
+}
+
+// Replaces the game screen and exists only while it is shown, so its clock and its tournament end
+// with it. Focus lands on the heading when the screen opens or is replaced.
+export function Tournament({ saved, record, result, back }: TournamentProps) {
+  const controller = useTournament(record);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const [landing, setLanding] = useState(0);
+  const [leaving, setLeaving] = useState(false);
+  useEffect(() => {
+    heading.current?.focus();
+  }, [landing]);
+  const { screen, state, round, now } = controller;
+  const land = () => setLanding((value) => value + 1);
+  return (
+    <section className="tournament" aria-labelledby="tournament-heading">
+      <h2 id="tournament-heading" ref={heading} tabIndex={-1}>
+        {TournamentControl.heading}
+      </h2>
+      {round && <p className="round">{`Round: ${round}`}</p>}
+      {result({
+        feedback: state.session.feedback,
+        announcement: state.session.announcement,
+        now,
+      })}
+      {screen === Screen.setup ? (
+        <SetupForm
+          count={state.count}
+          drafts={state.drafts}
+          setCount={controller.setCount}
+          setName={controller.setName}
+          start={controller.start}
+          started={land}
+        />
+      ) : (
+        <TurnPanel
+          controller={controller}
+          saved={saved}
+          askLeave={() => setLeaving(true)}
+          back={back}
+        />
+      )}
+      <ExchangePanel
+        exportTournament={controller.exportTournament}
+        loadTournament={controller.loadTournament}
+      />
+      {screen === Screen.setup && (
+        <>
+          <PastTournaments saved={saved} />
+          <div className="tournament-row">
+            <button type="button" className="control" onClick={back}>
+              {TournamentControl.back}
+            </button>
+          </div>
+        </>
+      )}
+      {leaving && (
+        <LeaveDialog
+          keepPlaying={() => setLeaving(false)}
+          leave={() => {
+            setLeaving(false);
+            controller.leave();
+            land();
+          }}
+        />
+      )}
+    </section>
+  );
+}
diff --git a/src/game/tournament/TurnPanel.tsx b/src/game/tournament/TurnPanel.tsx
new file mode 100644
index 0000000..041afa6
--- /dev/null
+++ b/src/game/tournament/TurnPanel.tsx
@@ -0,0 +1,105 @@
+import { useEffect, useRef } from 'react';
+import { Board } from '../board/Board.tsx';
+import { BoardHelp } from '../board/BoardHelp.tsx';
+import { GameStatus } from '../status/GameStatus.tsx';
+import { Bracket } from './Bracket.tsx';
+import { Screen, TurnPhase } from './flow.ts';
+import { championOf, nameOf } from './rules.ts';
+import { TournamentControl } from './tournament-labels.ts';
+import { TournamentStorageNotice } from './storage.ts';
+import type { BoardFocus } from '../board/Board.tsx';
+import type { SavedTournaments } from './storage.ts';
+import type { TournamentController } from './use-tournament.ts';
+import '../controls/control.css';
+import './tournament.css';
+
+interface TurnPanelProps {
+  controller: TournamentController;
+  saved: SavedTournaments;
+  askLeave(): void;
+  back(): void;
+}
+
+// A match is two turns on one deal. Each turn is a game of its own, started with Start turn.
+export function TurnPanel({ controller, saved, askLeave, back }: TurnPanelProps) {
+  const { state, screen } = controller;
+  const { session, tournament, phase, active } = state;
+  const board = useRef<BoardFocus>(null);
+  const startButton = useRef<HTMLButtonElement>(null);
+  const advanced = useRef(false);
+  const playing = phase === TurnPhase.playing;
+  // The board starts with its remembered card focused, because Start turn leaves with its button.
+  useEffect(() => {
+    if (playing) board.current?.focusRemembered();
+  }, [playing, session.generation]);
+  // The next Start turn takes focus from the Next button that just went away.
+  useEffect(() => {
+    if (advanced.current && phase === TurnPhase.idle) startButton.current?.focus();
+    advanced.current = false;
+  }, [phase]);
+  if (!tournament) return null;
+  const finished = screen === Screen.finished;
+  const nextLabel = active?.seat === 1 ? TournamentControl.nextMatch : TournamentControl.nextTurn;
+  const champion = nameOf(tournament, championOf(tournament));
+  return (
+    <>
+      {finished ? (
+        <>
+          <p className="champion">{`Champion: ${champion}`}</p>
+          {!saved.available && <p className="storage-notice">{TournamentStorageNotice}</p>}
+        </>
+      ) : null}
+      <div className="tournament-row">
+        {phase === TurnPhase.idle && !finished && (
+          <button
+            ref={startButton}
+            type="button"
+            className="control"
+            onClick={controller.startTurn}
+          >
+            {TournamentControl.startTurn}
+          </button>
+        )}
+        {phase === TurnPhase.done && !finished && (
+          <button
+            type="button"
+            className="control"
+            onClick={() => {
+              advanced.current = true;
+              controller.nextPlayer();
+            }}
+          >
+            {nextLabel}
+          </button>
+        )}
+        {finished ? (
+          <button type="button" className="control" onClick={back}>
+            {TournamentControl.back}
+          </button>
+        ) : (
+          <button type="button" className="control" onClick={askLeave}>
+            {TournamentControl.leave}
+          </button>
+        )}
+      </div>
+      {phase !== TurnPhase.idle && (
+        <>
+          <GameStatus
+            game={session.game}
+            best={undefined}
+            celebration={session.celebration}
+            showBest={false}
+          />
+          <BoardHelp />
+          <Board
+            key={session.generation}
+            game={session.game}
+            activate={controller.activate}
+            ref={board}
+          />
+        </>
+      )}
+      <Bracket tournament={tournament} />
+    </>
+  );
+}
diff --git a/src/game/tournament/deals.test.ts b/src/game/tournament/deals.test.ts

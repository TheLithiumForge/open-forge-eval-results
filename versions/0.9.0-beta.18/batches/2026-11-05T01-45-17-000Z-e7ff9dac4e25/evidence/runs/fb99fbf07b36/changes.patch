+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { checkNames, countCharacters, isNameLength, NameError, normalizeName } from './names.ts';
+
+test('a name is trimmed, collapsed and composed', () => {
+  assert.equal(normalizeName('  Mira  '), 'Mira');
+  assert.equal(normalizeName('Ada   Lovelace'), 'Ada Lovelace');
+  assert.equal(normalizeName('Jean Luc'), 'Jean Luc');
+  assert.equal(normalizeName("O'Neil"), "O'Neil");
+  assert.equal(normalizeName('Café'), 'Café');
+  assert.equal(normalizeName(normalizeName('  A \t b ')), 'A b');
+});
+
+test('length counts code points after normalizing', () => {
+  assert.equal(countCharacters('A\u{1F600}'), 2);
+  assert.equal('A\u{1F600}'.length, 3);
+  assert.deepEqual(
+    ['', 'A', 'Al', 'A\u{1F600}', 'a'.repeat(20), 'a'.repeat(21), '\u{1F600}'.repeat(20)].map(
+      isNameLength,
+    ),
+    [false, false, true, true, true, false, true],
+  );
+});
+
+test('a name that is too short or too long blocks with its message', () => {
+  const result = checkNames(['Ada', 'B', 'Cora', 'Dev']);
+  assert.deepEqual(result, { ok: false, error: 'Use 2 to 20 characters.', fields: [1] });
+  assert.equal(NameError.length, 'Use 2 to 20 characters.');
+  const spaced = checkNames(['Ada', ' B ', 'Cora', 'x'.repeat(21)]);
+  assert.deepEqual(spaced, { ok: false, error: NameError.length, fields: [1, 3] });
+});
+
+test('the length is checked on the accepted name, not on the draft', () => {
+  const result = checkNames(['  Ada  ', 'Bo', 'Cora', 'Dev']);
+  assert.deepEqual(result, { ok: true, names: ['Ada', 'Bo', 'Cora', 'Dev'] });
+});
+
+test('a repeat in the group blocks whatever the case or spacing', () => {
+  assert.deepEqual(checkNames(['Mira', 'Bo', 'mira', 'Dev']), {
+    ok: false,
+    error: 'Each name must be different.',
+    fields: [0, 2],
+  });
+  assert.deepEqual(checkNames(['Mira', 'Bo', 'Dev', ' MIRA ']), {
+    ok: false,
+    error: NameError.duplicate,
+    fields: [0, 3],
+  });
+  assert.equal(checkNames(['Ada  Lovelace', 'Bo', 'Dev', 'ada lovelace']).ok, false);
+});
+
+test('a repeat is found when it is not next to the first entry', () => {
+  const result = checkNames(['Mira', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'MIRA']);
+  assert.deepEqual(result, { ok: false, error: NameError.duplicate, fields: [0, 7] });
+});
+
+test('different names keep the spelling that was entered', () => {
+  const result = checkNames(['Mira', 'mIRa2', 'Cora', 'Dev']);
+  assert.deepEqual(result, { ok: true, names: ['Mira', 'mIRa2', 'Cora', 'Dev'] });
+});
diff --git a/src/game/tournament/names.ts b/src/game/tournament/names.ts
new file mode 100644
index 0000000..0954cbd
--- /dev/null
+++ b/src/game/tournament/names.ts
@@ -0,0 +1,50 @@
+export const NameError = {
+  length: 'Use 2 to 20 characters.',
+  duplicate: 'Each name must be different.',
+} as const;
+const NAME_MIN = 2;
+const NAME_MAX = 20;
+
+type NameCheck =
+  | { readonly ok: true; readonly names: readonly string[] }
+  | { readonly ok: false; readonly error: string; readonly fields: readonly number[] };
+
+// An accepted name is trimmed, has each inner whitespace run collapsed to one space and is NFC.
+export function normalizeName(raw: string): string {
+  return raw.trim().replace(/\s+/g, ' ').normalize('NFC');
+}
+
+// Unicode code points, not UTF-16 units: a supplementary-plane symbol counts once.
+export function countCharacters(name: string): number {
+  return Array.from(name).length;
+}
+
+export function isNameLength(name: string): boolean {
+  const length = countCharacters(name);
+  return length >= NAME_MIN && length <= NAME_MAX;
+}
+
+// The comparison key is internal. The group keeps the spelling each person entered.
+function comparisonKey(name: string): string {
+  return name.toLowerCase().normalize('NFC');
+}
+
+// Checks every entry of one group: length first, then repeats across the whole group.
+export function checkNames(raw: readonly string[]): NameCheck {
+  const names = raw.map(normalizeName);
+  const short = names.flatMap((name, index) => (isNameLength(name) ? [] : [index]));
+  if (short.length > 0) return { ok: false, error: NameError.length, fields: short };
+  const seen = new Map<string, number>();
+  const repeated = new Set<number>();
+  names.forEach((name, index) => {
+    const first = seen.get(comparisonKey(name));
+    if (first === undefined) seen.set(comparisonKey(name), index);
+    else {
+      repeated.add(first);
+      repeated.add(index);
+    }
+  });
+  if (repeated.size > 0)
+    return { ok: false, error: NameError.duplicate, fields: [...repeated].sort((a, b) => a - b) };
+  return { ok: true, names };
+}
diff --git a/src/game/tournament/records.test.ts b/src/game/tournament/records.test.ts
new file mode 100644
index 0000000..d3b57a3
--- /dev/null
+++ b/src/game/tournament/records.test.ts
@@ -0,0 +1,121 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  appendRecord,
+  readRecords,
+  RECORDS_BLOCKED,
+  RECORDS_MAX,
+  RECORDS_VERSION,
+  saveRecords,
+  TOURNAMENTS_KEY,
+} from './records.ts';
+import { championOf } from './rules.ts';
+import { fourPlayers, turn } from './tournament.fixture.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './types.ts';
+
+const FINISHED = fourPlayers([turn(20), turn(22), turn(21), turn(19), turn(40), turn(41)]);
+
+function memoryStore(entries = new Map<string, string>()) {
+  const writes: string[] = [];
+  const store: PreferenceStore = {
+    getItem: (key) => entries.get(key) ?? null,
+    setItem: (key, value) => {
+      writes.push(key);
+      entries.set(key, value);
+    },
+  };
+  return { store, entries, writes };
+}
+
+const DENIED: PreferenceStore = {
+  getItem: () => {
+    throw new Error('denied');
+  },
+  setItem: () => {
+    throw new Error('denied');
+  },
+};
+
+function distinct(count: number): Tournament[] {
+  return Array.from({ length: count }, (_, index) => ({
+    ...FINISHED,
+    players: ['Ada', 'Bo', 'Cora', `Dev ${index}`],
+  }));
+}
+
+test('records are stored under their own key as an object with exactly v and items', () => {
+  const { store, entries } = memoryStore();
+  assert.equal(TOURNAMENTS_KEY, 'np3:tournaments');
+  assert.equal(saveRecords(store, [FINISHED]).blocked, false);
+  const stored: unknown = JSON.parse(entries.get('np3:tournaments') ?? '');
+  assert.ok(typeof stored === 'object' && stored !== null);
+  assert.deepEqual(Object.keys(stored).sort(), ['items', 'v']);
+  assert.equal(RECORDS_VERSION, 3);
+  assert.deepEqual(stored, {
+    items: [{ matches: FINISHED.matches, players: FINISHED.players }],
+    v: 3,
+  });
+});
+
+test('finished tournaments come back after a reload in the order they were saved', () => {
+  const { store } = memoryStore();
+  const [first, second] = distinct(2);
+  assert.ok(first && second);
+  saveRecords(store, [first, second]);
+  assert.deepEqual(readRecords(store), { items: [first, second], blocked: false });
+  assert.equal(FINISHED.players[championOf(FINISHED) ?? -1], 'Ada');
+});
+
+test('a saved list keeps its newest ten and drops the oldest', () => {
+  const all = distinct(RECORDS_MAX + 2);
+  const kept = all.reduce<Tournament[]>((items, tournament) => appendRecord(items, tournament), []);
+  assert.equal(kept.length, 10);
+  assert.deepEqual(kept, all.slice(2));
+  const { store } = memoryStore();
+  saveRecords(store, kept);
+  assert.equal(readRecords(store).items.length, 10);
+});
+
+test('nothing stored reads as an empty list without a warning', () => {
+  assert.deepEqual(readRecords(memoryStore().store), { items: [], blocked: false });
+});
+
+test('a value that cannot be read is empty and stays until the next save', () => {
+  const unreadable = [
+    '{',
+    'null',
+    '[]',
+    JSON.stringify({ v: 3 }),
+    JSON.stringify({ v: 2, items: [] }),
+    JSON.stringify({ v: 3, items: [], extra: 1 }),
+    JSON.stringify({ v: 3, items: [{ players: [], matches: [] }] }),
+    JSON.stringify({ v: 3, items: [{ players: FINISHED.players, matches: [] }] }),
+  ];
+  for (const text of unreadable) {
+    const { store, writes } = memoryStore(new Map([[TOURNAMENTS_KEY, text]]));
+    assert.deepEqual(readRecords(store), { items: [], blocked: false }, text);
+    assert.deepEqual(writes, []);
+  }
+});
+
+test('one rejected record empties the whole list', () => {
+  const good = { matches: FINISHED.matches, players: FINISHED.players };
+  const text = JSON.stringify({ items: [good, { ...good, players: ['x'] }], v: 3 });
+  const { store } = memoryStore(new Map([[TOURNAMENTS_KEY, text]]));
+  assert.deepEqual(readRecords(store).items, []);
+});
+
+test('unavailable storage keeps the list in memory and says it will not be saved', () => {
+  assert.deepEqual(readRecords(null), { items: [], blocked: true });
+  assert.deepEqual(readRecords(DENIED), { items: [], blocked: true });
+  assert.deepEqual(saveRecords(null, [FINISHED]), { items: [FINISHED], blocked: true });
+  assert.deepEqual(saveRecords(DENIED, [FINISHED]), { items: [FINISHED], blocked: true });
+  assert.equal(RECORDS_BLOCKED, "Progress won't be saved on this device.");
+});
+
+test('saving leaves other keys alone', () => {
+  const { store, entries } = memoryStore(new Map([['other', 'kept']]));
+  saveRecords(store, [FINISHED]);
+  assert.equal(entries.get('other'), 'kept');
+});
diff --git a/src/game/tournament/records.ts b/src/game/tournament/records.ts
new file mode 100644
index 0000000..e0ea0a0
--- /dev/null
+++ b/src/game/tournament/records.ts
@@ -0,0 +1,63 @@
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import { hasBodyKeys, readTournament, tournamentBody } from './exchange.ts';
+import { isFinished } from './rules.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './types.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+export const RECORDS_VERSION = 3;
+export const RECORDS_MAX = 10;
+export const RECORDS_BLOCKED = "Progress won't be saved on this device.";
+
+export interface SavedRecords {
+  readonly items: readonly Tournament[];
+  readonly blocked: boolean;
+}
+
+function readItem(value: unknown): Tournament | undefined {
+  if (!isJsonObject(value) || !hasBodyKeys(value)) return undefined;
+  const tournament = readTournament(value);
+  return tournament && isFinished(tournament) ? tournament : undefined;
+}
+
+// Finished tournaments in the order they were saved, oldest first. A value that can't be read is
+// treated as empty without being removed: it stays until the next save replaces it.
+export function readRecords(store: PreferenceStore | null): SavedRecords {
+  let text: string | null | undefined;
+  try {
+    text = store?.getItem(TOURNAMENTS_KEY);
+  } catch {
+    return { items: [], blocked: true };
+  }
+  if (store === null) return { items: [], blocked: true };
+  const value = text ? parseJson(text) : undefined;
+  if (!isJsonObject(value) || !hasExactKeys(value, ['v', 'items']))
+    return { items: [], blocked: false };
+  if (value.v !== RECORDS_VERSION || !Array.isArray(value.items))
+    return { items: [], blocked: false };
+  const items = value.items.map(readItem);
+  const read = items.filter((item): item is Tournament => item !== undefined);
+  return { items: read.length === items.length ? read : [], blocked: false };
+}
+
+// A saved list keeps its newest records and drops older ones when a new record is saved.
+export function appendRecord(items: readonly Tournament[], tournament: Tournament): Tournament[] {
+  return [...items, tournament].slice(-RECORDS_MAX);
+}
+
+// Saves the list and reports whether the browser took it. The list stays in memory either way.
+export function saveRecords(
+  store: PreferenceStore | null,
+  items: readonly Tournament[],
+): SavedRecords {
+  try {
+    if (!store) return { items, blocked: true };
+    store.setItem(
+      TOURNAMENTS_KEY,
+      JSON.stringify({ items: items.map(tournamentBody), v: RECORDS_VERSION }),
+    );
+    return { items, blocked: false };
+  } catch {
+    return { items, blocked: true };
+  }
+}

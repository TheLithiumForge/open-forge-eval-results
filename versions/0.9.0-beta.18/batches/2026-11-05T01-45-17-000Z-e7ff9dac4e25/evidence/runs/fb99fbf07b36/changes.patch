+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { fourPlayers, turn } from './tournament.fixture.ts';
+import { TurnPhase, turnView } from './view.ts';
+
+test('before a tournament starts there is no turn owner or round', () => {
+  assert.deepEqual(turnView(undefined, false, false), {
+    phase: TurnPhase.setup,
+    owner: '',
+    round: '',
+    match: undefined,
+    second: false,
+  });
+});
+
+test('a turn waits for Start turn, then plays, then ends on the same player', () => {
+  const start = fourPlayers();
+  const ready = turnView(start, false, false);
+  assert.deepEqual(
+    [ready.phase, ready.owner, ready.round],
+    ['ready', 'Now playing: Ada', 'Round: Semifinal'],
+  );
+  assert.equal(turnView(start, true, false).phase, TurnPhase.playing);
+  const after = fourPlayers([turn(20)]);
+  const done = turnView(after, true, true);
+  assert.deepEqual([done.phase, done.owner, done.second], ['done', 'Now playing: Ada', false]);
+  const next = turnView(after, false, false);
+  assert.deepEqual([next.phase, next.owner], ['ready', 'Now playing: Dev']);
+});
+
+test('the second player of a match ends on the offer of the next match', () => {
+  const view = turnView(fourPlayers([turn(20), turn(22)]), true, true);
+  assert.deepEqual([view.phase, view.owner, view.second], ['done', 'Now playing: Dev', true]);
+  const later = turnView(fourPlayers([turn(20), turn(22)]), false, false);
+  assert.deepEqual([later.owner, later.round], ['Now playing: Bo', 'Round: Semifinal']);
+});
+
+test('the final is named once the semifinals are done', () => {
+  const view = turnView(fourPlayers([turn(20), turn(22), turn(21), turn(19)]), false, false);
+  assert.deepEqual([view.owner, view.round], ['Now playing: Ada', 'Round: Final']);
+});
+
+test('a finished tournament names its champion and no round', () => {
+  const view = turnView(
+    fourPlayers([turn(20), turn(22), turn(21), turn(19), turn(40), turn(41)]),
+    true,
+    true,
+  );
+  assert.deepEqual([view.phase, view.owner, view.round], ['complete', 'Champion: Ada', '']);
+});
diff --git a/src/game/tournament/view.ts b/src/game/tournament/view.ts
new file mode 100644
index 0000000..835a47e
--- /dev/null
+++ b/src/game/tournament/view.ts
@@ -0,0 +1,61 @@
+import { championOf, recordedTurns, roundOf, isFinished, turnAt } from './rules.ts';
+import type { Tournament } from './types.ts';
+
+export const TurnPhase = {
+  setup: 'setup',
+  ready: 'ready',
+  playing: 'playing',
+  done: 'done',
+  complete: 'complete',
+} as const;
+type TurnPhaseName = (typeof TurnPhase)[keyof typeof TurnPhase];
+
+const TurnText = { playing: 'Now playing', champion: 'Champion', round: 'Round' } as const;
+
+interface TurnView {
+  readonly phase: TurnPhaseName;
+  // "Now playing: NAME", or "Champion: NAME" at the end. Empty before a tournament starts.
+  readonly owner: string;
+  // "Round: NAME" for the round being played. Empty when no round is in play.
+  readonly round: string;
+  // The turn on screen: the next one to play, or the one that just ended.
+  readonly match: number | undefined;
+  // True when the turn on screen is the second player of its match.
+  readonly second: boolean;
+}
+
+const SETUP: TurnView = {
+  phase: TurnPhase.setup,
+  owner: '',
+  round: '',
+  match: undefined,
+  second: false,
+};
+
+// `active` says a game exists for the turn on screen. `won` says that game is complete.
+export function turnView(
+  tournament: Tournament | undefined,
+  active: boolean,
+  won: boolean,
+): TurnView {
+  if (!tournament) return SETUP;
+  const recorded = recordedTurns(tournament);
+  if (isFinished(tournament)) {
+    const champion = championOf(tournament);
+    const name = champion === undefined ? '' : (tournament.players[champion] ?? '');
+    return { ...SETUP, phase: TurnPhase.complete, owner: `${TurnText.champion}: ${name}` };
+  }
+  const ended = active && won;
+  const turn = turnAt(tournament, ended ? recorded - 1 : recorded);
+  if (!turn) return SETUP;
+  const phase = ended ? TurnPhase.done : active ? TurnPhase.playing : TurnPhase.ready;
+  const name = tournament.players[turn.player] ?? '';
+  const round = roundOf(tournament.players.length, turn.match);
+  return {
+    phase,
+    owner: `${TurnText.playing}: ${name}`,
+    round: `${TurnText.round}: ${round}`,
+    match: turn.match,
+    second: turn.second,
+  };
+}

new file mode 100644
index 0000000..983abe3
--- /dev/null
+++ b/src/game/tournament/tournament.fixture.ts
@@ -0,0 +1,29 @@
+import { boardCode } from '../deck.ts';
+import { createTournament, recordTurn } from './tournament.ts';
+import type { Tournament, TurnResult } from './tournament.ts';
+
+export const FOUR_PLAYERS = ['Ann', 'Ben', 'Cy', 'Dee'];
+export const EIGHT_PLAYERS = [...FOUR_PLAYERS, 'Eve', 'Fay', 'Gus', 'Hal'];
+
+// Each match has its own 4x4 deal.
+export function dealCodes(count: number): string[] {
+  return Array.from({ length: count }, (_, index) => boardCode(4, index + 1));
+}
+
+export function newTournament(players: readonly string[]): Tournament {
+  return createTournament(players, dealCodes(players.length - 1));
+}
+
+export function turn(moves: number, elapsedMs = 1000): TurnResult {
+  return { moves, elapsedMs };
+}
+
+export function playTurns(tournament: Tournament, results: readonly TurnResult[]): Tournament {
+  return results.reduce(recordTurn, tournament);
+}
+
+// Every match goes to its first player, who needs 8 moves against 9.
+export function firstPlayersWin(tournament: Tournament): Tournament {
+  const turns = tournament.matches.flatMap(() => [turn(8), turn(9)]);
+  return playTurns(tournament, turns);
+}
diff --git a/src/game/tournament/tournament.test.ts b/src/game/tournament/tournament.test.ts
new file mode 100644
index 0000000..643f43f
--- /dev/null
+++ b/src/game/tournament/tournament.test.ts
@@ -0,0 +1,147 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  champion,
+  createTournament,
+  gridSize,
+  isFinished,
+  isPlayerCount,
+  matchPlayers,
+  matchTitle,
+  matchWinner,
+  PLAYER_COUNTS,
+  recordTurn,
+  roundMatches,
+  roundName,
+  turnAt,
+  turnsPlayed,
+} from './tournament.ts';
+import {
+  dealCodes,
+  EIGHT_PLAYERS,
+  FOUR_PLAYERS,
+  firstPlayersWin,
+  newTournament,
+  playTurns,
+  turn,
+} from './tournament.fixture.ts';
+
+test('four and eight are the only player counts', () => {
+  assert.deepEqual(PLAYER_COUNTS, [4, 8]);
+  for (const count of [0, 1, 2, 3, 5, 6, 7, 9, 16]) assert.equal(isPlayerCount(count), false);
+  for (const count of PLAYER_COUNTS) assert.equal(isPlayerCount(count), true);
+});
+
+test('a tournament needs one deal for each of its matches', () => {
+  assert.throws(() => createTournament(['Ann', 'Ben'], dealCodes(1)));
+  assert.throws(() => createTournament(FOUR_PLAYERS, dealCodes(4)));
+  assert.throws(() => createTournament(EIGHT_PLAYERS, dealCodes(3)));
+  assert.equal(newTournament(FOUR_PLAYERS).matches.length, 3);
+  assert.equal(newTournament(EIGHT_PLAYERS).matches.length, 7);
+});
+
+test('rounds run from the first matches to the final and carry their names', () => {
+  assert.deepEqual(roundMatches(4), [[0, 1], [2]]);
+  assert.deepEqual(roundMatches(8), [[0, 1, 2, 3], [4, 5], [6]]);
+  assert.deepEqual(
+    [0, 1].map((round) => roundName(4, round)),
+    ['Semifinal', 'Final'],
+  );
+  assert.deepEqual(
+    [0, 1, 2].map((round) => roundName(8, round)),
+    ['Quarterfinal', 'Semifinal', 'Final'],
+  );
+  assert.deepEqual(
+    [0, 1, 2].map((match) => matchTitle(4, match)),
+    ['Semifinal 1', 'Semifinal 2', 'Final'],
+  );
+  assert.equal(matchTitle(8, 3), 'Quarterfinal 4');
+  assert.equal(matchTitle(8, 5), 'Semifinal 2');
+  assert.equal(matchTitle(8, 6), 'Final');
+});
+
+test('the first round pairs players in the order they were listed', () => {
+  const tournament = newTournament(EIGHT_PLAYERS);
+  assert.deepEqual(matchPlayers(tournament, 0), ['Ann', 'Ben']);
+  assert.deepEqual(matchPlayers(tournament, 3), ['Gus', 'Hal']);
+  assert.deepEqual(matchPlayers(tournament, 4), [null, null]);
+  assert.equal(gridSize(tournament), 4);
+});
+
+test('fewer moves win a match, then less time, then the player listed first', () => {
+  const fewerMoves = playTurns(newTournament(FOUR_PLAYERS), [turn(12, 1000), turn(9, 90_000)]);
+  assert.equal(matchWinner(fewerMoves, 0), 'Ben');
+  const firstFewer = playTurns(newTournament(FOUR_PLAYERS), [turn(9, 90_000), turn(12, 1000)]);
+  assert.equal(matchWinner(firstFewer, 0), 'Ann');
+  const shorter = playTurns(newTournament(FOUR_PLAYERS), [turn(10, 5000), turn(10, 4999)]);
+  assert.equal(matchWinner(shorter, 0), 'Ben');
+  const tied = playTurns(newTournament(FOUR_PLAYERS), [turn(10, 5000), turn(10, 5000)]);
+  assert.equal(matchWinner(tied, 0), 'Ann');
+});
+
+test('a match has no winner until both players have played', () => {
+  const tournament = newTournament(FOUR_PLAYERS);
+  assert.equal(matchWinner(tournament, 0), null);
+  assert.equal(matchWinner(recordTurn(tournament, turn(8)), 0), null);
+  assert.equal(matchWinner(tournament, 99), null);
+});
+
+test('turns run through every match in order and the last one decides the champion', () => {
+  let tournament = newTournament(FOUR_PLAYERS);
+  const order: (string | undefined)[] = [];
+  for (let index = 0; index < 6; index += 1) {
+    const info = turnAt(tournament, index);
+    order.push(info?.player);
+    assert.equal(info?.match, Math.floor(index / 2));
+    assert.equal(info?.boardCode, tournament.matches[Math.floor(index / 2)]?.boardCode);
+    assert.equal(turnsPlayed(tournament), index);
+    assert.equal(isFinished(tournament), false);
+    assert.equal(champion(tournament), null);
+    // Ann, Cy and the winners of the first round each need 8 moves against 9.
+    tournament = recordTurn(tournament, turn(index % 2 === 0 ? 8 : 9));
+  }
+  // The final pairs the winners of both semifinals, which are Ann and Cy.
+  assert.deepEqual(order, ['Ann', 'Ben', 'Cy', 'Dee', 'Ann', 'Cy']);
+  assert.equal(isFinished(tournament), true);
+  assert.equal(champion(tournament), 'Ann');
+  assert.equal(turnAt(tournament, 6), null);
+  assert.equal(turnAt(tournament, -1), null);
+  assert.equal(recordTurn(tournament, turn(8)), tournament);
+});
+
+test('winners move up through all three rounds of an eight player tournament', () => {
+  const tournament = newTournament(EIGHT_PLAYERS);
+  const results = [
+    // Quarterfinals: Ben, Cy, Fay and Hal win.
+    [10, 9],
+    [8, 9],
+    [11, 7],
+    [12, 6],
+    // Semifinals: Ben against Cy and Fay against Hal.
+    [9, 9],
+    [5, 6],
+    // Final: Ben against Fay.
+    [8, 7],
+  ].flat();
+  const played = playTurns(
+    tournament,
+    results.map((moves, index) => turn(moves, index)),
+  );
+  assert.equal(turnsPlayed(played), 14);
+  assert.deepEqual(matchPlayers(played, 4), ['Ben', 'Cy']);
+  assert.deepEqual(matchPlayers(played, 5), ['Fay', 'Hal']);
+  assert.deepEqual(matchPlayers(played, 6), ['Ben', 'Fay']);
+  assert.equal(champion(played), 'Fay');
+});
+
+test('recording a turn leaves the earlier tournament as it was', () => {
+  const tournament = newTournament(FOUR_PLAYERS);
+  const next = recordTurn(tournament, turn(8));
+  assert.equal(turnsPlayed(tournament), 0);
+  assert.equal(turnsPlayed(next), 1);
+  assert.deepEqual(next.matches[0]?.turns, [turn(8)]);
+  assert.equal(
+    firstPlayersWin(tournament).matches.every((match) => match.turns.length === 2),
+    true,
+  );
+});
diff --git a/src/game/tournament/tournament.ts b/src/game/tournament/tournament.ts
new file mode 100644
index 0000000..03ad3a8
--- /dev/null
+++ b/src/game/tournament/tournament.ts
@@ -0,0 +1,128 @@
+import { parseBoardCode } from '../deck.ts';
+
+export const PLAYER_COUNTS = [4, 8] as const;
+
+// Round names count back from the final, so four players start at the semifinals.
+const ROUND_NAMES = ['Quarterfinal', 'Semifinal', 'Final'] as const;
+
+export interface TurnResult {
+  readonly moves: number;
+  readonly elapsedMs: number;
+}
+
+export interface MatchRecord {
+  readonly boardCode: string;
+  readonly turns: readonly TurnResult[];
+}
+
+// A tournament is only its players, in bracket order, and the matches played so far. Every match
+// has its own deal. Its two players play that deal one after the other and winners follow from
+// the results, so nothing here can disagree with them.
+export interface Tournament {
+  readonly players: readonly string[];
+  readonly matches: readonly MatchRecord[];
+}
+
+export interface TurnInfo {
+  readonly match: number;
+  readonly player: string;
+  readonly boardCode: string;
+}
+
+// Every match of a tournament is dealt on the same grid.
+export function gridSize(tournament: Tournament): number {
+  return parseBoardCode(tournament.matches[0]?.boardCode ?? '')?.size ?? 0;
+}
+
+export function isPlayerCount(value: number): boolean {
+  return PLAYER_COUNTS.some((count) => count === value);
+}
+
+export function createTournament(
+  players: readonly string[],
+  boardCodes: readonly string[],
+): Tournament {
+  if (!isPlayerCount(players.length) || boardCodes.length !== players.length - 1)
+    throw new Error('A tournament needs 4 or 8 players and one deal for each match.');
+  return { players, matches: boardCodes.map((boardCode) => ({ boardCode, turns: [] })) };
+}
+
+// Matches are numbered round by round. Match 0 pairs the first two players and the last match is
+// the final.
+export function roundMatches(playerCount: number): readonly (readonly number[])[] {
+  const rounds: (readonly number[])[] = [];
+  let first = 0;
+  for (let count = playerCount / 2; count >= 1; count /= 2) {
+    const start = first;
+    rounds.push(Array.from({ length: count }, (_, position) => start + position));
+    first += count;
+  }
+  return rounds;
+}
+
+export function roundName(playerCount: number, round: number): string {
+  const rounds = roundMatches(playerCount).length;
+  return ROUND_NAMES[ROUND_NAMES.length - rounds + round] ?? 'Match';
+}
+
+export function matchTitle(playerCount: number, match: number): string {
+  const rounds = roundMatches(playerCount);
+  const round = rounds.findIndex((matches) => matches.includes(match));
+  const matches = rounds[round] ?? [];
+  const name = roundName(playerCount, round);
+  return matches.length === 1 ? name : `${name} ${matches.indexOf(match) + 1}`;
+}
+
+// Fewer moves win and less time settles a tie. A tie on both goes to the player listed first.
+function isAhead(turn: TurnResult, other: TurnResult): boolean {
+  return turn.moves === other.moves ? turn.elapsedMs < other.elapsedMs : turn.moves < other.moves;
+}
+
+export function matchPlayers(
+  tournament: Tournament,
+  match: number,
+): readonly [string | null, string | null] {
+  const firstRound = tournament.players.length / 2;
+  if (match < firstRound)
+    return [tournament.players[2 * match] ?? null, tournament.players[2 * match + 1] ?? null];
+  const feeder = 2 * (match - firstRound);
+  return [matchWinner(tournament, feeder), matchWinner(tournament, feeder + 1)];
+}
+
+export function matchWinner(tournament: Tournament, match: number): string | null {
+  const [first, second] = tournament.matches[match]?.turns ?? [];
+  if (!first || !second) return null;
+  const [left, right] = matchPlayers(tournament, match);
+  return isAhead(second, first) ? right : left;
+}
+
+export function turnsPlayed(tournament: Tournament): number {
+  return tournament.matches.reduce((total, match) => total + match.turns.length, 0);
+}
+
+export function isFinished(tournament: Tournament): boolean {
+  return turnsPlayed(tournament) === 2 * tournament.matches.length;
+}
+
+export function champion(tournament: Tournament): string | null {
+  return isFinished(tournament) ? matchWinner(tournament, tournament.matches.length - 1) : null;
+}
+
+// Turns run in order, two for each match. Turn 0 belongs to the first player of match 0.
+export function turnAt(tournament: Tournament, turn: number): TurnInfo | null {
+  const match = Math.floor(turn / 2);
+  const record = tournament.matches[match];
+  const player = matchPlayers(tournament, match)[turn % 2];
+  return record && player ? { match, player, boardCode: record.boardCode } : null;
+}
+
+export function recordTurn(tournament: Tournament, result: TurnResult): Tournament {
+  const match = Math.floor(turnsPlayed(tournament) / 2);
+  if (!tournament.matches[match]) return tournament;
+  return {
+    ...tournament,
+    matches: tournament.matches.map((record, position) =>
+      position === match ? { ...record, turns: [...record.turns, result] } : record,
+    ),
+  };
+}

@@ -0,0 +1,98 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  finishTurn,
+  idleSession,
+  NextStep,
+  nextStep,
+  nextTurn,
+  openSession,
+  shownTurn,
+  startTurn,
+  TurnPhase,
+} from './tournament-session.ts';
+import { champion, isFinished, turnsPlayed } from './tournament.ts';
+import { FOUR_PLAYERS, firstPlayersWin, newTournament, turn } from './tournament.fixture.ts';
+
+test('a new tournament waits for its first player to start', () => {
+  const session = openSession(newTournament(FOUR_PLAYERS), 'Hello.');
+  assert.equal(session.phase, TurnPhase.ready);
+  assert.equal(session.notice, 'Hello.');
+  assert.equal(shownTurn(session)?.player, 'Ann');
+  assert.equal(nextStep(session), NextStep.none);
+  assert.equal(idleSession().tournament, null);
+  assert.equal(shownTurn(idleSession()), null);
+  assert.equal(nextStep(idleSession()), NextStep.none);
+});
+
+test('each game is started, finished and followed by a next turn or a next match', () => {
+  let session = openSession(newTournament(FOUR_PLAYERS));
+  const seen: string[] = [];
+  for (let game = 0; game < 6; game += 1) {
+    assert.equal(session.phase, TurnPhase.ready);
+    seen.push(`${shownTurn(session)?.player} ${session.phase}`);
+    session = startTurn(session);
+    assert.equal(session.phase, TurnPhase.playing);
+    seen.push(`${shownTurn(session)?.player} ${session.phase}`);
+    session = finishTurn(session, turn(game % 2 === 0 ? 8 : 9));
+    assert.equal(turnsPlayed(session.tournament ?? newTournament(FOUR_PLAYERS)), game + 1);
+    seen.push(`${shownTurn(session)?.player} ${session.phase} ${nextStep(session)}`);
+    if (game < 5) session = nextTurn(session);
+  }
+  assert.deepEqual(seen, [
+    'Ann ready',
+    'Ann playing',
+    'Ann done turn',
+    'Ben ready',
+    'Ben playing',
+    'Ben done match',
+    'Cy ready',
+    'Cy playing',
+    'Cy done turn',
+    'Dee ready',
+    'Dee playing',
+    'Dee done match',
+    'Ann ready',
+    'Ann playing',
+    'Ann done turn',
+    'Cy ready',
+    'Cy playing',
+    'Cy done none',
+  ]);
+  assert.equal(session.tournament ? champion(session.tournament) : null, 'Ann');
+});
+
+test('steps out of order change nothing', () => {
+  const ready = openSession(newTournament(FOUR_PLAYERS));
+  assert.equal(finishTurn(ready, turn(8)), ready);
+  assert.equal(nextTurn(ready), ready);
+  const playing = startTurn(ready);
+  assert.equal(startTurn(playing), playing);
+  assert.equal(nextTurn(playing), playing);
+  const done = finishTurn(playing, turn(8));
+  assert.equal(startTurn(done), done);
+  assert.equal(finishTurn(done, turn(8)), done);
+  const idle = idleSession();
+  assert.equal(startTurn(idle), idle);
+  assert.equal(finishTurn(idle, turn(8)), idle);
+  assert.equal(nextTurn(idle), idle);
+});
+
+test('a finished tournament opens on its result and no step goes on from it', () => {
+  const tournament = firstPlayersWin(newTournament(FOUR_PLAYERS));
+  const session = openSession(tournament);
+  assert.equal(isFinished(tournament), true);
+  assert.equal(session.phase, TurnPhase.done);
+  assert.equal(nextStep(session), NextStep.none);
+  assert.equal(startTurn(session), session);
+  assert.equal(nextTurn(session), session);
+  assert.equal(shownTurn(session)?.player, 'Cy');
+});
+
+test('an unfinished tournament that was exported resumes with its next player', () => {
+  const partial = openSession(newTournament(FOUR_PLAYERS));
+  const afterOne = finishTurn(startTurn(partial), turn(8));
+  const resumed = openSession(afterOne.tournament ?? newTournament(FOUR_PLAYERS));
+  assert.equal(resumed.phase, TurnPhase.ready);
+  assert.equal(shownTurn(resumed)?.player, 'Ben');
+});
diff --git a/src/game/tournament/tournament-session.ts b/src/game/tournament/tournament-session.ts
new file mode 100644
index 0000000..9c3d5da
--- /dev/null
+++ b/src/game/tournament/tournament-session.ts
@@ -0,0 +1,61 @@
+import { isFinished, recordTurn, turnAt, turnsPlayed } from './tournament.ts';
+import type { Tournament, TurnInfo, TurnResult } from './tournament.ts';
+
+export const TurnPhase = { ready: 'ready', playing: 'playing', done: 'done' } as const;
+type TurnPhaseKind = (typeof TurnPhase)[keyof typeof TurnPhase];
+
+export const NextStep = { turn: 'turn', match: 'match', none: 'none' } as const;
+type NextStepKind = (typeof NextStep)[keyof typeof NextStep];
+
+// Without a tournament the screen shows the setup. With one, the phase says whether the next
+// player has yet to start, is playing, or has just finished a game.
+export interface TournamentSession {
+  readonly tournament: Tournament | null;
+  readonly phase: TurnPhaseKind;
+  readonly notice: string;
+}
+
+export function idleSession(notice = ''): TournamentSession {
+  return { tournament: null, phase: TurnPhase.ready, notice };
+}
+
+// A finished tournament opens on its result. An unfinished one waits for its next player.
+export function openSession(tournament: Tournament, notice = ''): TournamentSession {
+  return { tournament, phase: isFinished(tournament) ? TurnPhase.done : TurnPhase.ready, notice };
+}
+
+export function startTurn(session: TournamentSession): TournamentSession {
+  const { tournament } = session;
+  if (!tournament || session.phase !== TurnPhase.ready || isFinished(tournament)) return session;
+  return { ...session, phase: TurnPhase.playing, notice: '' };
+}
+
+export function finishTurn(session: TournamentSession, result: TurnResult): TournamentSession {
+  const { tournament } = session;
+  if (!tournament || session.phase !== TurnPhase.playing) return session;
+  return { ...session, tournament: recordTurn(tournament, result), phase: TurnPhase.done };
+}
+
+export function nextTurn(session: TournamentSession): TournamentSession {
+  const { tournament } = session;
+  if (!tournament || session.phase !== TurnPhase.done || isFinished(tournament)) return session;
+  return { ...session, phase: TurnPhase.ready };
+}
+
+// The game on screen is the one being played or just finished. Between games it is the next one.
+export function shownTurnNumber(tournament: Tournament, phase: TurnPhaseKind): number {
+  return phase === TurnPhase.done ? turnsPlayed(tournament) - 1 : turnsPlayed(tournament);
+}
+
+export function shownTurn(session: TournamentSession): TurnInfo | null {
+  const { tournament } = session;
+  return tournament ? turnAt(tournament, shownTurnNumber(tournament, session.phase)) : null;
+}
+
+// After a game, the same match goes on with its second player, or the next match begins.
+export function nextStep(session: TournamentSession): NextStepKind {
+  const { tournament } = session;
+  if (!tournament || session.phase !== TurnPhase.done || isFinished(tournament))
+    return NextStep.none;
+  return turnsPlayed(tournament) % 2 === 0 ? NextStep.match : NextStep.turn;
+}

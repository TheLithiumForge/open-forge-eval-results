+import { useState } from 'react';
+import { TournamentControl } from './labels.ts';
+import '../controls/control.css';
+import './tournament.css';
+
+const TOURNAMENT_MAX_CHARACTERS = 65_536;
+
+interface TournamentToolsProps {
+  exportTournament(): string | null;
+  load(text: string): void;
+}
+
+// The draft stays for correction after a failed load. Outcomes go to the game's status line.
+export function TournamentTools({ exportTournament, load }: TournamentToolsProps) {
+  const [draft, setDraft] = useState('');
+  return (
+    <section className="tournament-tools">
+      <label htmlFor="tournament-json">{TournamentControl.json}</label>
+      <textarea
+        id="tournament-json"
+        className="control"
+        rows={5}
+        value={draft}
+        maxLength={TOURNAMENT_MAX_CHARACTERS}
+        spellCheck={false}
+        onChange={(event) => setDraft(event.currentTarget.value)}
+      />
+      <div className="tournament-row">
+        <button
+          type="button"
+          className="control"
+          onClick={() => {
+            const text = exportTournament();
+            if (text !== null) setDraft(text);
+          }}
+        >
+          {TournamentControl.exportTournament}
+        </button>
+        <button type="button" className="control" onClick={() => load(draft)}>
+          {TournamentControl.loadTournament}
+        </button>
+      </div>
+    </section>
+  );
+}
diff --git a/src/game/tournament/format.test.ts b/src/game/tournament/format.test.ts
new file mode 100644
index 0000000..d9bda85
--- /dev/null
+++ b/src/game/tournament/format.test.ts
@@ -0,0 +1,123 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  decodeTournament,
+  encodeTournament,
+  readTournament,
+  TOURNAMENT_FORMAT,
+  TOURNAMENT_VERSION,
+} from './format.ts';
+import { createTournament, recordResult } from './rules.ts';
+import { isJsonObject } from '../saved-format.ts';
+
+const CODES = ['np1-6-1', 'np1-6-2', 'np1-8-1'];
+const STARTED = recordResult(
+  createTournament(['Ada', 'Bo', 'Cora', 'Dev'], () => CODES.shift() ?? 'np1-8-2'),
+  { moves: 20, elapsedMs: 45_000.625 },
+);
+
+function exported(change: (value: Record<string, unknown>) => void = () => {}): string {
+  const value: unknown = JSON.parse(encodeTournament(STARTED));
+  assert.ok(isJsonObject(value));
+  const copy = { ...value };
+  change(copy);
+  return JSON.stringify(copy);
+}
+
+function keyOrders(value: unknown): string[][] {
+  if (Array.isArray(value)) return value.flatMap(keyOrders);
+  if (!value || typeof value !== 'object') return [];
+  return [Object.keys(value), ...Object.values(value).flatMap(keyOrders)];
+}
+
+test('export names its format and version with alphabetical keys at every level', () => {
+  const text = encodeTournament(STARTED);
+  const value: unknown = JSON.parse(text);
+  assert.ok(text.includes('\n  "format"') && isJsonObject(value));
+  assert.deepEqual(Object.keys(value), ['format', 'matches', 'players', 'version']);
+  for (const keys of keyOrders(value)) assert.deepEqual(keys, [...keys].sort());
+  assert.equal(TOURNAMENT_FORMAT, 'neon-pairs/tournament');
+  assert.equal(TOURNAMENT_VERSION, 1);
+  assert.deepEqual(decodeTournament(text), { tournament: STARTED });
+});
+
+test('the first field a tournament format does not define is named, in text order', () => {
+  const nested = exported((value) => {
+    value.matches = [
+      { boardCode: 'np1-6-1', results: [{ elapsedMs: 1, moves: 20, note: 'x' }], extra: 1 },
+    ];
+    value.later = true;
+  });
+  assert.deepEqual(decodeTournament(nested), { unknownField: 'note' });
+  assert.deepEqual(decodeTournament(exported((value) => (value.comment = 'hi'))), {
+    unknownField: 'comment',
+  });
+  const wrongFormat = exported((value) => {
+    value.format = 'neon-pairs/snapshot';
+    value.comment = 'hi';
+  });
+  assert.equal(decodeTournament(wrongFormat), null);
+});
+
+test('incomplete, inconsistent or out-of-range tournaments are rejected', () => {
+  const cases: ((value: Record<string, unknown>) => void)[] = [
+    (value) => delete value.players,
+    (value) => (value.version = 2),
+    (value) => (value.players = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi']),
+    (value) => (value.players = ['Ada', 'Bo', 'Cora', 'ada']),
+    (value) => (value.players = ['Ada', 'Bo', 'Cora', 'D']),
+    (value) => (value.matches = [{ boardCode: 'np1-6-1', results: [] }]),
+    (value) =>
+      (value.matches = [
+        { boardCode: 'np1-4-1', results: [] },
+        { boardCode: 'np1-6-2', results: [] },
+        { boardCode: 'np1-8-1', results: [] },
+      ]),
+    (value) =>
+      (value.matches = [
+        { boardCode: 'np1-6-1', results: [] },
+        { boardCode: 'np1-6-1', results: [] },
+        { boardCode: 'np1-8-1', results: [] },
+      ]),
+    (value) =>
+      (value.matches = [
+        { boardCode: 'np1-6-1', results: [{ elapsedMs: 1, moves: 20 }] },
+        { boardCode: 'np1-6-2', results: [{ elapsedMs: 1, moves: 20 }] },
+        { boardCode: 'np1-8-1', results: [] },
+      ]),
+    (value) =>
+      (value.matches = [
+        { boardCode: 'np1-6-1', results: [{ elapsedMs: 1, moves: 17 }] },
+        { boardCode: 'np1-6-2', results: [] },
+        { boardCode: 'np1-8-1', results: [] },
+      ]),
+    (value) =>
+      (value.matches = [
+        { boardCode: 'np1-6-1', results: [{ elapsedMs: -1, moves: 20 }] },
+        { boardCode: 'np1-6-2', results: [] },
+        { boardCode: 'np1-8-1', results: [] },
+      ]),
+    (value) =>
+      (value.matches = [
+        { boardCode: 'np1-6-1', results: [{ moves: 20 }] },
+        { boardCode: 'np1-6-2', results: [] },
+        { boardCode: 'np1-8-1', results: [] },
+      ]),
+  ];
+  assert.ok(decodeTournament(exported()));
+  for (const [index, change] of cases.entries())
+    assert.equal(decodeTournament(exported(change)), null, `case ${index}`);
+  for (const text of ['{', 'null', '[]', '"tournament"', ' '.repeat(65_537)])
+    assert.equal(decodeTournament(text), null, text.slice(0, 12));
+});
+
+test('loaded names take the accepted form and stored records carry no format fields', () => {
+  const spaced = exported((value) => (value.players = ['  Ada ', 'Bo', 'Cora', 'Dev']));
+  const decoded = decodeTournament(spaced);
+  assert.ok(decoded && 'tournament' in decoded);
+  assert.equal(decoded.tournament.players[0], 'Ada');
+  const value: unknown = JSON.parse(exported());
+  assert.ok(isJsonObject(value));
+  assert.deepEqual(readTournament({ matches: value.matches, players: value.players }), STARTED);
+  assert.equal(readTournament(value), null);
+});
diff --git a/src/game/tournament/format.ts b/src/game/tournament/format.ts
new file mode 100644
index 0000000..9a19884
--- /dev/null
+++ b/src/game/tournament/format.ts
@@ -0,0 +1,118 @@
+import { parseBoardCode } from '../deck.ts';
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import {
+  hasExactKeys,
+  isJsonObject,
+  isNonnegativeSafeInteger,
+  isWithinBytes,
+  parseJson,
+} from '../saved-format.ts';
+import { checkNames, isPlayerCount, matchSizes } from './rules.ts';
+import type { Match, Result, Tournament } from './rules.ts';
+
+export const TOURNAMENT_FORMAT = 'neon-pairs/tournament';
+export const TOURNAMENT_VERSION = 1;
+const TOURNAMENT_MAX_BYTES = 65_536;
+
+// The fields of each format object, with the shape of the objects inside its list fields.
+interface Shape {
+  readonly [field: string]: Shape | null;
+}
+const RESULT: Shape = { elapsedMs: null, moves: null };
+const MATCH: Shape = { boardCode: null, results: RESULT };
+const RECORD: Shape = { matches: MATCH, players: null };
+const EXPORT: Shape = { format: null, matches: MATCH, players: null, version: null };
+
+type Decoded = { readonly tournament: Tournament } | { readonly unknownField: string } | null;
+
+// Keys follow alphabetical order at every level. Elapsed time keeps the exact milliseconds the
+// result was compared with, so a loaded tournament decides every match the same way.
+export function tournamentRecord(tournament: Tournament) {
+  return {
+    matches: tournament.matches.map((match) => ({
+      boardCode: match.boardCode,
+      results: match.results.map((result) => ({
+        elapsedMs: result.elapsedMs,
+        moves: result.moves,
+      })),
+    })),
+    players: [...tournament.players],
+  };
+}
+
+export function encodeTournament(tournament: Tournament): string {
+  return JSON.stringify(
+    { format: TOURNAMENT_FORMAT, ...tournamentRecord(tournament), version: TOURNAMENT_VERSION },
+    null,
+    2,
+  );
+}
+
+function isStringList(value: unknown): value is readonly string[] {
+  return Array.isArray(value) && value.every((item) => typeof item === 'string');
+}
+
+function readResult(value: unknown, size: number): Result | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, Object.keys(RESULT))) return null;
+  const { moves, elapsedMs } = value;
+  if (!isNonnegativeSafeInteger(moves) || moves > MOVES_MAX || moves < size ** 2 / 2) return null;
+  if (typeof elapsedMs !== 'number' || !(elapsedMs >= 0 && elapsedMs <= ELAPSED_MAX_MS))
+    return null;
+  return { moves, elapsedMs };
+}
+
+function readMatch(value: unknown, size: number | undefined): Match | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, Object.keys(MATCH))) return null;
+  const { boardCode, results } = value;
+  if (size === undefined || typeof boardCode !== 'string') return null;
+  if (parseBoardCode(boardCode)?.size !== size) return null;
+  if (!Array.isArray(results) || results.length > 2) return null;
+  const read = results.map((result: unknown) => readResult(result, size));
+  return read.every((result): result is Result => result !== null)
+    ? { boardCode, results: read }
+    : null;
+}
+
+// Reads a whole tournament, or null. A stored record has no format or version fields.
+export function readTournament(value: unknown, shape: Shape = RECORD): Tournament | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, Object.keys(shape))) return null;
+  const { players, matches } = value;
+  if (!isStringList(players) || !isPlayerCount(players.length) || !Array.isArray(matches))
+    return null;
+  const named = checkNames(players);
+  const sizes = matchSizes(players.length);
+  if ('notice' in named || matches.length !== sizes.length) return null;
+  const read = matches.map((match: unknown, index) => readMatch(match, sizes[index]));
+  const accepted = read.filter((match) => match !== null);
+  if (accepted.length !== read.length) return null;
+  if (new Set(accepted.map((match) => match.boardCode)).size !== accepted.length) return null;
+  // Matches are played in bracket order, so nothing after the open match has a result.
+  const open = accepted.findIndex((match) => match.results.length < 2);
+  if (open >= 0 && accepted.slice(open + 1).some((match) => match.results.length > 0)) return null;
+  return { players: named.names, matches: accepted };
+}
+
+// Finds the first field the format doesn't define, in the order the text gives them.
+function unknownField(value: Readonly<Record<string, unknown>>, shape: Shape): string | null {
+  for (const [field, child] of Object.entries(value)) {
+    if (!Object.hasOwn(shape, field)) return field;
+    const inner = shape[field];
+    if (!inner || !Array.isArray(child)) continue;
+    for (const item of child) {
+      const found = isJsonObject(item) ? unknownField(item, inner) : null;
+      if (found !== null) return found;
+    }
+  }
+  return null;
+}
+
+export function decodeTournament(text: string): Decoded {
+  if (!isWithinBytes(text, TOURNAMENT_MAX_BYTES)) return null;
+  const value = parseJson(text);
+  if (!isJsonObject(value)) return null;
+  if (value.format !== TOURNAMENT_FORMAT || value.version !== TOURNAMENT_VERSION) return null;
+  const field = unknownField(value, EXPORT);
+  if (field !== null) return { unknownField: field };
+  const tournament = readTournament(value, EXPORT);
+  return tournament ? { tournament } : null;
+}

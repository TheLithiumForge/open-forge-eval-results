diff --git a/src/game/tournament/rules.test.ts b/src/game/tournament/rules.test.ts
new file mode 100644
index 0000000..0dcd7ad
--- /dev/null
+++ b/src/game/tournament/rules.test.ts
@@ -0,0 +1,169 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  acceptedName,
+  championOf,
+  checkNames,
+  createTournament,
+  currentTurn,
+  matchLabel,
+  matchPlayers,
+  matchSizes,
+  matchWinner,
+  NameNotice,
+  recordResult,
+  RoundName,
+  roundName,
+  turnPlayer,
+} from './rules.ts';
+import type { Result, Tournament } from './rules.ts';
+
+const EIGHT = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'Hal'];
+const FOUR = ['Ada', 'Bo', 'Cora', 'Dev'];
+
+// Deals every match from a counter, so each code is distinct and readable.
+function tournamentOf(players: readonly string[]): Tournament {
+  let seed = 0;
+  return createTournament(players, (size) => `np1-${size}-${(seed += 1)}`);
+}
+
+function names(tournament: Tournament, index: number): (string | undefined)[] {
+  return matchPlayers(tournament, index).map((entry) =>
+    entry === null ? undefined : tournament.players[entry],
+  );
+}
+
+function play(tournament: Tournament, results: readonly Result[]): Tournament {
+  return results.reduce(recordResult, tournament);
+}
+
+test('opening matches follow entry seeds in bracket order for both bracket sizes', () => {
+  const eight = tournamentOf(EIGHT);
+  assert.deepEqual(
+    [0, 1, 2, 3].map((index) => names(eight, index)),
+    [
+      ['Ada', 'Hal'],
+      ['Dev', 'Emi'],
+      ['Cora', 'Finn'],
+      ['Bo', 'Gia'],
+    ],
+  );
+  const four = tournamentOf(FOUR);
+  assert.deepEqual(
+    [0, 1].map((index) => names(four, index)),
+    [
+      ['Ada', 'Dev'],
+      ['Bo', 'Cora'],
+    ],
+  );
+  assert.deepEqual(names(four, 2), [undefined, undefined]);
+});
+
+test('rounds are named by stage and deal 4x4, 6x6 and 8x8 boards', () => {
+  assert.deepEqual(matchSizes(8), [4, 4, 4, 4, 6, 6, 8]);
+  assert.deepEqual(matchSizes(4), [6, 6, 8]);
+  assert.deepEqual(
+    [0, 3, 4, 6].map((index) => roundName(8, index)),
+    [RoundName.quarterfinal, 'Quarterfinal', 'Semifinal', 'Final'],
+  );
+  assert.deepEqual(
+    [0, 1, 2].map((index) => roundName(4, index)),
+    ['Semifinal', 'Semifinal', 'Final'],
+  );
+  assert.deepEqual(
+    [0, 3, 5, 6].map((index) => matchLabel(8, index)),
+    ['Quarterfinal 1', 'Quarterfinal 4', 'Semifinal 2', 'Final'],
+  );
+});
+
+test('every match gets a different board code even when a draw repeats', () => {
+  const draws = ['np1-6-5', 'np1-6-5', 'np1-6-9', 'np1-8-5'];
+  const tournament = createTournament(FOUR, () => draws.shift() ?? 'np1-8-1');
+  assert.deepEqual(
+    tournament.matches.map((match) => match.boardCode),
+    ['np1-6-5', 'np1-6-9', 'np1-8-5'],
+  );
+});
+
+test('fewer moves wins first, then less active time, then the higher seed', () => {
+  const four = tournamentOf(FOUR);
+  const byMoves = play(four, [
+    { moves: 12, elapsedMs: 70_200 },
+    { moves: 13, elapsedMs: 58_100 },
+  ]);
+  assert.equal(matchWinner(byMoves, 0), 0);
+  const byTime = play(byMoves, [
+    { moves: 15, elapsedMs: 65_900 },
+    { moves: 15, elapsedMs: 65_200 },
+  ]);
+  assert.equal(matchWinner(byTime, 1), 2);
+  const fractional = play(four, [
+    { moves: 15, elapsedMs: 65_200.7 },
+    { moves: 15, elapsedMs: 65_200.3 },
+  ]);
+  assert.equal(matchWinner(fractional, 0), 3);
+  const equal = play(four, [
+    { moves: 15, elapsedMs: 65_200 },
+    { moves: 15, elapsedMs: 65_200 },
+  ]);
+  assert.equal(matchWinner(equal, 0), 0);
+});
+
+test('a later match lists winners in bracket order and an equal result goes to the higher seed', () => {
+  const same = { moves: 18, elapsedMs: 40_000 };
+  const final = play(tournamentOf(FOUR), [
+    { moves: 20, elapsedMs: 1 },
+    { moves: 18, elapsedMs: 1 },
+    same,
+    { moves: 19, elapsedMs: 1 },
+  ]);
+  assert.deepEqual(names(final, 2), ['Dev', 'Bo']);
+  assert.equal(turnPlayer(final), 'Dev');
+  const done = play(final, [same, same]);
+  assert.equal(championOf(done), 1);
+  assert.equal(currentTurn(done), null);
+  assert.equal(recordResult(done, same), done);
+});
+
+test('turns run through each match in order until a champion is decided', () => {
+  let tournament = tournamentOf(EIGHT);
+  const order: string[] = [];
+  for (let game = 0; game < 14; game += 1) {
+    order.push(turnPlayer(tournament) ?? '');
+    tournament = recordResult(tournament, { moves: 40 - game, elapsedMs: 1000 });
+  }
+  assert.deepEqual(order.slice(0, 8), ['Ada', 'Hal', 'Dev', 'Emi', 'Cora', 'Finn', 'Bo', 'Gia']);
+  assert.deepEqual(order.slice(8), ['Hal', 'Emi', 'Finn', 'Gia', 'Emi', 'Gia']);
+  assert.equal(tournament.players[championOf(tournament) ?? -1], 'Gia');
+  assert.equal(championOf(tournamentOf(EIGHT)), null);
+});
+
+test('a typed name is trimmed, collapsed and composed before it is checked', () => {
+  assert.equal(acceptedName('  Mira  '), 'Mira');
+  assert.equal(acceptedName('Ada   Lovelace'), 'Ada Lovelace');
+  assert.equal(acceptedName('Jean\tLuc'), 'Jean Luc');
+  assert.equal(acceptedName('Café'), 'Café');
+  assert.equal(acceptedName("O'Neil"), "O'Neil");
+  assert.equal(acceptedName(acceptedName(' Ada  Lovelace ')), 'Ada Lovelace');
+});
+
+test('names need 2 to 20 code points after normalization', () => {
+  const lengthFails = (name: string) => checkNames([name, 'Other']);
+  for (const name of ['', 'A', '   A   ', 'A'.repeat(21)])
+    assert.deepEqual(lengthFails(name), { notice: NameNotice.length, index: 0 });
+  for (const name of ['Al', 'A\u{1F600}', 'A'.repeat(20), '\u{1F600}'.repeat(20), ' Al '])
+    assert.ok('names' in lengthFails(name), name);
+  assert.equal(NameNotice.length, 'Use 2 to 20 characters.');
+});
+
+test('names in one group must differ without regard to case', () => {
+  assert.deepEqual(checkNames(['Mira', 'Ada', 'Bo', 'MIRA']), {
+    notice: 'Each name must be different.',
+    index: 3,
+  });
+  assert.deepEqual(checkNames(['mira', ' Mira ']), { notice: NameNotice.repeat, index: 1 });
+  assert.deepEqual(checkNames(['Mira', 'Ada', 'Bo', 'Cora']), {
+    names: ['Mira', 'Ada', 'Bo', 'Cora'],
+  });
+  assert.deepEqual(checkNames(['Mira', 'M', 'mira']), { notice: NameNotice.length, index: 1 });
+});
diff --git a/src/game/tournament/rules.ts b/src/game/tournament/rules.ts
new file mode 100644
index 0000000..adf2ada
--- /dev/null
+++ b/src/game/tournament/rules.ts
@@ -0,0 +1,179 @@
+// Knockout rules for players sharing one device. Positions in the player list are entry order,
+// so entry position 0 is seed 1.
+export const PLAYER_COUNTS = [4, 8] as const;
+export const RoundName = {
+  quarterfinal: 'Quarterfinal',
+  semifinal: 'Semifinal',
+  final: 'Final',
+} as const;
+type Round = (typeof RoundName)[keyof typeof RoundName];
+
+const ROUND_SIZES: Readonly<Record<Round, number>> = {
+  [RoundName.quarterfinal]: 4,
+  [RoundName.semifinal]: 6,
+  [RoundName.final]: 8,
+};
+// Opening matches by entry position, in bracket order.
+const OPENING: Readonly<Record<number, readonly (readonly [number, number])[]>> = {
+  4: [
+    [0, 3],
+    [1, 2],
+  ],
+  8: [
+    [0, 7],
+    [3, 4],
+    [2, 5],
+    [1, 6],
+  ],
+};
+const NAME_MIN = 2;
+const NAME_MAX = 20;
+export const NameNotice = {
+  length: 'Use 2 to 20 characters.',
+  repeat: 'Each name must be different.',
+} as const;
+
+export interface Result {
+  readonly moves: number;
+  readonly elapsedMs: number;
+}
+export interface Match {
+  readonly boardCode: string;
+  // Results in play order. The first player listed for the match plays first.
+  readonly results: readonly Result[];
+}
+export interface Tournament {
+  readonly players: readonly string[];
+  readonly matches: readonly Match[];
+}
+type Players = readonly [number | null, number | null];
+
+export function isPlayerCount(count: number): boolean {
+  return PLAYER_COUNTS.some((option) => option === count);
+}
+
+// Each round's name, first match index and match count, from the opening round to the Final.
+function rounds(count: number) {
+  const names: readonly Round[] =
+    count === 8
+      ? [RoundName.quarterfinal, RoundName.semifinal, RoundName.final]
+      : [RoundName.semifinal, RoundName.final];
+  let first = 0;
+  return names.map((name, index) => {
+    const length = count / 2 ** (index + 1);
+    const round = { name, first, length };
+    first += length;
+    return round;
+  });
+}
+
+function roundOf(count: number, index: number) {
+  const all = rounds(count);
+  const position = all.findIndex((round) => index < round.first + round.length);
+  const round = all[position];
+  if (!round) throw new Error('Match index out of range.');
+  return { round, previous: all[position - 1] };
+}
+
+export function matchSizes(count: number): number[] {
+  return rounds(count).flatMap((round) =>
+    Array.from({ length: round.length }, () => ROUND_SIZES[round.name]),
+  );
+}
+
+export function roundName(count: number, index: number): string {
+  return roundOf(count, index).round.name;
+}
+
+// Names one match in the bracket, for example Semifinal 2. The Final needs no number.
+export function matchLabel(count: number, index: number): string {
+  const { round } = roundOf(count, index);
+  return round.length === 1 ? round.name : `${round.name} ${index - round.first + 1}`;
+}
+
+export function matchPlayers(tournament: Tournament, index: number): Players {
+  const count = tournament.players.length;
+  const { round, previous } = roundOf(count, index);
+  if (!previous) return OPENING[count]?.[index] ?? [null, null];
+  const feeder = previous.first + 2 * (index - round.first);
+  return [matchWinner(tournament, feeder), matchWinner(tournament, feeder + 1)];
+}
+
+// Fewer moves wins. Equal moves go to less active time, then to the higher seed.
+function firstWins(first: Result, second: Result, firstEntry: number, secondEntry: number) {
+  if (first.moves !== second.moves) return first.moves < second.moves;
+  if (first.elapsedMs !== second.elapsedMs) return first.elapsedMs < second.elapsedMs;
+  return firstEntry < secondEntry;
+}
+
+export function matchWinner(tournament: Tournament, index: number): number | null {
+  const [first, second] = matchPlayers(tournament, index);
+  const [firstResult, secondResult] = tournament.matches[index]?.results ?? [];
+  if (first === null || second === null || !firstResult || !secondResult) return null;
+  return firstWins(firstResult, secondResult, first, second) ? first : second;
+}
+
+export function championOf(tournament: Tournament): number | null {
+  return matchWinner(tournament, tournament.matches.length - 1);
+}
+
+// The next game to play: its match and whether the first or second player plays it.
+export function currentTurn(tournament: Tournament): { match: number; slot: number } | null {
+  const match = tournament.matches.findIndex((item) => item.results.length < 2);
+  const item = tournament.matches[match];
+  return item ? { match, slot: item.results.length } : null;
+}
+
+export function turnPlayer(tournament: Tournament): string | null {
+  const turn = currentTurn(tournament);
+  if (!turn) return null;
+  const entry = matchPlayers(tournament, turn.match)[turn.slot];
+  return entry === null || entry === undefined ? null : (tournament.players[entry] ?? null);
+}
+
+export function recordResult(tournament: Tournament, result: Result): Tournament {
+  const turn = currentTurn(tournament);
+  if (!turn) return tournament;
+  return {
+    ...tournament,
+    matches: tournament.matches.map((match, index) =>
+      index === turn.match ? { ...match, results: [...match.results, result] } : match,
+    ),
+  };
+}
+
+// Every match gets a different board code. The caller supplies fresh codes for a size.
+export function createTournament(
+  players: readonly string[],
+  draw: (size: number) => string,
+): Tournament {
+  const used = new Set<string>();
+  const matches = matchSizes(players.length).map((size) => {
+    let code = draw(size);
+    while (used.has(code)) code = draw(size);
+    used.add(code);
+    return { boardCode: code, results: [] };
+  });
+  return { players: [...players], matches };
+}
+
+// The one stored and shown form of a typed name.
+export function acceptedName(draft: string): string {
+  return draft.trim().replace(/\s+/g, ' ').normalize('NFC');
+}
+
+// Checks players in entry order and reports the first one that blocks the group.
+export function checkNames(
+  drafts: readonly string[],
+): { readonly names: readonly string[] } | { readonly notice: string; readonly index: number } {
+  const names = drafts.map(acceptedName);
+  const seen = new Set<string>();
+  for (const [index, name] of names.entries()) {
+    const length = [...name].length;
+    if (length < NAME_MIN || length > NAME_MAX) return { notice: NameNotice.length, index };
+    const key = name.toLowerCase();
+    if (seen.has(key)) return { notice: NameNotice.repeat, index };
+    seen.add(key);
+  }
+  return { names };
+}
diff --git a/src/game/tournament/storage.test.ts b/src/game/tournament/storage.test.ts
new file mode 100644
index 0000000..e57bf0b
--- /dev/null
+++ b/src/game/tournament/storage.test.ts
@@ -0,0 +1,103 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { createTournament, recordResult } from './rules.ts';
+import { readPastTournaments, saveTournament, TOURNAMENTS_KEY } from './storage.ts';
+import type { Tournament } from './rules.ts';
+
+// A finished four-player tournament whose first player wins every match.
+function finished(first: string): Tournament {
+  let seed = 0;
+  const start = createTournament([first, 'Bo', 'Cora', 'Dev'], (size) => `np1-${size}-${++seed}`);
+  return [20, 21, 20, 21, 34, 35].reduce(
+    (tournament, moves) => recordResult(tournament, { moves, elapsedMs: 1000 }),
+    start,
+  );
+}
+
+function memoryStore(initial: Record<string, string> = {}) {
+  const values = new Map(Object.entries(initial));
+  const writes: string[] = [];
+  return {
+    values,
+    writes,
+    getItem: (key: string) => values.get(key) ?? null,
+    setItem: (key: string, value: string) => {
+      writes.push(key);
+      values.set(key, value);
+    },
+  };
+}
+
+test('finished tournaments save as a v3 envelope under a namespaced key and read back', () => {
+  const store = memoryStore({ other: 'kept' });
+  const saved = saveTournament(store, readPastTournaments(store), finished('Ada'));
+  assert.equal(TOURNAMENTS_KEY, 'np3:tournaments');
+  const value: unknown = JSON.parse(store.values.get(TOURNAMENTS_KEY) ?? '');
+  assert.ok(value && typeof value === 'object');
+  assert.deepEqual(Object.keys(value), ['v', 'items']);
+  assert.equal(store.values.get('other'), 'kept');
+  assert.deepEqual(readPastTournaments(store), saved);
+  assert.deepEqual(saved, { items: [finished('Ada')], available: true });
+});
+
+test('a saved list keeps its newest 10 records, newest first', () => {
+  const store = memoryStore();
+  let past = readPastTournaments(store);
+  for (let index = 1; index <= 12; index += 1)
+    past = saveTournament(store, past, finished(`Player ${index}`));
+  const read = readPastTournaments(store);
+  assert.equal(read.items.length, 10);
+  assert.deepEqual(
+    read.items.map((tournament) => tournament.players[0]),
+    Array.from({ length: 10 }, (_, index) => `Player ${12 - index}`),
+  );
+});
+
+test('an unreadable or invalid value reads as no records and stays untouched until a save', () => {
+  const record = JSON.stringify(finished('Ada'));
+  const done = finished('Ada');
+  const unfinished = {
+    ...done,
+    matches: done.matches.map((match, index) => (index === 2 ? { ...match, results: [] } : match)),
+  };
+  for (const text of [
+    '{',
+    'null',
+    '{"v":3}',
+    '{"v":2,"items":[]}',
+    '{"v":3,"items":[],"extra":1}',
+    `{"v":3,"items":[${record}],"extra":[]}`,
+    `{"v":3,"items":[${JSON.stringify({ ...finished('Ada'), players: ['A', 'B', 'C', 'D'] })}]}`,
+    `{"v":3,"items":[${JSON.stringify(unfinished)}]}`,
+  ]) {
+    const store = memoryStore({ [TOURNAMENTS_KEY]: text });
+    assert.deepEqual(readPastTournaments(store), { items: [], available: true }, text);
+    assert.deepEqual(store.writes, []);
+    assert.equal(store.values.get(TOURNAMENTS_KEY), text);
+    saveTournament(store, readPastTournaments(store), finished('Ada'));
+    assert.notEqual(store.values.get(TOURNAMENTS_KEY), text);
+  }
+});
+
+test('blocked storage keeps records in memory and never replaces values it could not read', () => {
+  const denied = {
+    getItem: (): string | null => {
+      throw new Error('SecurityError');
+    },
+    setItem: () => assert.fail('A failed read must not lead to a write.'),
+  };
+  const blocked = saveTournament(denied, readPastTournaments(denied), finished('Ada'));
+  assert.deepEqual(blocked, { items: [finished('Ada')], available: false });
+  assert.deepEqual(saveTournament(null, readPastTournaments(null), finished('Bo')), {
+    items: [finished('Bo')],
+    available: false,
+  });
+  const full = {
+    getItem: () => null,
+    setItem: () => {
+      throw new Error('QuotaExceededError');
+    },
+  };
+  const memory = saveTournament(full, readPastTournaments(full), finished('Cora'));
+  assert.deepEqual(memory, { items: [finished('Cora')], available: false });
+});
diff --git a/src/game/tournament/storage.ts b/src/game/tournament/storage.ts

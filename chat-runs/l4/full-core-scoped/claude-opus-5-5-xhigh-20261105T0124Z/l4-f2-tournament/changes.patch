+import { useState } from 'react';
+import { isPlayerCount, PLAYER_COUNTS } from './rules.ts';
+import { playerLabel, TournamentControl } from './tournament-labels.ts';
+import '../controls/control.css';
+import './tournament.css';
+
+interface TournamentSetupProps {
+  start(drafts: readonly string[]): void;
+  back(): void;
+}
+
+const MOST_PLAYERS = Math.max(...PLAYER_COUNTS);
+
+// Drafts stay as typed. Start tournament checks them and stores the accepted names.
+export function TournamentSetup({ start, back }: TournamentSetupProps) {
+  const [count, setCount] = useState<number>(PLAYER_COUNTS[0]);
+  const [drafts, setDrafts] = useState<readonly string[]>(() =>
+    Array.from({ length: MOST_PLAYERS }, () => ''),
+  );
+  return (
+    <form
+      className="tournament-setup"
+      onSubmit={(event) => {
+        event.preventDefault();
+        start(drafts.slice(0, count));
+      }}
+    >
+      <div className="setup-count">
+        <label htmlFor="tournament-players">{TournamentControl.players}</label>
+        <select
+          id="tournament-players"
+          className="control"
+          value={count}
+          onChange={(event) => {
+            const value = Number(event.currentTarget.value);
+            if (isPlayerCount(value)) setCount(value);
+          }}
+        >
+          {PLAYER_COUNTS.map((option) => (
+            <option key={option} value={option}>
+              {option}
+            </option>
+          ))}
+        </select>
+      </div>
+      <div className="setup-names">
+        {drafts.slice(0, count).map((draft, index) => (
+          <div key={index} className="setup-name">
+            <label htmlFor={`tournament-player-${index + 1}`}>{playerLabel(index)}</label>
+            <input
+              id={`tournament-player-${index + 1}`}
+              className="control"
+              value={draft}
+              autoComplete="off"
+              spellCheck={false}
+              onChange={(event) => {
+                const value = event.currentTarget.value;
+                setDrafts((list) => list.map((item, other) => (other === index ? value : item)));
+              }}
+            />
+          </div>
+        ))}
+      </div>
+      <div className="tournament-actions">
+        <button type="submit" className="control">
+          {TournamentControl.start}
+        </button>
+        <button type="button" className="control" onClick={back}>
+          {TournamentControl.back}
+        </button>
+      </div>
+    </form>
+  );
+}
diff --git a/src/game/tournament/format.test.ts b/src/game/tournament/format.test.ts
new file mode 100644
index 0000000..32bb82e
--- /dev/null
+++ b/src/game/tournament/format.test.ts
@@ -0,0 +1,129 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import {
+  decodeTournament,
+  encodeTournament,
+  TOURNAMENT_FORMAT,
+  TOURNAMENT_MAX_BYTES,
+  TOURNAMENT_VERSION,
+} from './format.ts';
+import { startTournament } from './rules.ts';
+import type { Tournament } from './rules.ts';
+
+const PLAYERS = ['Ada', 'Bo', 'Cora', 'Dev'];
+// A four-player event halfway through: both semifinals are played and the final is waiting.
+const HALFWAY = {
+  format: 'neon-pairs/tournament',
+  matches: [
+    {
+      boardCode: 'np1-6-1',
+      results: [
+        { elapsedMs: 70200.5, moves: 20 },
+        { elapsedMs: 58100, moves: 21 },
+      ],
+    },
+    {
+      boardCode: 'np1-6-2',
+      results: [
+        { elapsedMs: 65200, moves: 19 },
+        { elapsedMs: 65900, moves: 19 },
+      ],
+    },
+    { boardCode: 'np1-8-1', results: [null, null] },
+  ],
+  players: PLAYERS,
+  reviewing: true,
+  version: 1,
+};
+
+function accepted(value: unknown): Tournament {
+  const read = decodeTournament(JSON.stringify(value));
+  assert.ok(read && 'tournament' in read, JSON.stringify(value));
+  return read.tournament;
+}
+
+interface Draft {
+  readonly format: unknown;
+  readonly matches: unknown[];
+  readonly players: unknown;
+  readonly reviewing: unknown;
+  readonly version: unknown;
+}
+
+function rejected(change: (value: Draft) => unknown, why: string): void {
+  const draft: Draft = structuredClone(HALFWAY);
+  assert.equal(decodeTournament(JSON.stringify(change(draft))), null, why);
+}
+
+test('export writes the format name, a whole version and alphabetical keys at every level', () => {
+  assert.equal(TOURNAMENT_FORMAT, 'neon-pairs/tournament');
+  assert.ok(Number.isInteger(TOURNAMENT_VERSION));
+  const text = encodeTournament(accepted(HALFWAY));
+  assert.equal(text, JSON.stringify(HALFWAY, null, 2));
+  const empty = JSON.parse(encodeTournament(startTournament([], [])));
+  assert.deepEqual(Object.keys(empty), ['format', 'matches', 'players', 'reviewing', 'version']);
+});
+
+test('a decoded tournament round trips with fractional active time intact', () => {
+  const tournament = accepted(HALFWAY);
+  assert.equal(tournament.matches[0]?.results[0]?.elapsedMs, 70200.5);
+  assert.deepEqual(accepted(JSON.parse(encodeTournament(tournament))), tournament);
+  assert.deepEqual(accepted({ ...HALFWAY, players: [], matches: [], reviewing: false }), {
+    players: [],
+    matches: [],
+    reviewing: false,
+  });
+});
+
+test('the first field outside the format is named, in document order', () => {
+  const named = (value: unknown) => decodeTournament(JSON.stringify(value));
+  assert.deepEqual(named({ ...HALFWAY, note: 1 }), { unknownField: 'note' });
+  const nested = structuredClone(HALFWAY);
+  Object.assign(nested.matches[1] ?? {}, { winner: 'Bo' });
+  assert.deepEqual(named({ ...nested, later: 1 }), { unknownField: 'winner' });
+  const result = structuredClone(HALFWAY);
+  Object.assign(result.matches[0]?.results[1] ?? {}, { seed: 4 });
+  assert.deepEqual(named(result), { unknownField: 'seed' });
+  assert.deepEqual(named({ ...HALFWAY, version: 2, extra: true }), { unknownField: 'extra' });
+});
+
+test('invalid tournaments are rejected without a field name', () => {
+  assert.equal(decodeTournament('{'), null);
+  assert.equal(decodeTournament('[]'), null);
+  assert.equal(decodeTournament(' '.repeat(TOURNAMENT_MAX_BYTES + 1)), null);
+  rejected((value) => ({ ...value, version: 2 }), 'unsupported version');
+  rejected((value) => ({ ...value, version: '1' }), 'version must be a number');
+  rejected((value) => ({ ...value, format: 'neon-pairs/snapshot' }), 'another format');
+  rejected(({ reviewing: _, ...value }) => value, 'missing field');
+  rejected((value) => ({ ...value, players: PLAYERS.slice(0, 3) }), 'three players');
+  rejected((value) => ({ ...value, players: ['Ada', 'Bo', 'Cora', 'ada'] }), 'repeated name');
+  rejected((value) => ({ ...value, players: ['Ada', 'Bo', 'Cora', ' Dev'] }), 'raw name');
+  rejected((value) => ({ ...value, players: ['Ada', 'Bo', 'Cora', 'D'] }), 'short name');
+  rejected((value) => {
+    value.matches[1] = { ...HALFWAY.matches[1], boardCode: 'np1-6-1' };
+    return value;
+  }, 'two matches share a deal');
+  rejected((value) => {
+    value.matches[2] = { boardCode: 'np1-6-3', results: [null, null] };
+    return value;
+  }, 'the final plays 8x8');
+  rejected((value) => {
+    value.matches[0] = { boardCode: 'np1-6-1', results: [null, { elapsedMs: 1, moves: 18 }] };
+    return value;
+  }, 'results fill in play order');
+  rejected((value) => {
+    value.matches[0] = { boardCode: 'np1-6-1', results: [{ elapsedMs: 1, moves: 17 }, null] };
+    return value;
+  }, 'fewer moves than pairs');
+  rejected((value) => {
+    value.matches[0] = { boardCode: 'np1-6-1', results: [{ elapsedMs: -1, moves: 18 }, null] };
+    return value;
+  }, 'negative time');
+  rejected(
+    (value) => ({
+      ...value,
+      matches: HALFWAY.matches.map((match) => ({ ...match, results: [null, null] })),
+    }),
+    'nothing to review before the first game',
+  );
+});
diff --git a/src/game/tournament/format.ts b/src/game/tournament/format.ts
new file mode 100644
index 0000000..897cc58
--- /dev/null
+++ b/src/game/tournament/format.ts
@@ -0,0 +1,142 @@
+import { parseBoardCode } from '../deck.ts';
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import {
+  hasExactKeys,
+  isJsonObject,
+  isNonnegativeSafeInteger,
+  isWithinBytes,
+  parseJson,
+} from '../saved-format.ts';
+import { isNameGroup } from './names.ts';
+import { isFinished, isPlayerCount, matchSizes, playedGames } from './rules.ts';
+import type { Match, Result, Tournament } from './rules.ts';
+
+export const TOURNAMENT_FORMAT = 'neon-pairs/tournament';
+export const TOURNAMENT_VERSION = 1;
+export const TOURNAMENT_MAX_BYTES = 65_536;
+
+// Keys at each level, in the alphabetical order that export writes.
+interface Shape {
+  readonly keys: readonly string[];
+  readonly lists?: Readonly<Record<string, Shape>>;
+}
+const RESULT: Shape = { keys: ['elapsedMs', 'moves'] };
+const MATCH: Shape = { keys: ['boardCode', 'results'], lists: { results: RESULT } };
+const ROOT: Shape = {
+  keys: ['format', 'matches', 'players', 'reviewing', 'version'],
+  lists: { matches: MATCH },
+};
+
+type TournamentImport =
+  { readonly tournament: Tournament } | { readonly unknownField: string } | null;
+
+export function matchesJson(tournament: Tournament) {
+  return tournament.matches.map((match) => ({
+    boardCode: match.boardCode,
+    results: match.results.map((result) => result && resultJson(result)),
+  }));
+}
+
+function resultJson(result: Result) {
+  return { elapsedMs: result.elapsedMs, moves: result.moves };
+}
+
+// Elapsed time keeps its fractions, so a tie on time is judged the same way after a load.
+export function encodeTournament(tournament: Tournament): string {
+  return JSON.stringify(
+    {
+      format: TOURNAMENT_FORMAT,
+      matches: matchesJson(tournament),
+      players: tournament.players,
+      reviewing: tournament.reviewing,
+      version: TOURNAMENT_VERSION,
+    },
+    null,
+    2,
+  );
+}
+
+export function decodeTournament(text: string): TournamentImport {
+  if (!isWithinBytes(text, TOURNAMENT_MAX_BYTES)) return null;
+  const value = parseJson(text);
+  if (!isJsonObject(value)) return null;
+  const unknownField = firstUnknownField(value, ROOT);
+  if (unknownField !== null) return { unknownField };
+  if (
+    !hasExactKeys(value, ROOT.keys) ||
+    value.format !== TOURNAMENT_FORMAT ||
+    value.version !== TOURNAMENT_VERSION ||
+    typeof value.reviewing !== 'boolean'
+  )
+    return null;
+  const tournament = readBracket(value.players, value.matches, value.reviewing);
+  return tournament && { tournament };
+}
+
+// The first field outside the format, in document order, looking inside matches and results.
+function firstUnknownField(value: unknown, shape: Shape): string | null {
+  if (!isJsonObject(value)) return null;
+  for (const [key, child] of Object.entries(value)) {
+    if (!shape.keys.includes(key)) return key;
+    const item = shape.lists?.[key];
+    if (!item || !Array.isArray(child)) continue;
+    for (const entry of child) {
+      const found = firstUnknownField(entry, item);
+      if (found !== null) return found;
+    }
+  }
+  return null;
+}
+
+function isString(value: unknown): value is string {
+  return typeof value === 'string';
+}
+
+// No players describes a tournament that hasn't started. Otherwise every match has its stage's
+// board size and a deal of its own, and results fill in play order.
+export function readBracket(
+  players: unknown,
+  matches: unknown,
+  reviewing: boolean,
+): Tournament | null {
+  if (!Array.isArray(players) || !players.every(isString) || !Array.isArray(matches)) return null;
+  if (players.length > 0 && (!isPlayerCount(players.length) || !isNameGroup(players))) return null;
+  const sizes = matchSizes(players.length);
+  if (matches.length !== sizes.length) return null;
+  const read: Match[] = [];
+  for (const [index, match] of matches.entries()) {
+    const accepted = readMatch(match, sizes[index] ?? 0);
+    if (!accepted) return null;
+    read.push(accepted);
+  }
+  if (new Set(read.map((match) => match.boardCode)).size !== read.length) return null;
+  const tournament: Tournament = { players, matches: read, reviewing };
+  const played = playedGames(tournament);
+  const results = read.flatMap((match) => match.results);
+  if (results.some((result, index) => (result !== null) !== index < played)) return null;
+  if (reviewing && (played === 0 || isFinished(tournament))) return null;
+  return tournament;
+}
+
+function readMatch(value: unknown, size: number): Match | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, MATCH.keys)) return null;
+  const { boardCode, results } = value;
+  if (typeof boardCode !== 'string' || parseBoardCode(boardCode)?.size !== size) return null;
+  if (!Array.isArray(results) || results.length !== 2) return null;
+  const first = readResult(results[0], size);
+  const second = readResult(results[1], size);
+  if (first === undefined || second === undefined) return null;
+  return { boardCode, results: [first, second] };
+}
+
+// Null is an unplayed game, and undefined rejects the value.
+function readResult(value: unknown, size: number): Result | null | undefined {
+  if (value === null) return null;
+  if (!isJsonObject(value) || !hasExactKeys(value, RESULT.keys)) return undefined;
+  const { moves, elapsedMs } = value;
+  if (!isNonnegativeSafeInteger(moves) || moves < size ** 2 / 2 || moves > MOVES_MAX)
+    return undefined;
+  if (typeof elapsedMs !== 'number' || !(elapsedMs >= 0 && elapsedMs <= ELAPSED_MAX_MS))
+    return undefined;
+  return { moves, elapsedMs };
+}

+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { matchBoardSize, matchRound, openingSeeds, Round, roundNames } from './bracket.ts';
+
+test('opening seeds pair the ends of the entry list in displayed bracket order', () => {
+  assert.deepEqual(
+    [0, 1, 2, 3].map((position) => openingSeeds(8, position)),
+    [
+      [1, 8],
+      [4, 5],
+      [3, 6],
+      [2, 7],
+    ],
+  );
+  assert.deepEqual(
+    [0, 1].map((position) => openingSeeds(4, position)),
+    [
+      [1, 4],
+      [2, 3],
+    ],
+  );
+  assert.equal(openingSeeds(6, 0), null);
+});
+
+test('rounds are named by stage and use their board sizes', () => {
+  assert.deepEqual(roundNames(8), [Round.quarterfinal, Round.semifinal, Round.final]);
+  assert.deepEqual(roundNames(4), [Round.semifinal, Round.final]);
+  assert.deepEqual(
+    [0, 1, 2, 3, 4, 5, 6].map((index) => [matchRound(8, index), matchBoardSize(8, index)]),
+    [
+      ['Quarterfinal', 4],
+      ['Quarterfinal', 4],
+      ['Quarterfinal', 4],
+      ['Quarterfinal', 4],
+      ['Semifinal', 6],
+      ['Semifinal', 6],
+      ['Final', 8],
+    ],
+  );
+  assert.deepEqual(
+    [0, 1, 2].map((index) => matchRound(4, index)),
+    ['Semifinal', 'Semifinal', 'Final'],
+  );
+});
diff --git a/src/game/tournament/bracket.ts b/src/game/tournament/bracket.ts
new file mode 100644
index 0000000..c0bae7d
--- /dev/null
+++ b/src/game/tournament/bracket.ts
@@ -0,0 +1,59 @@
+// The bracket's shape: entry-order seeds, round names and the board size of each round.
+export const PLAYER_COUNTS = [4, 8] as const;
+export const Round = {
+  quarterfinal: 'Quarterfinal',
+  semifinal: 'Semifinal',
+  final: 'Final',
+} as const;
+type RoundName = (typeof Round)[keyof typeof Round];
+const ROUND_BOARD_SIZES: Readonly<Record<RoundName, number>> = {
+  [Round.quarterfinal]: 4,
+  [Round.semifinal]: 6,
+  [Round.final]: 8,
+};
+// Seeds follow entry order. Each list is the opening bracket in its displayed order.
+const OPENING_SEEDS: Readonly<Record<number, readonly (readonly [number, number])[]>> = {
+  4: [
+    [1, 4],
+    [2, 3],
+  ],
+  8: [
+    [1, 8],
+    [4, 5],
+    [3, 6],
+    [2, 7],
+  ],
+};
+
+export function roundNames(count: number): readonly RoundName[] {
+  return count === 8
+    ? [Round.quarterfinal, Round.semifinal, Round.final]
+    : [Round.semifinal, Round.final];
+}
+
+// Finds a match's round, its position in that round and where the previous round starts.
+export function matchPlace(count: number, index: number) {
+  let start = 0;
+  let size = count / 2;
+  let round = 0;
+  while (index >= start + size && size > 1) {
+    start += size;
+    size /= 2;
+    round += 1;
+  }
+  return { round, position: index - start, previousStart: start - size * 2 };
+}
+
+export function matchRound(count: number, index: number): RoundName {
+  const name = roundNames(count)[matchPlace(count, index).round];
+  if (!name) throw new Error('Invalid match.');
+  return name;
+}
+
+export function matchBoardSize(count: number, index: number): number {
+  return ROUND_BOARD_SIZES[matchRound(count, index)];
+}
+
+export function openingSeeds(count: number, position: number): readonly number[] | null {
+  return OPENING_SEEDS[count]?.[position] ?? null;
+}
diff --git a/src/game/tournament/exchange.test.ts b/src/game/tournament/exchange.test.ts
new file mode 100644
index 0000000..d4568e9
--- /dev/null
+++ b/src/game/tournament/exchange.test.ts
@@ -0,0 +1,81 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { boardCode } from '../deck.ts';
+import {
+  decodeTournament,
+  encodeTournament,
+  TOURNAMENT_FORMAT,
+  TOURNAMENT_MAX_BYTES,
+  TOURNAMENT_VERSION,
+  TournamentNotice,
+} from './exchange.ts';
+import { createTournament, recordResult } from './rules.ts';
+
+let seed = 0;
+const started = recordResult(
+  createTournament(['Ada', 'Bo', 'Cora', 'Dev'], (size) => boardCode(size, (seed += 1))),
+  { elapsedMs: 70200.375, moves: 21 },
+);
+const [FIRST, SECOND, FINAL] = [
+  { boardCode: 'np1-6-1', results: [{ elapsedMs: 70200.375, moves: 21 }, null] },
+  { boardCode: 'np1-6-2', results: [null, null] },
+  { boardCode: 'np1-8-3', results: [null, null] },
+];
+const BASE = {
+  format: TOURNAMENT_FORMAT,
+  matches: [FIRST, SECOND, FINAL],
+  players: ['Ada', 'Bo', 'Cora', 'Dev'],
+  version: TOURNAMENT_VERSION,
+};
+
+function keyOrders(value: unknown): string[][] {
+  if (Array.isArray(value)) return value.flatMap(keyOrders);
+  if (typeof value !== 'object' || value === null) return [];
+  return [Object.keys(value), ...Object.values(value).flatMap(keyOrders)];
+}
+
+function decoded(value: unknown) {
+  return decodeTournament(JSON.stringify(value));
+}
+
+test('export names its format and version and sorts keys at every level', () => {
+  const exported: unknown = JSON.parse(encodeTournament(started));
+  assert.deepEqual(exported, BASE);
+  for (const keys of keyOrders(exported)) assert.deepEqual(keys, [...keys].sort());
+});
+
+test('a loaded export compares with the same exact results', () => {
+  assert.deepEqual(decodeTournament(encodeTournament(started)), { tournament: started });
+});
+
+test('the first field a format does not define is named, wherever it is', () => {
+  assert.deepEqual(decoded({ ...BASE, extra: 1 }), { problem: 'Unknown field: extra.' });
+  const noted = { ...SECOND, results: [{ elapsedMs: 1, moves: 18, note: 'x' }, null] };
+  assert.deepEqual(decoded({ ...BASE, matches: [{ ...FIRST, seat: 1 }, noted, FINAL], zzz: 1 }), {
+    problem: 'Unknown field: seat.',
+  });
+  assert.deepEqual(decoded({ ...BASE, matches: [FIRST, noted, FINAL], zzz: 1 }), {
+    problem: 'Unknown field: note.',
+  });
+  assert.deepEqual(decoded({ ...BASE, version: 2, zzz: 1 }), { problem: 'Unknown field: zzz.' });
+});
+
+test('malformed, incomplete or inconsistent tournaments are invalid', () => {
+  const unplayed = { ...FIRST, results: [{ moves: 21 }, null] };
+  const cases = [
+    '{',
+    'null',
+    '[]',
+    JSON.stringify({ ...BASE, version: 2 }),
+    JSON.stringify({ ...BASE, version: '1' }),
+    JSON.stringify({ ...BASE, format: 'neon-pairs/snapshot' }),
+    JSON.stringify({ format: TOURNAMENT_FORMAT, matches: BASE.matches, version: 1 }),
+    JSON.stringify({ ...BASE, players: ['Ada', 'Bo', 'Cora'] }),
+    JSON.stringify({ ...BASE, matches: [FIRST, FIRST, FINAL] }),
+    JSON.stringify({ ...BASE, matches: [{ ...FIRST, results: [null] }, SECOND, FINAL] }),
+    JSON.stringify({ ...BASE, matches: [unplayed, SECOND, FINAL] }),
+    `${JSON.stringify(BASE)}${' '.repeat(TOURNAMENT_MAX_BYTES)}`,
+  ];
+  for (const text of cases)
+    assert.deepEqual(decodeTournament(text), { problem: TournamentNotice.invalid }, text);
+});
diff --git a/src/game/tournament/exchange.ts b/src/game/tournament/exchange.ts
new file mode 100644
index 0000000..d6ba24e
--- /dev/null
+++ b/src/game/tournament/exchange.ts
@@ -0,0 +1,107 @@
+import {
+  hasExactKeys,
+  isJsonObject,
+  isNonnegativeSafeInteger,
+  isWithinBytes,
+  parseJson,
+} from '../saved-format.ts';
+import { isValidTournament } from './rules.ts';
+import type { Tournament, TournamentMatch, TournamentResult } from './rules.ts';
+
+export const TOURNAMENT_FORMAT = 'neon-pairs/tournament';
+export const TOURNAMENT_VERSION = 1;
+export const TOURNAMENT_MAX_BYTES = 65_536;
+export const TournamentNotice = { invalid: 'Invalid tournament.' } as const;
+
+// Each object lists its fields. A nested shape also applies to every element of a list.
+interface Shape {
+  readonly [field: string]: Shape | null;
+}
+const RESULT_SHAPE: Shape = { elapsedMs: null, moves: null };
+const MATCH_SHAPE: Shape = { boardCode: null, results: RESULT_SHAPE };
+const RECORD_SHAPE: Shape = { matches: MATCH_SHAPE, players: null };
+const EXPORT_SHAPE: Shape = { format: null, ...RECORD_SHAPE, version: null };
+
+type TournamentImport = { tournament: Tournament } | { problem: string };
+
+// The data both exports and saved records hold, with keys in alphabetical order.
+export function tournamentRecord({ matches, players }: Tournament) {
+  return {
+    matches: matches.map(({ boardCode, results }) => ({
+      boardCode,
+      results: results.map((result) =>
+        result ? { elapsedMs: result.elapsedMs, moves: result.moves } : null,
+      ),
+    })),
+    players,
+  };
+}
+
+// Results keep the game's exact active milliseconds, so a loaded tournament compares the same way.
+export function encodeTournament(tournament: Tournament): string {
+  const { matches, players } = tournamentRecord(tournament);
+  const value = { format: TOURNAMENT_FORMAT, matches, players, version: TOURNAMENT_VERSION };
+  return JSON.stringify(value, null, 2);
+}
+
+// Finds the first field, in reading order, that the shape doesn't define.
+function unknownField(value: unknown, shape: Shape): string | null {
+  const items = Array.isArray(value) ? value : [value];
+  for (const item of items) {
+    if (!isJsonObject(item)) continue;
+    for (const [field, child] of Object.entries(item)) {
+      if (!Object.hasOwn(shape, field)) return field;
+      const inner = shape[field];
+      const found = inner ? unknownField(child, inner) : null;
+      if (found !== null) return found;
+    }
+  }
+  return null;
+}
+
+function readResult(value: unknown): TournamentResult | null | undefined {
+  if (value === null) return null;
+  if (!isJsonObject(value) || !hasExactKeys(value, Object.keys(RESULT_SHAPE))) return undefined;
+  const { elapsedMs, moves } = value;
+  if (typeof elapsedMs !== 'number' || !isNonnegativeSafeInteger(moves)) return undefined;
+  return { elapsedMs, moves };
+}
+
+function readMatch(value: unknown): TournamentMatch | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, Object.keys(MATCH_SHAPE))) return null;
+  const { boardCode, results } = value;
+  if (typeof boardCode !== 'string' || !Array.isArray(results)) return null;
+  const read = results.map(readResult);
+  const valid = read.filter((result) => result !== undefined);
+  return valid.length === read.length ? { boardCode, results: valid } : null;
+}
+
+function isStringList(value: unknown): value is string[] {
+  return Array.isArray(value) && value.every((item) => typeof item === 'string');
+}
+
+// Reads the record data shared by exports and saved records. Unusable data gives null.
+export function readTournament(value: unknown): Tournament | null {
+  if (!isJsonObject(value) || !hasExactKeys(value, Object.keys(RECORD_SHAPE))) return null;
+  const { matches, players } = value;
+  if (!isStringList(players) || !Array.isArray(matches)) return null;
+  const read = matches.map(readMatch);
+  const valid = read.filter((match) => match !== null);
+  if (valid.length !== read.length) return null;
+  const tournament = { players, matches: valid };
+  return isValidTournament(tournament) ? tournament : null;
+}
+
+export function decodeTournament(text: string): TournamentImport {
+  const invalid = { problem: TournamentNotice.invalid };
+  if (!isWithinBytes(text, TOURNAMENT_MAX_BYTES)) return invalid;
+  const value = parseJson(text);
+  if (!isJsonObject(value)) return invalid;
+  const field = unknownField(value, EXPORT_SHAPE);
+  if (field !== null) return { problem: `Unknown field: ${field}.` };
+  const { format, version, matches, players } = value;
+  if (format !== TOURNAMENT_FORMAT || version !== TOURNAMENT_VERSION) return invalid;
+  if (!hasExactKeys(value, Object.keys(EXPORT_SHAPE))) return invalid;
+  const tournament = readTournament({ matches, players });
+  return tournament ? { tournament } : invalid;
+}

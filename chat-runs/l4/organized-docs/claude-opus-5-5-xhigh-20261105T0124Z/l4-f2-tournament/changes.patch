+  async ({ page, gameURL }) => {
+    await page.goto(gameURL);
+    await page.evaluate(
+      ([key, value]) => localStorage.setItem(key ?? '', value ?? ''),
+      [PREFERENCES_KEY, SAVED],
+    );
+    await openTournament(page, gameURL);
+    await startTournament(page, ['  Ada  ', 'Bo', 'Cora', 'Dev']);
+    const status = page.getByRole('status');

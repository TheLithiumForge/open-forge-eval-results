+    expect(saved).toMatchObject({ v: 3, items: [{ players: ['Ada', 'Bo', 'Cora', 'Dev'] }] });
+    expect(await page.evaluate((key) => localStorage.getItem(key), PREFERENCES_KEY)).toBe(SAVED);

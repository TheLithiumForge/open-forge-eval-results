--- /dev/null
+++ b/src/game/tournament/records.ts
@@ -0,0 +1,59 @@
+import { hasExactKeys, isJsonObject, parseJson } from '../saved-format.ts';
+import { readTournament, tournamentRecord } from './exchange.ts';
+import { isFinished } from './rules.ts';
+import type { PreferenceStore } from '../session/storage.ts';
+import type { Tournament } from './rules.ts';
+
+export const TOURNAMENTS_KEY = 'np3:tournaments';
+const ENVELOPE_VERSION = 3;
+const ENVELOPE_KEYS = ['v', 'items'];
+const KEPT_RECORDS = 10;
+
+export interface PastTournaments {
+  // Newest first.
+  readonly records: readonly Tournament[];
+  // False when this device can't keep them. The list then lasts only for this page.
+  readonly saving: boolean;
+}
+
+function isFinishedRecord(record: Tournament | null): record is Tournament {
+  return record !== null && isFinished(record);
+}
+
+// A value that fails to parse or validate reads as no records, and the read leaves it in place.
+function decodeRecords(text: string | null): readonly Tournament[] {
+  if (!text) return [];
+  const value = parseJson(text);
+  if (!isJsonObject(value) || !hasExactKeys(value, ENVELOPE_KEYS) || value.v !== ENVELOPE_VERSION)
+    return [];
+  if (!Array.isArray(value.items)) return [];
+  const records = value.items.map(readTournament);
+  const finished = records.filter(isFinishedRecord);
+  return finished.length === records.length ? finished : [];
+}
+
+export function readPastTournaments(store: PreferenceStore | null): PastTournaments {
+  if (!store) return { records: [], saving: false };
+  try {
+    return { records: decodeRecords(store.getItem(TOURNAMENTS_KEY)), saving: true };
+  } catch {
+    return { records: [], saving: false };
+  }
+}
+
+// Keeps the newest records. After a blocked read the stored value stays untouched.
+export function savePastTournament(
+  store: PreferenceStore | null,
+  past: PastTournaments,
+  record: Tournament,
+): PastTournaments {
+  const records = [record, ...past.records].slice(0, KEPT_RECORDS);
+  if (!store || !past.saving) return { records, saving: false };
+  try {
+    const items = records.map(tournamentRecord);
+    store.setItem(TOURNAMENTS_KEY, JSON.stringify({ v: ENVELOPE_VERSION, items }));
+    return { records, saving: true };
+  } catch {
+    return { records, saving: false };
+  }
+}
diff --git a/src/game/tournament/rules.test.ts b/src/game/tournament/rules.test.ts
new file mode 100644
index 0000000..5c5363c
--- /dev/null
+++ b/src/game/tournament/rules.test.ts
@@ -0,0 +1,126 @@
+import assert from 'node:assert/strict';
+import { test } from 'vitest';
+import { boardCode } from '../deck.ts';
+import {
+  champion,
+  createTournament,
+  currentTurn,
+  isAhead,
+  isFinished,
+  isValidTournament,
+  matchSeeds,
+  matchWinner,
+  playerName,
+  recordResult,
+} from './rules.ts';
+import type { Tournament } from './rules.ts';
+
+const EIGHT = ['Ada', 'Bo', 'Cora', 'Dev', 'Emi', 'Finn', 'Gia', 'Hal'];
+const FOUR = EIGHT.slice(0, 4);
+
+function counting(): (size: number) => string {
+  let seed = 0;
+  return (size) => boardCode(size, (seed += 1));
+}
+
+function opening(tournament: Tournament): string[][] {
+  return tournament.matches
+    .map((_, index) => matchSeeds(tournament, index))
+    .filter((seeds) => seeds !== null)
+    .map((seeds) => seeds.map((seed) => playerName(tournament, seed)));
+}
+
+function play(tournament: Tournament, moves: readonly number[]): Tournament {
+  return moves.reduce(
+    (next, count) => recordResult(next, { moves: count, elapsedMs: 1000 }),
+    tournament,
+  );
+}
+
+test('opening matches follow entry-order seeds for eight and four players', () => {
+  assert.deepEqual(opening(createTournament(EIGHT, counting())), [
+    ['Ada', 'Hal'],
+    ['Dev', 'Emi'],
+    ['Cora', 'Finn'],
+    ['Bo', 'Gia'],
+  ]);
+  assert.deepEqual(opening(createTournament(FOUR, counting())), [
+    ['Ada', 'Dev'],
+    ['Bo', 'Cora'],
+  ]);
+});
+
+test('fewer moves win, then lower active time, then the higher seed', () => {
+  assert.equal(
+    isAhead({ moves: 12, elapsedMs: 70200 }, { moves: 13, elapsedMs: 58100 }, 2, 1),
+    true,
+  );
+  assert.equal(
+    isAhead({ moves: 15, elapsedMs: 65200 }, { moves: 15, elapsedMs: 65900 }, 4, 3),
+    true,
+  );
+  assert.equal(
+    isAhead({ moves: 15, elapsedMs: 65900.5 }, { moves: 15, elapsedMs: 65900.25 }, 1, 2),
+    false,
+  );
+  const equal = { moves: 8, elapsedMs: 5000 };
+  assert.equal(isAhead(equal, equal, 1, 4), true);
+  assert.equal(isAhead(equal, equal, 4, 1), false);
+});
+
+test('players take turns match by match and winners meet in bracket order', () => {
+  const start = createTournament(FOUR, counting());
+  assert.deepEqual(currentTurn(start), { match: 0, seat: 0 });
+  const firstGame = play(start, [20]);
+  assert.deepEqual(currentTurn(firstGame), { match: 0, seat: 1 });
+  assert.equal(matchSeeds(firstGame, 2), null);
+  // Dev beats Ada on moves, and Bo beats Cora on the higher seed after equal results.
+  const semifinals = play(start, [20, 18, 18, 18]);
+  assert.equal(matchWinner(semifinals, 0), 4);
+  assert.equal(matchWinner(semifinals, 1), 2);
+  assert.deepEqual(matchSeeds(semifinals, 2), [4, 2]);
+  assert.deepEqual(currentTurn(semifinals), { match: 2, seat: 0 });
+  assert.equal(champion(semifinals), null);
+  const finished = play(semifinals, [40, 32]);
+  assert.equal(isFinished(finished), true);
+  assert.equal(currentTurn(finished), null);
+  assert.equal(champion(finished), 'Bo');
+  assert.equal(recordResult(finished, { moves: 32, elapsedMs: 1 }), finished);
+});
+
+test('every match draws a different full board code at its round size', () => {
+  const seeds = [4, 4, 5, 5, 6, 6, 7, 7, 7, 8, 8];
+  let draw = 0;
+  const tournament = createTournament(EIGHT, (size) => boardCode(size, seeds[draw++] ?? 99));
+  // A repeated seed draws again within a size. np1-6-7 differs from np1-4-7 by its size.
+  assert.deepEqual(
+    tournament.matches.map((match) => match.boardCode),
+    ['np1-4-4', 'np1-4-5', 'np1-4-6', 'np1-4-7', 'np1-6-7', 'np1-6-8', 'np1-8-8'],
+  );
+  assert.equal(isValidTournament(tournament), true);
+});
+
+test('validation rejects impossible brackets, deals and results', () => {
+  const valid = play(createTournament(FOUR, counting()), [20, 18]);
+  assert.equal(isValidTournament(valid), true);
+  const [first, second, final] = valid.matches;
+  if (!first || !second || !final) throw new Error('Expected three matches.');
+  const cases: Tournament[] = [
+    { ...valid, players: [...FOUR, 'Emi'] },
+    { ...valid, players: ['Ada', 'ada', 'Cora', 'Dev'] },
+    { ...valid, players: [' Ada', 'Bo', 'Cora', 'Dev'] },
+    { ...valid, matches: [first, { ...second, boardCode: first.boardCode }, final] },
+    { ...valid, matches: [first, { ...second, boardCode: 'np1-4-77' }, final] },
+    { ...valid, matches: [{ ...first, results: [null, first.results[1] ?? null] }, second, final] },
+    {
+      ...valid,
+      matches: [{ ...first, results: [{ moves: 17, elapsedMs: 1 }, null] }, second, final],
+    },
+    {
+      ...valid,
+      matches: [{ ...first, results: [{ moves: 18, elapsedMs: -1 }, null] }, second, final],
+    },
+    { ...valid, matches: [first, second] },
+  ];
+  for (const tournament of cases) assert.equal(isValidTournament(tournament), false);
+});
diff --git a/src/game/tournament/rules.ts b/src/game/tournament/rules.ts
new file mode 100644
index 0000000..05232af
--- /dev/null
+++ b/src/game/tournament/rules.ts
@@ -0,0 +1,136 @@
+import { parseBoardCode } from '../deck.ts';
+import { ELAPSED_MAX_MS, MOVES_MAX } from '../game.ts';
+import { matchBoardSize, matchPlace, openingSeeds, PLAYER_COUNTS } from './bracket.ts';
+import { acceptedName, nameProblem } from './names.ts';
+
+export interface TournamentResult {
+  readonly elapsedMs: number;
+  readonly moves: number;
+}
+export interface TournamentMatch {
+  readonly boardCode: string;
+  // One entry per seat in seat order. Null means that seat hasn't finished its game.
+  readonly results: readonly (TournamentResult | null)[];
+}
+export interface Tournament {
+  readonly players: readonly string[];
+  // Matches run round by round, in bracket order within a round.
+  readonly matches: readonly TournamentMatch[];
+}
+interface Turn {
+  readonly match: number;
+  readonly seat: number;
+}
+
+// Lower moves win, then lower active time, then the higher seed. Seed 1 is the highest seed.
+export function isAhead(
+  result: TournamentResult,
+  other: TournamentResult,
+  seed: number,
+  otherSeed: number,
+): boolean {
+  if (result.moves !== other.moves) return result.moves < other.moves;
+  if (result.elapsedMs !== other.elapsedMs) return result.elapsedMs < other.elapsedMs;
+  return seed < otherSeed;
+}
+
+// The two seeds in seat order, or null while an earlier match is undecided.
+export function matchSeeds(tournament: Tournament, index: number): readonly number[] | null {
+  const count = tournament.players.length;
+  const { round, position, previousStart } = matchPlace(count, index);
+  if (round === 0) return openingSeeds(count, position);
+  const first = matchWinner(tournament, previousStart + position * 2);
+  const second = matchWinner(tournament, previousStart + position * 2 + 1);
+  return first === null || second === null ? null : [first, second];
+}
+
+export function matchWinner(tournament: Tournament, index: number): number | null {
+  const seeds = matchSeeds(tournament, index);
+  const [result, other] = tournament.matches[index]?.results ?? [];
+  const [seed, otherSeed] = seeds ?? [];
+  if (!result || !other || seed === undefined || otherSeed === undefined) return null;
+  return isAhead(result, other, seed, otherSeed) ? seed : otherSeed;
+}
+
+export function playerName(tournament: Tournament, seed: number): string {
+  return tournament.players[seed - 1] ?? '';
+}
+
+// Games run match by match, with the first seat playing before the second.
+export function currentTurn(tournament: Tournament): Turn | null {
+  for (const [match, { results }] of tournament.matches.entries()) {
+    const seat = results.indexOf(null);
+    if (seat >= 0) return { match, seat };
+  }
+  return null;
+}
+
+export function isFinished(tournament: Tournament): boolean {
+  return currentTurn(tournament) === null;
+}
+
+export function recordResult(tournament: Tournament, result: TournamentResult): Tournament {
+  const turn = currentTurn(tournament);
+  if (!turn) return tournament;
+  const matches = tournament.matches.map((match, index) =>
+    index === turn.match
+      ? { ...match, results: match.results.map((old, seat) => (seat === turn.seat ? result : old)) }
+      : match,
+  );
+  return { ...tournament, matches };
+}
+
+export function champion(tournament: Tournament): string | null {
+  const winner = matchWinner(tournament, tournament.matches.length - 1);
+  return winner === null ? null : playerName(tournament, winner);
+}
+
+// Draws a deal for every match. Every match gets a different full board code.
+export function createTournament(
+  players: readonly string[],
+  draw: (size: number) => string,
+): Tournament {
+  const used = new Set<string>();
+  const matches = Array.from({ length: players.length - 1 }, (_, index) => {
+    const size = matchBoardSize(players.length, index);
+    let boardCode = draw(size);
+    while (used.has(boardCode)) boardCode = draw(size);
+    used.add(boardCode);
+    return { boardCode, results: [null, null] };
+  });
+  return { players, matches };
+}
+
+function isValidResult(result: TournamentResult | null, size: number): boolean {
+  return (
+    result === null ||
+    (Number.isSafeInteger(result.moves) &&
+      result.moves >= size ** 2 / 2 &&
+      result.moves <= MOVES_MAX &&
+      Number.isFinite(result.elapsedMs) &&
+      result.elapsedMs >= 0 &&
+      result.elapsedMs <= ELAPSED_MAX_MS)
+  );
+}
+
+// Checks names, bracket size, deals by round and that finished games come before unplayed ones.
+export function isValidTournament(tournament: Tournament): boolean {
+  const { players, matches } = tournament;
+  const count = players.length;
+  if (!PLAYER_COUNTS.some((allowed) => allowed === count) || matches.length !== count - 1)
+    return false;
+  if (players.some((name) => acceptedName(name) !== name) || nameProblem(players)) return false;
+  const codes = new Set(matches.map((match) => match.boardCode));
+  if (codes.size !== matches.length) return false;
+  const results = matches.flatMap((match) => match.results);
+  const firstOpen = results.indexOf(null);
+  if (firstOpen >= 0 && results.slice(firstOpen).some((result) => result !== null)) return false;
+  return matches.every((match, index) => {
+    const size = matchBoardSize(count, index);
+    return (
+      parseBoardCode(match.boardCode)?.size === size &&
+      match.results.length === 2 &&
+      match.results.every((result) => isValidResult(result, size))
+    );
+  });
+}
